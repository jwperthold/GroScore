#!/bin/bash
#

nt=${GROSCORE_NT:-${SLURM_CPUS_PER_TASK:-${SLURM_NTASKS:-4}}}

# Local multi-GPU mode (groscore_fe.py --run-local): utils/local_runner.py runs
# many cycles side by side on one workstation and pins each of them to a single
# GPU. Under SLURM the variable is unset, mdrun keeps its default device choice
# and the scheduler's GPU allocation applies. -pin off because several jobs share
# the node here, so mdrun must not claim a fixed set of cores for itself.
GPUOPT=""
if [[ -n "${GROSCORE_GPU_ID:-}" ]]; then
  GPUOPT="-gpu_id $GROSCORE_GPU_ID -pin off"
fi

# Execution mode (groscore_fe.py submits setup and cycles as separate SLURM jobs so
# the embarrassingly-parallel cycles can run as an array):
#   --setup      run the shared setup only (stage 0 + initial equilibration +
#                make_boresch, which defines the elastic network / restraints),
#                then write setup.done and exit.
#   --cycle N    wait for setup.done, then run ONLY cycle N. Safe to run many of
#                these concurrently: every cycle starts fresh from emin_solv.gro
#                with new velocities and writes only cycle-suffixed files.
#   (no args)    legacy: setup followed by all cycles sequentially in one job.
MODE="all"
CYCLE_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --setup) MODE="setup"; shift ;;
    --cycle)
      # Validate before shifting: `shift 2` with only one argument left fails
      # without consuming it, which would spin this loop forever.
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "--cycle requires a cycle number"; exit 1
      fi
      MODE="cycle"; CYCLE_ARG="$2"; shift 2 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done
if [[ "$MODE" == "cycle" && ! "$CYCLE_ARG" =~ ^[0-9]+$ ]]; then
  echo "--cycle requires a positive integer (got '$CYCLE_ARG')"; exit 1
fi

# Safety check: Exit if any files were modified within the last 70 minutes
# This prevents running simulations while setup is still in progress
# 60 minutes matches the timeout duration for individual simulation steps.
# The npt_init equilibration is the one exception at 600m, so this window no
# longer covers a setup that is still in its equilibration.
# Only meaningful in legacy single-job mode: with the setup/cycle split, sibling
# array tasks are writing files by design, so this check would abort all of them.
if [[ "$MODE" == "all" ]]; then
  NUMBER_FILES=$(ls -1 2>/dev/null | wc -l)
  RECENT_FILES=$(find . -maxdepth 1 -type f -mmin -70 2>/dev/null | wc -l)
  if [[ $NUMBER_FILES -lt 4 ]]; then
    echo "Safety check: Starting simulation from scratch."
  elif [[ $RECENT_FILES -gt 2 ]]; then
    echo "Safety check: Files in this directory were modified within the last 70 minutes."
    echo "Exiting to avoid conflicts with ongoing setup. Wait 70 minutes and resubmit."
    exit 0
  fi
fi

export GMX_MAXBACKUP=-1

# COM-COM separation added during unbinding, in nm. Used twice: it sets the box
# padding floor (the envelope grows by up to this much once protein B is pulled
# away) and it is passed to make_boresch.py. It is tied to the pull rate by
# rate * unbinding_time = PULL_DIST, so changing it means changing the rate and
# the leg length together. PULL_RATE is deliberately NOT set here: the cycle
# phase reads it back from boresch_analytical.gs so re-integrated cycles use the
# rate they were actually run at.
PULL_DIST=1.0

# Restart recovery: detect and clean up stale intermediate files from failed runs.
# If conf.gro exists but emin_solv.gro doesn't, a previous setup attempt failed
# partway through. Clean up ALL setup files and start from scratch to avoid
# stale topology/coordinate mismatches.
if [[ "$MODE" != "cycle" && -f conf.gro && ! -f emin_solv.gro ]]; then
  echo "Restart recovery: setup incomplete (conf.gro exists but emin_solv.gro missing)"
  echo "Cleaning all setup files for fresh re-run..."
  rm -f renumbered.pdb chain_map.gs ion_residues.gs ligand_info.gs ligand_residues.gs
  rm -f ncaa_residues.gs ncaa_failed.gs residuetypes.dat
  rm -f fixed.pdb fixed_capped.pdb cutout.pdb cutout_capped.pdb
  rm -f conf.gro conf_cutout.gro conf_vacbox.gro topol.top topol_*.itp posre*.itp
  rm -f emin_vac.tpr emin_vac.gro emin_vac.edr emin_vac.log emin_vac.trr
  rm -f box.gro box_solv.gro ions.tpr solv_ions.gro
  rm -f emin_solv_sd.tpr emin_solv_sd.gro emin_solv_sd.edr emin_solv_sd.log emin_solv_sd.trr
  rm -f emin_solv.tpr emin_solv.edr emin_solv.log emin_solv.trr
  rm -f index.ndx numpertres.gs numpertres.tmp bind.mdp nptrev.mdp bindrev.mdp
  rm -f boresch_failed.gs boresch_analytical.gs boresch_anchors.gs
  # Probe pass: the small-box system the production box size is measured from.
  # boxpad.gs goes with it, since a padding measured against a discarded solute
  # must not be reused after the topology is re-derived.
  rm -f topol_probe.top box_probe.gro box_solv_probe.gro ions_probe.tpr
  rm -f solv_ions_probe.gro emin_probe*.* index_probe.ndx nvt_?_probe.*
  rm -f npt_probe.* boxpad.gs boxpad.tmp boxpad_used.gs
  rm -f ligand_*.itp ligand_*.gro ligand_*.sdf ligand_manifest.gs
  rm -rf amber19sb.ff
fi

# Get structure ID from current directory name
STRUCT_ID=$(basename $(pwd))
MAXRUNS=0
CUTOUT=1
FORCEFIELD="charmm36"
LIGAND_PARAM=1
while read -r a b c d e
do
  PROTBCHAINS=$a
  MAXRUNS=$b
  if [[ -n "$c" ]]; then
    CUTOUT=$c
  fi
  if [[ -n "$d" ]]; then
    FORCEFIELD=$d
  fi
  if [[ -n "$e" ]]; then
    LIGAND_PARAM=$e
  fi
done < run.gs

# A completed setup is never redone: make_boresch rewrites index.ndx and the leg
# .mdp files, which would be pulled out from under any cycle task already running
# (e.g. if the user re-submits with --restart while jobs are live).
if [[ "$MODE" == "setup" && -f setup.done ]]; then
  # Still refresh the top-level analytical record: it is cheap, idempotent, and
  # may be missing even though the setup is complete (e.g. the results files were
  # cleared for a fresh scoring run). Without it every structure scores PENDING.
  if [[ -f boresch_analytical.gs ]]; then
    DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
    mkdir -p ../results_analytical.d
    echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
  fi
  echo "Setup already complete for $STRUCT_ID; nothing to do."
  exit 0
fi

# In array mode, wait for the one-off setup job to finish instead of terminating:
# nothing below (pdb2gmx, the leg .mdp files, index.ndx, numpertres.gs) exists
# until the setup has defined the restraints. This must happen BEFORE any setup
# step so a task released early never races the setup job. Exit cleanly -- not by
# error -- if the setup reported a failure for this structure.
if [[ "$MODE" == "cycle" ]]; then
  WAIT_MAX=${GROSCORE_SETUP_WAIT:-21600}   # seconds; default 6 h
  WAIT_INT=${GROSCORE_SETUP_POLL:-30}
  waited=0
  while [[ ! -f setup.done ]]; do
    # Only a non-OK status is a definitive failure: "OK" is written part-way
    # through the setup, before the restraints exist.
    SETUP_STATUS=$(awk -v s="$STRUCT_ID" '$1==s && $2!="OK"{print $2}' ../results_0.gs 2>/dev/null | tail -1)
    if [[ -n "$SETUP_STATUS" ]]; then
      echo "Setup for $STRUCT_ID failed ($SETUP_STATUS); cycle $CYCLE_ARG has nothing to run."
      exit 0
    fi
    if [[ $waited -ge $WAIT_MAX ]]; then
      echo "Timed out after ${waited}s waiting for setup of $STRUCT_ID (cycle $CYCLE_ARG)."
      exit 1
    fi
    [[ $waited -eq 0 ]] && echo "Cycle $CYCLE_ARG waiting for shared setup of $STRUCT_ID ..."
    sleep $WAIT_INT
    waited=$((waited+WAIT_INT))
  done
  [[ $waited -gt 0 ]] && echo "Setup ready after ${waited}s; starting cycle $CYCLE_ARG."
fi

# Set force field specific parameters
# Get absolute path to GroScore root (two levels up from structure directory)
GROSCORE_ROOT="$(cd ../.. && pwd)"
MDP_DIR="${GROSCORE_ROOT}/settings/$FORCEFIELD"
if [[ "$FORCEFIELD" == "charmm36" ]]; then
  # Add local forcefield directory to GMXLIB so GROMACS can find charmm36-jul2022.ff
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="${GROSCORE_ROOT}/forcefield:${GMXLIB}"
  else
    export GMXLIB="${GROSCORE_ROOT}/forcefield"
  fi
  FF_FLAG="-ff charmm36-jul2022"
  WATER_MODEL="tip3p"
  WATER_BOX="spc216.gro"
elif [[ "$FORCEFIELD" == "amber19sb_opc" ]]; then
  # AMBER ff19SB with OPC water (4-point)
  FF_FLAG="-ff amber19sb"
  WATER_MODEL="opc"
  WATER_BOX="tip4p.gro"
elif [[ "$FORCEFIELD" == "amber19sb_opc3" ]]; then
  # AMBER ff19SB with OPC3 water (3-point) included in standard GROMACS installation
  FF_FLAG="-ff amber19sb"
  WATER_MODEL="opc3"
  WATER_BOX="spc216.gro"
elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
  # GROMOS 54A8 with SPC water - custom force field in forcefield/ directory
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="${GROSCORE_ROOT}/forcefield:${GMXLIB}"
  else
    export GMXLIB="${GROSCORE_ROOT}/forcefield"
  fi
  FF_FLAG="-ff gromos54a8"
  WATER_MODEL="spc"
  WATER_BOX="spc216.gro"
fi

# Renumber PDB to have unique sequential residue numbers across chains
# Always re-run if conf.gro doesn't exist (restart safety: cap_termini overwrites
# chain_map.gs with post-cap numbers that become stale if setup is re-run)
if [[ ! -f conf.gro ]]; then
  python3 ../../utils/renumber_pdb.py -f input.pdb -o renumbered.pdb -c $PROTBCHAINS
fi
if [[ ! -f conf.gro ]]; then
  # Detect NCAA residues: AMBER19SB uses OpenFF parametrization; GROMOS uses FF's native PTM entries
  NCAA_FLAG=""
  if [[ $LIGAND_PARAM -eq 1 && ("$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3") ]]; then
    # Check if renumber_pdb.py detected modified amino acids
    NCAA_LIST=$(grep "Detected modified amino acids" renumbered.pdb.log 2>/dev/null | sed 's/.*: //' || true)
    if [[ -z "$NCAA_LIST" ]]; then
      # Fallback: check for HETATM with backbone CA in renumbered.pdb
      NCAA_LIST=$(awk '/^ATOM/ {res=substr($0,18,3); gsub(/ /,"",res); name=substr($0,13,4); gsub(/ /,"",name); if(name=="CA") seen[res]=1} END{for(r in seen) if(r!="ALA"&&r!="ARG"&&r!="ASN"&&r!="ASP"&&r!="CYS"&&r!="CYX"&&r!="GLN"&&r!="GLU"&&r!="GLY"&&r!="HID"&&r!="HIE"&&r!="HIP"&&r!="HIS"&&r!="ILE"&&r!="LEU"&&r!="LYS"&&r!="MET"&&r!="PHE"&&r!="PRO"&&r!="SER"&&r!="THR"&&r!="TRP"&&r!="TYR"&&r!="VAL"&&r!="ACE"&&r!="NME"&&r!="NHE"&&r!="ZN"&&r!="CA"&&r!="MG"&&r!="CU"&&r!="CU1"&&r!="NA"&&r!="CL") printf "%s,",r}' renumbered.pdb | sed 's/,$//')
    fi
    if [[ -n "$NCAA_LIST" ]]; then
      echo "NCAA residues detected: $NCAA_LIST"
      NCAA_FLAG="--keep-ncaa $NCAA_LIST"
    fi
  elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
    # GROMOS 54A8 has ~80 PTM NCAAs natively parametrized in its FF.
    # Classify NCAAs from renumbered.pdb: FF-native ones go to ncaa_residues.gs (keep with
    # --keep-ncaa so fix_pdb.py doesn't rename them), unknown ones go to ncaa_failed.gs
    # (fix_pdb.py will replace them with parent residues via PDBFixer).
    python3 ../../utils/parametrize_ncaa.py -f renumbered.pdb --gmx-ff gromos54a8
    # Apply PDB CCD → GROMOS residue/atom renames (e.g. TPO→T1P, P→PD) before fix_pdb.py
    if [[ -f ncaa_rename.gs ]]; then
      python3 - << 'RENAME_PY'
import sys
renames = {}   # pdb_resname -> gromos_resname
atom_maps = {} # pdb_resname -> {pdb_atom: gromos_atom}
with open('ncaa_rename.gs') as f:
    for line in f:
        parts = line.rstrip('\n').split('\t')
        if len(parts) >= 2:
            pdb_rn, gros_rn = parts[0], parts[1]
            renames[pdb_rn] = gros_rn
            if len(parts) >= 3 and parts[2]:
                atom_maps[pdb_rn] = dict(p.split('=') for p in parts[2].split(',') if '=' in p)
with open('renumbered.pdb') as f:
    lines = f.readlines()
with open('renumbered.pdb', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM  ', 'HETATM')):
            res = line[17:20].strip()
            if res in renames:
                atom = line[12:16].strip()
                new_atom = atom_maps.get(res, {}).get(atom, atom)
                new_res = renames[res]
                # Rebuild PDB line with renamed residue and atom
                # Atom field: cols 12-15 (4 chars), residue: cols 17-19 (3 chars)
                line = line[:12] + ('%-4s' % new_atom) + line[16:17] + ('%-3s' % new_res) + line[20:]
        f.write(line)
print("Applied GROMOS PTM renames to renumbered.pdb")
RENAME_PY
    fi
    if [[ -f ncaa_residues.gs ]]; then
      NCAA_LIST=$(cat ncaa_residues.gs | tr '\n' ',' | sed 's/,$//')
      if [[ -n "$NCAA_LIST" ]]; then
        NCAA_FLAG="--keep-ncaa $NCAA_LIST"
        echo "GROMOS-native PTM NCAAs (pdb2gmx handles directly): $NCAA_LIST"
      fi
    fi
    if [[ -f ncaa_failed.gs ]]; then
      FAILED=$(cat ncaa_failed.gs | tr '\n' ',' | sed 's/,$//')
      echo "GROMOS-unknown NCAAs (will be replaced with parent residue): $FAILED"
    fi
  fi
  # Fix missing atoms and non-standard residues
  python3 ../../utils/fix_pdb.py -f renumbered.pdb -o fixed.pdb $NCAA_FLAG
  # Add terminal caps: ACE/NME for AMBER19SB variants, ACE-only for CHARMM36 and GROMOS (uses COOH C-term patches)
  if [[ "$FORCEFIELD" == "charmm36" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs --ace-only
    PDB2GMX_INPUT="fixed_capped.pdb"
  elif [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs
    PDB2GMX_INPUT="fixed_capped.pdb"
  elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs --ace-only --rename-ace-carbon
    PDB2GMX_INPUT="fixed_capped.pdb"
  fi
  # GROMOS 54A8: Remove OXT atoms added by PDBFixer - RTP doesn't define OXT, COOH patch handles C-termini
  if [[ "$FORCEFIELD" == "gromos54a8" ]]; then
    sed -i '/ OXT /d' $PDB2GMX_INPUT
  fi
  # Parametrize NCAA residues with OpenFF (AMBER19SB only, before pdb2gmx)
  # GROMOS NCAA handling is done above via native FF entries — no OpenFF needed.
  if [[ -n "$NCAA_FLAG" && ("$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3") ]]; then
    python3 ../../utils/parametrize_ncaa.py -f fixed.pdb --gmx-ff amber19sb
    # If any NCAAs failed (e.g., unsupported elements like Se in MSE),
    # re-run fix_pdb without keeping them so PDBFixer replaces them with parent residue
    if [[ -f ncaa_failed.gs ]]; then
      FAILED=$(cat ncaa_failed.gs | tr '\n' ',' | sed 's/,$//')
      echo "Re-running fix_pdb.py: replacing failed NCAAs ($FAILED) with parent residues"
      # Remove failed NCAAs from keep list
      NEW_NCAA_LIST=$(echo "$NCAA_LIST" | tr ',' '\n' | grep -v -F -f ncaa_failed.gs | tr '\n' ',' | sed 's/,$//')
      if [[ -n "$NEW_NCAA_LIST" ]]; then
        python3 ../../utils/fix_pdb.py -f renumbered.pdb -o fixed.pdb --keep-ncaa "$NEW_NCAA_LIST"
      else
        python3 ../../utils/fix_pdb.py -f renumbered.pdb -o fixed.pdb
      fi
      # Regenerate chain_map.gs and ion_residues.gs with pre-cap residue numbers
      # (cap_termini.py overwrites these with post-cap sequential numbers that
      # won't match the new fixed.pdb generated from renumbered.pdb)
      python3 ../../utils/renumber_pdb.py -f input.pdb -o renumbered.pdb -c $PROTBCHAINS
      # Re-run cap_termini
      if [[ "$FORCEFIELD" == "charmm36" ]]; then
        python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs --ace-only
      elif [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
        python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs
      fi
    fi
    if [[ -d amber19sb.ff ]]; then
      # Use local FF with NCAA entries; set GMXLIB to current dir so pdb2gmx finds it
      if [[ -n "${GMXLIB:-}" ]]; then
        export GMXLIB="$(pwd):${GMXLIB}"
      else
        export GMXLIB="$(pwd)"
      fi
      echo "Using local amber19sb.ff with NCAA entries"
    fi
  fi
  # Add FeS cluster ion entries to local FF if needed (AMBER19SB only)
  # SD is not in standard AMBER19SB; FE2 atom name differs (FE2 vs FE in PDB)
  if grep -q ' SD \| FE2 ' $PDB2GMX_INPUT 2>/dev/null; then
    if [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
      if [[ ! -d amber19sb.ff ]]; then
        # Find GROMACS data directory (varies by installation)
        GMX_DATAPREFIX=$(gmx --version 2>&1 | grep "Data prefix" | awk '{print $NF}')
        GMX_TOPDIR="${GMX_DATAPREFIX}/share/gromacs/top"
        cp -r "$GMX_TOPDIR/amber19sb.ff" .
        echo "Created local amber19sb.ff from $GMX_TOPDIR"
      fi
      # Add SD entry if missing
      if ! grep -q '^\[ SD \]' amber19sb.ff/aminoacids.rtp 2>/dev/null; then
        printf '\n[ SD ]\n; Sulfide ion (from FeS cluster, charge -1.0 for oxidized state)\n [ atoms ]\n  S      S     -1.000000    1\n [ bonds ]\n\n' >> amber19sb.ff/aminoacids.rtp
        echo "Added SD ion entry to local amber19sb.ff"
      fi
      # Fix FE/FE2 atom names: AMBER uses FE2/FE as atom names, but PDB has FE for both
      sed -i 's/^  FE2    Fe2+/  FE     Fe2+/' amber19sb.ff/aminoacids.rtp
      sed -i 's/^  FE     Fe3+/  FE     Fe3+/' amber19sb.ff/aminoacids.rtp
      echo "Fixed FE2 atom name in local amber19sb.ff"
      if [[ -n "${GMXLIB:-}" ]]; then
        export GMXLIB="$(pwd):${GMXLIB}"
      else
        export GMXLIB="$(pwd)"
      fi
    fi
  fi
  # Strip H from NCAA residues — PDBFixer/cap_termini may add wrong H (e.g., HG1 on
  # phosphorylated OG1 in TPO). pdb2gmx with -ignh re-adds correct H from HDB.
  if [[ -n "$NCAA_FLAG" ]]; then
    python3 -c "
import sys
ncaas = set('$NCAA_LIST'.split(','))
with open('$PDB2GMX_INPUT') as f:
    lines = f.readlines()
with open('$PDB2GMX_INPUT', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM','HETATM')) and line[17:20].strip() in ncaas:
            if line[12:16].strip().startswith('H'):
                continue  # strip wrong H from NCAA
            if line.startswith('HETATM'):
                line = 'ATOM  ' + line[6:]  # ensure NCAA is ATOM
        f.write(line)
"
  fi
  # Fix protonation states for ion-coordinating CYS/HIS residues
  python3 ../../utils/fix_ion_protonation.py -f $PDB2GMX_INPUT -m ion_residues.gs --ff $FORCEFIELD
  # Ion residue names for pdb2gmx chain handling
  ION_RESIDUES="BA|CA|CD|CL|CO|CS|CU|CU1|FE|FE2|HG|K|LI|MG|MN|NA|NI|PB|SD|SR|ZN"
  # Get chain ID and residue name of first atom in each segment
  # Format: "chain_id resname" per line
  CHAIN_DATA=$(awk 'BEGIN{first=1} /^TER/{first=1; next} /^ATOM/ && first{chain=substr($0,22,1); res=substr($0,18,3); gsub(/ /,"",res); print chain, res; first=0}' $PDB2GMX_INPUT)
  # Merge selections: y if same chain ID as previous (and neither is an ion), n otherwise
  MERGE_INPUT=""
  prev_chain=""
  prev_res=""
  while read -r chain res; do
    if [[ -n "$prev_chain" ]]; then
      if [[ "$res" =~ ^($ION_RESIDUES)$ ]] || [[ "$prev_res" =~ ^($ION_RESIDUES)$ ]]; then
        MERGE_INPUT="${MERGE_INPUT}n\n"
      elif [[ "$chain" == "$prev_chain" ]]; then
        MERGE_INPUT="${MERGE_INPUT}y\n"
      else
        MERGE_INPUT="${MERGE_INPUT}n\n"
      fi
    fi
    prev_chain=$chain
    prev_res=$res
  done <<< "$CHAIN_DATA"
  # Count protein-only segments (ions have no terminal patches, pdb2gmx won't prompt for them)
  NSEGS_PROTEIN=$(echo "$CHAIN_DATA" | awk -v ions="$ION_RESIDUES" 'BEGIN{split(ions,a,"|"); for(i in a) ion[a[i]]=1; n=0} {if(!($2 in ion)) n++} END{print n}')
  # Terminal selections per protein segment: N-terminus then C-terminus
  # CHARMM36: N-term 8 (none, ACE is explicit), C-term 1 (COOH patch)
  # AMBER19SB variants: No terminal selections needed (no termini defined in FF)
  # GROMOS 54A7: N-term 2 (none, ACE is explicit), C-term 1 (COOH patch)
  # GROMOS 54A8: N-term 8 (none, ACE is explicit), C-term 1 (COOH patch)
  if [[ "$FORCEFIELD" == "charmm36" ]]; then
    TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
  elif [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
    TER_INPUT=""
  elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
    TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
  fi
  # Merge questions come first, then terminal selections
  echo -e "${MERGE_INPUT}${TER_INPUT}" | gmx pdb2gmx -f $PDB2GMX_INPUT -water $WATER_MODEL $FF_FLAG -ignh -missing -ter -chainsep id_or_ter -merge interactive -o conf.gro
  # Parametrize small molecules with OpenFF (AMBER19SB only)
  # Each instance gets a unique molecule name via running counter (-i)
  if [[ $LIGAND_PARAM -eq 1 && ("$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3") ]]; then
    LIGAND_INSTANCE=0
    for ligpdb in ligand_*.pdb; do
      [ -f "$ligpdb" ] || continue
      # Parse resname and chain from filename:
      #   ligand_{RESNAME}_{CHAIN}.pdb        (single instance)
      #   ligand_{RESNAME}_{CHAIN}_{RESNUM}.pdb (multiple instances)
      SUFFIX=$(basename "$ligpdb" .pdb | sed 's/^ligand_//')
      RESNAME=$(echo "$SUFFIX" | sed 's/_[A-Z]$//;s/_[A-Z]_[0-9]*$//')
      CHAIN=$(echo "$SUFFIX" | sed 's/.*_\(.\)$/\1/;s/.*_\(.\)_[0-9]*$/\1/')
      python3 ../../utils/parametrize_ligand.py -f "$ligpdb" -r "$RESNAME" -c "$CHAIN" -i $LIGAND_INSTANCE
      LIGAND_INSTANCE=$((LIGAND_INSTANCE + 1))
    done
  fi
fi
# with restart and cutout mode, chain_map.gs references the cutout protein
bl=0
if [[ "$MODE" != "cycle" && ! -f conf_cutout.gro ]]; then
  bl=$(python3 ../../utils/check_brokenloop.py -f conf.gro -m chain_map.gs)
fi
if [[ $bl -eq 0 ]]; then
# ===== SETUP PHASE =====================================================
# Everything the cycles share: stage 0, the initial equilibration, and the
# restraint definition (elastic network + interface + Boresch) written into the
# leg .mdp files. Runs once per structure; skipped entirely by --cycle tasks.
if [[ "$MODE" != "cycle" ]]; then
  # Stage 0: Prepare system up to emin_solv.gro
  if [[ ! -f conf_vacbox.gro ]]; then
    if [[ $CUTOUT -eq 1 ]]; then
      python3 ../../utils/make_cutout.py -m chain_map.gs
      # Add terminal caps: ACE/NME for AMBER19SB variants, ACE-only for CHARMM36 and GROMOS
      if [[ "$FORCEFIELD" == "charmm36" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs --ace-only
        CUTOUT_PDB="cutout_capped.pdb"
      elif [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs
        CUTOUT_PDB="cutout_capped.pdb"
      elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs --ace-only --rename-ace-carbon
        CUTOUT_PDB="cutout_capped.pdb"
      fi
      # GROMOS 54A8: Remove OXT atoms - RTP doesn't define OXT, COOH patch handles C-termini
      if [[ "$FORCEFIELD" == "gromos54a8" ]]; then
        sed -i '/ OXT /d' $CUTOUT_PDB
      fi
      # Strip H from NCAA residues in cutout (same issue as full protein)
      if [[ -n "$NCAA_FLAG" ]]; then
        python3 -c "
import sys
ncaas = set('$NCAA_LIST'.split(','))
with open('$CUTOUT_PDB') as f:
    lines = f.readlines()
with open('$CUTOUT_PDB', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM','HETATM')) and line[17:20].strip() in ncaas:
            if line[12:16].strip().startswith('H'):
                continue  # strip wrong H from NCAA
            if line.startswith('HETATM'):
                line = 'ATOM  ' + line[6:]  # ensure NCAA is ATOM
        f.write(line)
"
      fi
      # Fix protonation states for ion-coordinating CYS/HIS in cutout
      python3 ../../utils/fix_ion_protonation.py -f $CUTOUT_PDB -m ion_residues.gs --ff $FORCEFIELD
      # re-solvate cutout
      # Get chain ID and residue name of first atom in each segment
      CHAIN_DATA=$(awk 'BEGIN{first=1} /^TER/{first=1; next} /^ATOM/ && first{chain=substr($0,22,1); res=substr($0,18,3); gsub(/ /,"",res); print chain, res; first=0}' $CUTOUT_PDB)
      # Merge selections: y if same chain ID as previous (and neither is an ion), n otherwise
      MERGE_INPUT=""
      prev_chain=""
      prev_res=""
      while read -r chain res; do
        if [[ -n "$prev_chain" ]]; then
          if [[ "$res" =~ ^($ION_RESIDUES)$ ]] || [[ "$prev_res" =~ ^($ION_RESIDUES)$ ]]; then
            MERGE_INPUT="${MERGE_INPUT}n\n"
          elif [[ "$chain" == "$prev_chain" ]]; then
            MERGE_INPUT="${MERGE_INPUT}y\n"
          else
            MERGE_INPUT="${MERGE_INPUT}n\n"
          fi
        fi
        prev_chain=$chain
        prev_res=$res
      done <<< "$CHAIN_DATA"
      # Count protein-only segments (ions don't need terminal selections)
      NSEGS_PROTEIN=$(echo "$CHAIN_DATA" | awk -v ions="$ION_RESIDUES" 'BEGIN{split(ions,a,"|"); for(i in a) ion[a[i]]=1; n=0} {if(!($2 in ion)) n++} END{print n}')
      # Terminal selections per protein segment
      if [[ "$FORCEFIELD" == "charmm36" ]]; then
        TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
      elif [[ "$FORCEFIELD" == "amber19sb_opc" || "$FORCEFIELD" == "amber19sb_opc3" ]]; then
        TER_INPUT=""
      elif [[ "$FORCEFIELD" == "gromos54a8" ]]; then
        TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
      fi
      # Merge questions come first, then terminal selections
      echo -e "${MERGE_INPUT}${TER_INPUT}" | gmx pdb2gmx -f $CUTOUT_PDB -water $WATER_MODEL $FF_FLAG -ignh -missing -ter -chainsep id_or_ter -merge interactive -o conf_cutout.gro
      # Ligand ITP/GRO files already created during initial parametrization above
      # Merge ligands and crystal waters into cutout topology
      python3 ../../utils/merge_ligand.py -t topol.top -c conf_cutout.gro -m chain_map.gs
      python3 ../../utils/merge_crystal_waters.py -t topol.top -c conf_cutout.gro --proximity
      # Generate ion coordination restraints (active from first energy minimization)
      python3 ../../utils/make_ion_restraints.py -f conf_cutout.gro -m chain_map.gs
      gmx editconf -f conf_cutout.gro -bt dodecahedron -d 10 -o conf_vacbox.gro
    else
      # No cutout: merge ligands and crystal waters into full protein system
      python3 ../../utils/merge_ligand.py -t topol.top -c conf.gro -m chain_map.gs
      python3 ../../utils/merge_crystal_waters.py -t topol.top -c conf.gro
      python3 ../../utils/make_ion_restraints.py -f conf.gro -m chain_map.gs
      gmx editconf -f conf.gro -bt dodecahedron -d 10 -o conf_vacbox.gro
    fi
  fi
  if [[ ! -f emin_solv.gro ]]; then
    if [[ ! -f emin_vac.tpr ]]; then
      gmx grompp -f $MDP_DIR/emin_vac.mdp -c conf_vacbox.gro -o emin_vac -maxwarn 2
    fi
    if [[ ! -f emin_vac.gro ]]; then
      gmx mdrun -nt $nt $GPUOPT -deffnm emin_vac
    fi
    # Guard: if vacuum grompp/mdrun did not produce emin_vac.gro, stage 0 failed
    # (e.g. topology/coordinate mismatch). Do NOT fall through to the entangled-loop
    # check — on a missing file it returns empty, and `[[ "" -eq 0 ]]` is TRUE, which
    # would mislabel the structure "OK" and cascade the failure through stage 0.
    if [[ ! -f emin_vac.gro ]]; then
      echo "Stage 0 failed: vacuum energy minimization did not produce emin_vac.gro."
      echo $STRUCT_ID "FAILED" >> ../results_0.gs
      exit 0
    fi
    et=$(python3 ../../utils/check_entangledloops.py -f emin_vac.gro -m chain_map.gs)
    if [[ "$et" == "0" ]]; then
      echo "after equilibration no entangled loops were found."
      echo $STRUCT_ID "OK" >> ../results_0.gs

      # ===== PROBE PASS: equilibrate small, measure, then size the real box =====
      #
      # The production box has to satisfy the GROMACS pull check, 0.49 * the
      # shortest box vector, against interface pairs that only separate once the
      # partners come apart. That demand is not predictable from the minimised
      # structure: the rigorous static bound asks for -d 3.96, and the interface
      # pair set taken from emin_vac.gro has Jaccard 0.31 against the real one. So
      # the size was a constant, 1.5 and then 1.8, measured once on 2KTF.
      #
      # It does not have to be. The bound complex never needs the production box:
      # the largest checked pull pair in the bound reference is 1.18 nm on 2KTF
      # against a limit of 3.29 nm even at -d 1.00. So the long equilibration runs
      # HERE, in a small box, purely to be measured, and the production box is
      # then built from what it measured. The circularity is broken by running the
      # measurement in a box that does not need to be right.
      #
      # This trajectory is also what make_boresch.py takes its backbone RMSF from.
      # Its atom numbering is identical to the production system for atoms 1..N of
      # the solute, since only the solvent count differs, and make_boresch reads
      # geometry from -f and fluctuations from --traj as separate inputs.
      PROBEPAD=$(awk -v r="$(awk -F= '/^ *rvdw *=/{gsub(/[ \t]/,"",$2); print $2; exit}' $MDP_DIR/bind_fe.mdp)" \
                     'BEGIN{ if (r+0 <= 0) r = 1.0; printf "%.2f", r/2 + 0.5 }')
      if [[ ! -f boxpad.gs ]]; then
        echo "Probe pass: equilibrating in a small box (-d $PROBEPAD) to measure the production box."
        if [[ ! -f box_probe.gro ]]; then
          gmx editconf -f emin_vac.gro -o box_probe.gro -bt dodecahedron -d $PROBEPAD
        fi
        # Solvate, ionise and the topology they mutate are ONE step, guarded on
        # the last file the sequence produces. They cannot be guarded
        # individually: topol_probe.top is derived from the dry topol.top and then
        # rewritten by both solvate and genion, so a directory re-entered after a
        # partial probe would reset the topology to dry, skip the solvate whose
        # output already exists, and hand grompp a dry topology against solvated
        # coordinates. That is exactly the atom-count mismatch this block failed
        # with the first time it ran. Re-deriving from scratch costs about 5 s.
        if [[ ! -f solv_ions_probe.gro ]]; then
          rm -f box_solv_probe.gro ions_probe.tpr topol_probe.top
          cp topol.top topol_probe.top
          gmx solvate -cp box_probe.gro -cs $WATER_BOX -o box_solv_probe.gro -p topol_probe.top
          python3 ../../utils/fix_topol_intermolecular.py -p topol_probe.top
          # -p is mandatory here: the default is topol.top, which is the DRY
          # topology, while the coordinates are solvated.
          gmx grompp -r box_solv_probe.gro -f $MDP_DIR/emin_vac.mdp -c box_solv_probe.gro -p topol_probe.top -o ions_probe -maxwarn 2
          echo -e "SOL\n" | gmx genion -s ions_probe.tpr -o solv_ions_probe.gro -p topol_probe.top -pname NA -nname CL -conc 0.15 -neutral
          python3 ../../utils/fix_topol_intermolecular.py -p topol_probe.top
        fi
        if [[ ! -f solv_ions_probe.gro ]]; then
          echo "Stage 0 failed: probe solvation produced no solv_ions_probe.gro."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          exit 0
        fi
        if [[ ! -f emin_probe_sd.gro ]]; then
          gmx grompp -r solv_ions_probe.gro -f $MDP_DIR/emin_solv.mdp -c solv_ions_probe.gro -p topol_probe.top -o emin_probe_sd -maxwarn 2
          gmx mdrun -nt $nt $GPUOPT -deffnm emin_probe_sd
        fi
        if [[ ! -f emin_probe.gro ]]; then
          gmx grompp -r solv_ions_probe.gro -f $MDP_DIR/emin_solv_cg.mdp -c emin_probe_sd.gro -p topol_probe.top -o emin_probe -maxwarn 2
          gmx mdrun -nt $nt $GPUOPT -deffnm emin_probe
        fi
        if [[ ! -f emin_probe.gro ]]; then
          echo "Stage 0 failed: probe minimisation produced no emin_probe.gro."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          exit 0
        fi
        if [[ ! -f index_probe.ndx ]]; then
          echo -e "! \"Water\"\nq\n" | gmx make_ndx -f emin_probe.gro -o index_probe.ndx
          python3 ../../utils/make_cluster_group.py -f emin_probe.gro -n index_probe.ndx
        fi
        prev=emin_probe
        for stage in 1 2 3 4 5; do
          if [[ ! -f nvt_${stage}_probe.gro ]]; then
            if [[ "$prev" == "emin_probe" ]]; then
              gmx grompp -r emin_probe.gro -f $MDP_DIR/nvt_${stage}.mdp -c emin_probe.gro -p topol_probe.top -o nvt_${stage}_probe -n index_probe.ndx -maxwarn 10
            else
              gmx grompp -r emin_probe.gro -f $MDP_DIR/nvt_${stage}.mdp -c ${prev}.tpr -t ${prev}.cpt -p topol_probe.top -o nvt_${stage}_probe -n index_probe.ndx -maxwarn 10
            fi
            timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_${stage}_probe
          fi
          prev=nvt_${stage}_probe
        done
        if [[ ! -f npt_probe.tpr ]]; then
          gmx grompp -r emin_probe.gro -f $MDP_DIR/npt_init_fe.mdp -c nvt_5_probe.tpr -t nvt_5_probe.cpt -p topol_probe.top -o npt_probe -n index_probe.ndx -maxwarn 10
        fi
        if [[ ! -f npt_probe.gro ]]; then
          CPI=""
          [[ -f npt_probe.cpt ]] && CPI="-cpi npt_probe.cpt"
          timeout -s 9 600m gmx mdrun -nt $nt $GPUOPT -deffnm npt_probe $CPI
        fi
        if [[ ! -f npt_probe.gro ]]; then
          echo "Stage 0 failed: probe equilibration did not finish (no npt_probe.gro)."
          echo "  Re-running this structure resumes from npt_probe.cpt."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          exit 0
        fi
        # Running maximum over the whole probe run, on Protein_Struct, clustered.
        python3 ../../utils/measure_box.py -f npt_probe.xtc -s npt_probe.tpr \
                -n index_probe.ndx -g Protein_Struct -c emin_vac.gro \
                --pad 1.5 > boxpad.tmp
        MB_RC=$?
        if [[ $MB_RC -ne 0 || ! -s boxpad.tmp ]]; then
          echo "Stage 0 failed: measure_box.py exited $MB_RC."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          rm -f boxpad.tmp
          exit 0
        fi
        mv boxpad.tmp boxpad.gs
      fi

      if [[ ! -f box.gro ]]; then
        # Two independent requirements. Solvation is NOT the binding one.
        #
        # Solvation / minimum image: editconf -d puts periodic images 2d apart,
        # so the solute stops seeing itself once 2d > rvdw, i.e. d > rvdw/2. The
        # unbinding pull grows the solute envelope by pull_dist, which costs
        # pull_dist/2 of clearance on each side, so the floor is
        # rvdw/2 + pull_dist/2. That is 1.00 for amber19sb_opc/opc3 (rvdw 1.0),
        # 1.10 for charmm36 (1.2) and 1.20 for gromos54a8 (1.4). Every one of
        # them is well under the value actually used, so this floor never binds
        # in practice; it is here to catch an exotic cutoff, not to size the box.
        #
        # What actually sizes the box is the GROMACS pull check, 0.49 * the
        # shortest box VECTOR (not the shortest diagonal element; verified
        # against grompp). That demand is dynamical and much larger: interface
        # pairs start at <= 0.6 nm and reach 3.59 nm on 2KTF once the partners
        # separate, while the Boresch coordinates never pass 2.05 nm. So it is
        # the interface restraints that set the box, NOT the Boresch anchors and
        # not which anchor-selection mode ran.
        #
        # BOXPAD_DEFAULT stays at the empirically validated 1.8. Do not lower it
        # to the floor: -d 1.5 is documented to fail on this very protocol,
        # "Distance between pull groups 73 and 75 (3.772877 nm) is larger than
        # 0.49 times the box size (3.770459)", and 1.8 puts the limit at 4.045.
        # It is a 2KTF-derived constant, so it is a guess for any other complex;
        # replacing it needs the per-structure demand measured at the first frame
        # of bindrev, which nothing static predicts (the rigorous static bound
        # asks for -d 3.96, and the interface pair set from emin_vac.gro has
        # Jaccard 0.31 against the real one). Until that exists, boxpad.gs is the
        # manual override for a structure known to need more.
        # boxpad.gs is written by the probe pass above, from measure_box.py, and
        # is authoritative when present: L = D_max + 2*1.5 with D_max the running
        # maximum solute atom-atom distance over the probe equilibration. It is
        # clamped to [FLOOR, 4.0] only as a sanity range, not to steer it.
        # BOXPAD_FALLBACK is used only when no probe ran, e.g. a directory set up
        # before this change. It is the old 2KTF-derived constant and is a guess
        # for any other complex, which is the whole reason for the probe.
        BOXPAD_FALLBACK=1.8
        RVDW=$(awk -F= '/^ *rvdw *=/{gsub(/[ \t]/,"",$2); print $2; exit}' $MDP_DIR/bind_fe.mdp)
        [[ -z "$RVDW" ]] && RVDW=1.0
        FLOOR=$(awk -v r="$RVDW" -v p="$PULL_DIST" 'BEGIN{printf "%.2f", r/2 + p/2}')
        BOXPAD=""
        if [[ -s boxpad.gs ]]; then
          WANT=$(awk 'NR==1{print $1+0}' boxpad.gs)
          if awk -v w="$WANT" -v f="$FLOOR" 'BEGIN{exit !(w >= f && w <= 4.0)}'; then
            BOXPAD=$WANT
            echo "Box padding: -d $BOXPAD nm, measured (boxpad.gs)."
          else
            echo "boxpad.gs value '$WANT' outside [$FLOOR, 4.0]; ignoring it."
          fi
        fi
        if [[ -z "$BOXPAD" ]]; then
          BOXPAD=$(awk -v f="$FLOOR" -v d="$BOXPAD_FALLBACK" 'BEGIN{printf "%.2f", (f>d)?f:d}')
          echo "Box padding: -d $BOXPAD nm, NOT measured (no usable boxpad.gs; floor $FLOOR, fallback $BOXPAD_FALLBACK)."
        fi
        echo "$BOXPAD" > boxpad_used.gs
        echo "$BOXPAD" > boxpad_used.gs
        gmx editconf -f emin_vac.gro -o box.gro -bt dodecahedron -d $BOXPAD
      fi
      if [[ ! -f box_solv.gro ]]; then
        gmx solvate -cp box.gro -cs $WATER_BOX -o box_solv.gro -p topol.top
        # gmx solvate appends SOL inside [ intermolecular_interactions ] — fix by moving it back to end
        python3 ../../utils/fix_topol_intermolecular.py -p topol.top
      fi
      if [[ ! -f ions.tpr ]]; then
        gmx grompp -r box_solv.gro -f $MDP_DIR/emin_vac.mdp -c box_solv.gro -o ions.tpr -maxwarn 2
      fi
      if [[ ! -f solv_ions.gro ]]; then
        echo -e "SOL\n" | gmx genion -s ions.tpr -o solv_ions.gro -p topol.top -pname NA -nname CL -conc 0.15 -neutral
        # gmx genion modifies [ molecules ] — fix topology ordering again
        python3 ../../utils/fix_topol_intermolecular.py -p topol.top
      fi
      if [[ ! -f emin_solv_sd.tpr ]]; then
        gmx grompp -r solv_ions.gro -f $MDP_DIR/emin_solv.mdp -c solv_ions.gro -o emin_solv_sd -maxwarn 2
      fi
      if [[ ! -f emin_solv_sd.gro ]]; then
        gmx mdrun -nt $nt $GPUOPT -deffnm emin_solv_sd
      fi
      # Conjugate gradient refinement (resolves clashes that SD can't escape)
      if [[ ! -f emin_solv.tpr ]]; then
        gmx grompp -r solv_ions.gro -f $MDP_DIR/emin_solv_cg.mdp -c emin_solv_sd.gro -o emin_solv -maxwarn 2
      fi
      if [[ ! -f emin_solv.gro ]]; then
        gmx mdrun -nt $nt $GPUOPT -deffnm emin_solv
      fi
    elif [[ "$et" == "1" ]]; then
      echo "after equilibration entangled loops were found."
      echo $STRUCT_ID "ENTANGLED" >> ../results_0.gs
      exit 0
    else
      echo "Stage 0 failed: entanglement check returned unexpected output ('$et')."
      echo $STRUCT_ID "FAILED" >> ../results_0.gs
      exit 0
    fi
  else
    # Restart: emin_solv.gro already exists, so stage 0 completed earlier (an
    # entangled structure would have exited before solvation). Re-emit the status;
    # if emin_vac.gro is gone, trust the finished setup rather than empty -> "OK".
    if [[ ! -f emin_vac.gro ]]; then
      echo $STRUCT_ID "OK" >> ../results_0.gs
    else
      et=$(python3 ../../utils/check_entangledloops.py -f emin_vac.gro -m chain_map.gs)
      if [[ "$et" == "1" ]]; then
        echo "entangled loops were found."
        echo $STRUCT_ID "ENTANGLED" >> ../results_0.gs
        exit 0
      else
        echo "no entangled loops were found."
        echo $STRUCT_ID "OK" >> ../results_0.gs
      fi
    fi
  fi

  # Create index file with custom clustering group
  # !Water group for output (protein, ions, ligands, counterions)
  # Protein_Struct group for centering: Protein + structural ions + ligands (no counterions)
  echo -e "! \"Water\"\nq\n" | gmx make_ndx -f emin_solv.gro -o index.ndx
  python3 ../../utils/make_cluster_group.py -f emin_solv.gro -n index.ndx

  # Run one equilibration to generate disres (needs equilibrated structure for distances)
  
  if [[ ! -f nvt_1_init.tpr ]]; then
    gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_1.mdp -c emin_solv.gro -p topol.top -o nvt_1_init -maxwarn 10
  fi
  if [[ ! -f nvt_1_init.gro ]]; then
    timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_1_init
  fi
  if [[ ! -f nvt_2_init.tpr ]]; then
    gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_2.mdp -c nvt_1_init.tpr -t nvt_1_init.cpt -p topol.top -o nvt_2_init -maxwarn 10
  fi
  if [[ ! -f nvt_2_init.gro ]]; then
    timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_2_init
  fi
  if [[ ! -f nvt_3_init.tpr ]]; then
    gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_3.mdp -c nvt_2_init.tpr -t nvt_2_init.cpt -p topol.top -o nvt_3_init -maxwarn 10
  fi
  if [[ ! -f nvt_3_init.gro ]]; then
    timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_3_init
  fi
  if [[ ! -f nvt_4_init.tpr ]]; then
    gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_4.mdp -c nvt_3_init.tpr -t nvt_3_init.cpt -p topol.top -o nvt_4_init -maxwarn 10
  fi
  if [[ ! -f nvt_4_init.gro ]]; then
    timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_4_init
  fi
  if [[ ! -f nvt_5_init.tpr ]]; then
    gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_5.mdp -c nvt_4_init.tpr -t nvt_4_init.cpt -p topol.top -o nvt_5_init -n index.ndx -maxwarn 10
  fi
  if [[ ! -f nvt_5_init.gro ]]; then
    timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_5_init
  fi
  if [[ ! -f npt_init.tpr ]]; then
    # npt_fe.mdp (1 ns), not npt_init_fe.mdp (11 ns): the long equilibration has
    # moved to the probe pass, which is where the box size is measured and where
    # make_boresch.py takes its backbone RMSF from. All this run has to do is
    # relax the freshly added solvent around an already-equilibrated solute and
    # produce the reference structure the restraints are built on.
    # Runs straight off the NVT ladder: C-rescale is first order, so it relaxes
    # the box monotonically instead of oscillating the way Parrinello-Rahman does
    # from a box that has never been pressure-coupled, and needs no weak-coupling
    # stage in front of it.
    gmx grompp -r emin_solv.gro -f $MDP_DIR/npt_fe.mdp -c nvt_5_init.tpr -t nvt_5_init.cpt -p topol.top -o npt_init -n index.ndx -maxwarn 10
  fi
  if [[ ! -f npt_init.gro ]]; then
    # 600m, not the 60m every shorter stage uses. This leg is 11 ns: at the
    # ~260 ns/day one single-threaded slot reaches it needs just over an hour
    # alone, and a few hours when eight slots share a GPU. It inherited 60m from
    # when it was 1 ns and was killed at 98.6 % with no confout written, after
    # which every step below ran against files that did not exist.
    # -cpi so a kill costs the remaining steps rather than all of them.
    CPI=""
    [[ -f npt_init.cpt ]] && CPI="-cpi npt_init.cpt"
    timeout -s 9 600m gmx mdrun -nt $nt $GPUOPT -deffnm npt_init $CPI
  fi
  if [[ ! -f npt_init.gro ]]; then
    echo "Stage 0 failed: npt_init equilibration did not finish (no npt_init.gro)."
    echo "  Re-running this structure resumes from npt_init.cpt."
    echo $STRUCT_ID "NPT_INIT_FAIL" >> ../results_0.gs
    exit 0
  fi
  if [[ ! -f npt_init_whole.gro ]]; then
    echo -e "0\n" | gmx trjconv -f npt_init.gro -s emin_solv.tpr -o npt_init_whole.gro -pbc whole
  fi
  if [[ ! -f npt_init_whole.gro ]]; then
    echo "Stage 0 failed: trjconv -pbc whole produced no npt_init_whole.gro."
    echo $STRUCT_ID "TRJCONV_FAIL" >> ../results_0.gs
    exit 0
  fi
  if [[ ! -f npt_init_cluster.gro ]]; then
    # Output full system (0) to preserve atom numbering for pull group indices
    echo -e "Protein_Struct\n0\n" | gmx trjconv -f npt_init_whole.gro -s emin_solv.tpr -o npt_init_cluster.gro -pbc cluster -n index.ndx
  fi
  if [[ ! -f npt_init_cluster.pdb ]]; then
    echo -e "Protein_Struct\n!Water\n" | gmx trjconv -f npt_init_whole.gro -s emin_solv.tpr -o npt_init_cluster.pdb -pbc cluster -n index.ndx
  fi
  # npt_init_cluster.gro is the reference every restraint below is built on, and
  # make_boresch.py now also takes its Boresch reference geometry from it.
  if [[ ! -f npt_init_cluster.gro ]]; then
    echo "Stage 0 failed: trjconv -pbc cluster produced no npt_init_cluster.gro."
    echo $STRUCT_ID "TRJCONV_FAIL" >> ../results_0.gs
    exit 0
  fi

  # Generate the FE pull configuration (interface + Boresch + elastic network)
  # from the equilibrated reference structure. make_boresch.py appends the full
  # pull block to each leg .mdp and emits the analytical Boresch term.
  echo "Generating FE restraints (interface + Boresch + elastic network)."
  cp $MDP_DIR/bind_fe.mdp $MDP_DIR/bindrev_fe.mdp $MDP_DIR/nptrev_fe.mdp $MDP_DIR/boundfwd.mdp $MDP_DIR/boundrev.mdp ./
  # Write to a temp name and promote on success. Redirecting straight into
  # numpertres.gs meant a crashed make_boresch.py still created the file the
  # checks below look for, 0 bytes and indistinguishable from a real result.
  # Geometry from the production reference (-f), fluctuations from the probe run
  # (--traj/--tpr). They are separate inputs by design: the reference COM of every
  # anchor group comes from -f, while eps and the frame-rotation check come from
  # the trajectory, and both are insensitive to which box the trajectory was run
  # in. Solute atom numbering is identical between the two systems, only the
  # solvent count differs, so the atom-number mapping holds.
  BOR_TRAJ=npt_probe.xtc; BOR_TPR=npt_probe.tpr
  if [[ ! -s $BOR_TRAJ ]]; then BOR_TRAJ=npt_init.xtc; BOR_TPR=npt_init.tpr; fi
  python3 ../../utils/make_boresch.py -f npt_init_cluster.gro -m chain_map.gs -T 310 --pull-dist $PULL_DIST --pull-rate 0.00005 --traj $BOR_TRAJ --tpr $BOR_TPR --topol topol.top > numpertres.tmp
  MB_RC=$?
  # If Boresch anchor selection failed, flag the structure and stop.
  if [[ -f boresch_failed.gs ]]; then
    echo "Boresch anchor selection failed."
    echo $STRUCT_ID "BORESCH_FAIL" >> ../results_0.gs
    rm -f numpertres.tmp
    exit 0
  fi
  # The exit status and the size must both be checked. The graceful failure path
  # prints "0" and writes its marker above, so a size test alone reads it as a
  # result; an uncaught exception writes no marker at all, so a marker test alone
  # reads it as success. That combination is what released 50 cycles against
  # .mdp files whose pull block had never been appended.
  if [[ $MB_RC -ne 0 || ! -s numpertres.tmp ]]; then
    echo "Stage 0 failed: make_boresch.py exited $MB_RC (see the traceback above)."
    echo $STRUCT_ID "BORESCH_FAIL" >> ../results_0.gs
    rm -f numpertres.tmp
    exit 0
  fi
  mv numpertres.tmp numpertres.gs
  # Record the analytical Boresch standard-state term (dG_release, kJ/mol) at the
  # top level so groscore_fe.py can read it without unpacking archives.
  # One idempotent file per structure, rewritten on every setup: gating this on a
  # marker inside the structure directory made it unrecoverable if the top-level
  # record was ever removed -- the marker said "already recorded" while the value
  # was gone, and every structure then scored as PENDING with no dG at all.
  if [[ -f boresch_analytical.gs ]]; then
    DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
    mkdir -p ../results_analytical.d
    echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
  fi

  # Post-condition before the marker goes down. setup.done is the only gate the
  # cycles honour, and groscore_fe.py skips the setup job entirely when it is
  # present, so touching it unconditionally does not merely mislabel a failure:
  # it makes the directory unrecoverable, because no later run will redo setup.
  # Check the artefacts the cycles actually consume. The .mdp test is a real
  # post-condition, since no shipped template contains pull-ngroups and
  # make_boresch.py writes it at column 0 for every leg it touches.
  SETUP_MISSING=""
  [[ -s numpertres.gs ]]         || SETUP_MISSING="$SETUP_MISSING numpertres.gs"
  [[ -s boresch_analytical.gs ]] || SETUP_MISSING="$SETUP_MISSING boresch_analytical.gs"
  [[ -s boresch_anchors.gs ]]    || SETUP_MISSING="$SETUP_MISSING boresch_anchors.gs"
  for m in bind_fe.mdp bindrev_fe.mdp nptrev_fe.mdp boundfwd.mdp boundrev.mdp; do
    grep -q '^pull-ngroups' "$m" 2>/dev/null || SETUP_MISSING="$SETUP_MISSING $m:pull-block"
  done
  if [[ -n "$SETUP_MISSING" ]]; then
    echo "Stage 0 failed: setup produced no usable restraints; missing or empty:$SETUP_MISSING"
    echo $STRUCT_ID "SETUP_FAIL" >> ../results_0.gs
    exit 0
  fi

  # Setup finished: release any --cycle tasks that are waiting on this marker.
  touch setup.done
  echo "Setup complete for $STRUCT_ID (restraints defined)."
  if [[ "$MODE" == "setup" ]]; then
    exit 0
  fi
fi
# ===== END SETUP PHASE =================================================

# ===== CYCLE PHASE =====================================================
# A local force field with NCAA / FeS entries lives in the structure directory.
# The setup phase exports GMXLIB inside its own block, so re-export it here for
# --cycle tasks that skip that block, otherwise grompp cannot resolve the include.
if [[ -d amber19sb.ff ]]; then
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="$(pwd):${GMXLIB}"
  else
    export GMXLIB="$(pwd)"
  fi
fi

# Read NUMPERTRES for integration
if [[ ! -s numpertres.gs ]]; then
  echo "numpertres.gs is missing or empty; setup did not define the restraints."
  exit 1
fi
while read -r a b
do
  NUMPERTRES=$a
done < numpertres.gs

# Pull rate this structure was set up with. integrate.py turns the time integral
# of the pull force into work by multiplying by the rate, so it must match the
# rate written into the .mdp -- read it back rather than hard-coding, so cycles
# re-integrated later (backfill/repair) use the rate they were actually run at.
PULL_RATE=$(awk '$1=="pull_rate_nm_ps"{print $2}' boresch_analytical.gs 2>/dev/null)
if [[ -z "$PULL_RATE" ]]; then
  PULL_RATE=0.00005
fi

# Independent equilibration cycles
# Each cycle: fresh equilibration -> pull -> short NPT -> push.
# Cycles are independent (each restarts from emin_solv.gro with new velocities),
# so they can run concurrently as separate array tasks.
# Total number of cycles wanted. GROSCORE_NUMCYCLES (exported by the generated
# SLURM script) takes precedence over run.gs so the total can be raised later to
# add cycles -- including for archived structures, whose run.gs cannot be
# rewritten from outside the tarball.
NUMCYCLES=${GROSCORE_NUMCYCLES:-$((MAXRUNS/2))}
if [[ "$MODE" == "cycle" ]]; then
  if [[ $CYCLE_ARG -gt $NUMCYCLES ]]; then
    echo "Cycle $CYCLE_ARG exceeds NUMCYCLES=$NUMCYCLES; nothing to do."
    exit 0
  fi
  CYCLE_START=$CYCLE_ARG
  CYCLE_END=$CYCLE_ARG
else
  CYCLE_START=1
  CYCLE_END=$NUMCYCLES
fi
  # A cycle must never be executed by two processes at once. It can happen with
  # no bug anywhere: kill a local runner and its gmx children survive as orphans,
  # then the next start re-queues that cycle (it has no complete result, which is
  # indistinguishable from "dead") and two mdruns write the same -deffnm files,
  # in place, at independent offsets. Nothing downstream can detect the resulting
  # garbage. `mkdir` is atomic on POSIX and on NFS, so it elects one winner the
  # same way the archive step does. The lock records host:pid so a lock left by a
  # killed job can be reclaimed, but ONLY on the same host, where the pid is
  # meaningful -- across hosts we skip the cycle rather than risk a collision.
  CYCLE_LOCK=""
  release_cycle_lock() {
    [[ -n "$CYCLE_LOCK" && -d "$CYCLE_LOCK" ]] && rm -rf "$CYCLE_LOCK"
    CYCLE_LOCK=""
  }
  trap 'release_cycle_lock' EXIT INT TERM

  claim_cycle() {
    local lock=results_fe_c$1.lock
    if mkdir "$lock" 2>/dev/null; then
      echo "$(hostname):$$" > "$lock/owner"
      CYCLE_LOCK="$lock"
      return 0
    fi
    local owner host pid
    owner=$(cat "$lock/owner" 2>/dev/null)
    host=${owner%%:*}; pid=${owner##*:}
    if [[ "$host" == "$(hostname)" && -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      echo "Cycle $1: reclaiming stale lock from dead pid $pid"
      rm -rf "$lock"
      if mkdir "$lock" 2>/dev/null; then
        echo "$(hostname):$$" > "$lock/owner"
        CYCLE_LOCK="$lock"
        return 0
      fi
    fi
    echo "Cycle $1: already running elsewhere (owner ${owner:-unknown}) - skipping."
    return 1
  }

  # Every leg must leave its own .gro. A leg that dies leaves no .gro but it does
  # leave a checkpoint, and the next grompp reads that checkpoint quite happily,
  # which is how a crashed 5 ns hold once produced a full set of works from a
  # state the simulation never reached: eight cycles were recorded as complete
  # with holds of 1946 to 4676 ps. Checking between legs stops a failure from
  # propagating into plausible-looking numbers instead of stopping the cycle.
  require_gro() {
    [[ -f "$1.gro" ]] && return 0
    echo "Cycle $cycle FAILED: leg $1 produced no $1.gro (see $1.log)."
    echo "  Skipping the rest of this cycle. The next run will retry it."
    return 1
  }

  CYCLE_FAILED=0
  cycle=$CYCLE_START
  while [[ $cycle -le $CYCLE_END ]]; do
    if ! claim_cycle $cycle; then
      cycle=$((cycle+1))
      continue
    fi
    echo "=== FE cycle $cycle of $NUMCYCLES ==="

    # Full equilibration for this cycle (NVT 1-5 + NPT)
    if [[ ! -f npt_c${cycle}.gro ]]; then
      echo "Running full equilibration for cycle $cycle"
      if [[ ! -f nvt_1_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_1.mdp -c emin_solv.gro -p topol.top -o nvt_1_c${cycle} -maxwarn 10
      fi
      if [[ ! -f nvt_1_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_1_c${cycle}
      fi
      if [[ ! -f nvt_2_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_2.mdp -c nvt_1_c${cycle}.tpr -t nvt_1_c${cycle}.cpt -p topol.top -o nvt_2_c${cycle} -maxwarn 10
      fi
      if [[ ! -f nvt_2_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_2_c${cycle}
      fi
      if [[ ! -f nvt_3_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_3.mdp -c nvt_2_c${cycle}.tpr -t nvt_2_c${cycle}.cpt -p topol.top -o nvt_3_c${cycle} -maxwarn 10
      fi
      if [[ ! -f nvt_3_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_3_c${cycle}
      fi
      if [[ ! -f nvt_4_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_4.mdp -c nvt_3_c${cycle}.tpr -t nvt_3_c${cycle}.cpt -p topol.top -o nvt_4_c${cycle} -maxwarn 10
      fi
      if [[ ! -f nvt_4_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_4_c${cycle}
      fi
      if [[ ! -f nvt_5_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/nvt_5.mdp -c nvt_4_c${cycle}.tpr -t nvt_4_c${cycle}.cpt -p topol.top -o nvt_5_c${cycle} -n index.ndx -maxwarn 10
      fi
      if [[ ! -f nvt_5_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm nvt_5_c${cycle}
      fi
      # npt_c is the bound-state ensemble boundfwd starts from, and Crooks assumes
      # those initial states are drawn from the true equilibrium distribution, so
      # this leg has to run under a barostat that has one. C-rescale does, and
      # being first order it also settles the box off the NVT ladder without a
      # separate weak-coupling stage.
      if [[ ! -f npt_c${cycle}.tpr ]]; then
        gmx grompp -r emin_solv.gro -f $MDP_DIR/npt_fe.mdp -c nvt_5_c${cycle}.tpr -t nvt_5_c${cycle}.cpt -p topol.top -o npt_c${cycle} -n index.ndx -maxwarn 10
      fi
      if [[ ! -f npt_c${cycle}.gro ]]; then
        timeout -s 9 60m gmx mdrun -nt $nt $GPUOPT -deffnm npt_c${cycle}
      fi
    fi

    require_gro npt_c${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }

    # === Five FE legs, continued from the 1 ns bound equilibration ===
    # Leg 1: bound-state restraint introduction (dhdl only, lambda 0 -> 1)
    if [[ ! -f boundfwd_${cycle}.gro ]]; then
      gmx grompp -r emin_solv.gro -f boundfwd.mdp -c npt_c${cycle}.tpr -t npt_c${cycle}.cpt -p topol.top -o boundfwd_${cycle} -n index.ndx -maxwarn 10
      gmx mdrun -nt $nt $GPUOPT -deffnm boundfwd_${cycle} -dhdl boundfwd_${cycle}_dhdl.xvg
    fi
    require_gro boundfwd_${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }
    # Leg 2: unbinding (interface -> Boresch handoff + separation; pull + dhdl)
    if [[ ! -f bindfwd_${cycle}.gro ]]; then
      gmx grompp -r emin_solv.gro -f bind_fe.mdp -c boundfwd_${cycle}.tpr -t boundfwd_${cycle}.cpt -p topol.top -o bindfwd_${cycle} -n index.ndx -maxwarn 10
      gmx mdrun -nt $nt $GPUOPT -deffnm bindfwd_${cycle} -pf bindfwd_${cycle}_pullf.xvg -dhdl bindfwd_${cycle}_dhdl.xvg
    fi
    require_gro bindfwd_${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }
    # Hold the unbound, Boresch-restrained state
    if [[ ! -f nptrev_${cycle}.gro ]]; then
      gmx grompp -r emin_solv.gro -f nptrev_fe.mdp -c bindfwd_${cycle}.tpr -t bindfwd_${cycle}.cpt -p topol.top -o nptrev_${cycle} -n index.ndx -maxwarn 10
      gmx mdrun -nt $nt $GPUOPT -deffnm nptrev_${cycle}
    fi
    require_gro nptrev_${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }
    # Leg 3: rebinding (reverse of unbinding; pull + dhdl)
    if [[ ! -f bindrev_${cycle}.gro ]]; then
      gmx grompp -r emin_solv.gro -f bindrev_fe.mdp -c nptrev_${cycle}.tpr -t nptrev_${cycle}.cpt -p topol.top -o bindrev_${cycle} -n index.ndx -maxwarn 10
      gmx mdrun -nt $nt $GPUOPT -deffnm bindrev_${cycle} -pf bindrev_${cycle}_pullf.xvg -dhdl bindrev_${cycle}_dhdl.xvg
    fi
    require_gro bindrev_${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }
    # Leg 4: bound-state restraint removal (dhdl only, lambda 1 -> 0)
    if [[ ! -f boundrev_${cycle}.gro ]]; then
      gmx grompp -r emin_solv.gro -f boundrev.mdp -c bindrev_${cycle}.tpr -t bindrev_${cycle}.cpt -p topol.top -o boundrev_${cycle} -n index.ndx -maxwarn 10
      gmx mdrun -nt $nt $GPUOPT -deffnm boundrev_${cycle} -dhdl boundrev_${cycle}_dhdl.xvg
    fi
    require_gro boundrev_${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }

    # --- Work integration: one results_fe.gs line per completed cycle ---
    # Columns: STRUCT_ID cycle W_intro Wunbind_pull Wunbind_dhdl Wrebind_pull Wrebind_dhdl W_remove RMSD_A
    # (works in kJ/mol; groscore_fe.py combines them via the thermodynamic cycle.
    #  RMSD_A is the rebinding sanity check, in Angstrom -- see below.)
    # Recompute whenever this cycle's result file is missing or still holds NaN --
    # not merely when the cycle is new. Two cases the .done marker alone misses:
    #   * a cycle finished by an earlier run has its values only in the legacy
    #     results_fe.gs, so results_fe.d/ would stay empty for it;
    #   * a cycle whose legs failed wrote NaNs and marked itself done, so the
    #     values were never repaired after the legs were re-run.
    # Integration is cheap (the .xvg.gz are kept), so this backfills in seconds.
    RESFILE=../results_fe.d/${STRUCT_ID}_c${cycle}.gs
    # A stored result counts as final only if it is a complete 9-field line whose
    # six work values are numeric; anything else (missing, truncated by a failed
    # integration, NaN from a leg that had not finished, or an 8-field line from
    # before the RMSD column existed) is recomputed. Only fields 3-8 are checked
    # for NaN: a cycle whose RMSD could not be computed is still a valid result
    # and must not be re-integrated on every restart.
    NEEDS_RESULT=1
    if [[ -f $RESFILE ]] && awk 'NR==1 && NF>=9{ok=1; for(i=3;i<=8;i++) if($i=="NaN"||$i=="nan") ok=0} END{exit !ok}' $RESFILE; then
      NEEDS_RESULT=0
    fi
    if [[ $NEEDS_RESULT -eq 1 ]]; then
      for w in boundfwd_${cycle}_dhdl bindfwd_${cycle}_pullf bindfwd_${cycle}_dhdl \
               bindrev_${cycle}_pullf bindrev_${cycle}_dhdl boundrev_${cycle}_dhdl; do
        [[ ! -f ${w}.xvg && -f ${w}.xvg.gz ]] && gunzip ${w}.xvg.gz
      done
      # Never let a failed integration (crash, missing module, empty output) turn
      # a field into an empty string: that silently writes a short line which no
      # NaN check would ever flag for repair. Fall back to NaN so the row stays
      # 8 fields wide and is retried on the next run.
      integrate_or_nan() {
        local out
        out=$("$@" 2>/dev/null) || out=""
        [[ -z "$out" ]] && out="NaN"
        printf '%s' "$out"
      }
      W_intro="NaN"; Wu_pull="NaN"; Wu_dhdl="NaN"; Wr_pull="NaN"; Wr_dhdl="NaN"; W_remove="NaN"
      [[ -f boundfwd_${cycle}_dhdl.xvg ]] && W_intro=$(integrate_or_nan python3 ../../utils/integrate_dhdl.py -f boundfwd_${cycle}_dhdl.xvg --direction fwd)
      [[ -f bindfwd_${cycle}_pullf.xvg ]] && Wu_pull=$(integrate_or_nan python3 ../../utils/integrate.py -f bindfwd_${cycle}_pullf.xvg -nr $NUMPERTRES -r $PULL_RATE)
      [[ -f bindfwd_${cycle}_dhdl.xvg ]]  && Wu_dhdl=$(integrate_or_nan python3 ../../utils/integrate_dhdl.py -f bindfwd_${cycle}_dhdl.xvg --direction fwd)
      [[ -f bindrev_${cycle}_pullf.xvg ]] && Wr_pull=$(integrate_or_nan python3 ../../utils/integrate.py -f bindrev_${cycle}_pullf.xvg -nr $NUMPERTRES -r $PULL_RATE)
      [[ -f bindrev_${cycle}_dhdl.xvg ]]  && Wr_dhdl=$(integrate_or_nan python3 ../../utils/integrate_dhdl.py -f bindrev_${cycle}_dhdl.xvg --direction rev)
      [[ -f boundrev_${cycle}_dhdl.xvg ]] && W_remove=$(integrate_or_nan python3 ../../utils/integrate_dhdl.py -f boundrev_${cycle}_dhdl.xvg --direction rev)
      # Rebinding sanity check: backbone RMSD (Angstrom) between the bound state
      # this cycle was equilibrated in (npt_c$cycle) and the end of the rebinding
      # leg (bindrev_$cycle). A large value means the partners did not return to
      # the original pose, so the thermodynamic cycle did not close on the state
      # it started from. Always computed, never fatal -- groscore_fe.py flags it
      # (see --rmsd-warn).
      RMSD="NaN"
      if [[ -f npt_c${cycle}.gro && -f bindrev_${cycle}.gro ]]; then
        RMSD=$(integrate_or_nan python3 ../../utils/rebound_rmsd.py \
                 --ref npt_c${cycle}.gro --query bindrev_${cycle}.gro \
                 -s emin_solv.tpr -n index.ndx --tag c${cycle})
        echo "Cycle $cycle rebound backbone RMSD: $RMSD A"
      fi
      # One file per cycle rather than appending to a shared results_fe.gs: with
      # cycles running as parallel array tasks, many writers would race on the
      # same file. groscore_fe.py merges results_fe.d/ with any legacy file.
      mkdir -p ../results_fe.d
      echo "$STRUCT_ID $cycle $W_intro $Wu_pull $Wu_dhdl $Wr_pull $Wr_dhdl $W_remove $RMSD" \
        > $RESFILE
      gzip -f boundfwd_${cycle}_dhdl.xvg bindfwd_${cycle}_pullf.xvg bindfwd_${cycle}_dhdl.xvg \
              bindrev_${cycle}_pullf.xvg bindrev_${cycle}_dhdl.xvg boundrev_${cycle}_dhdl.xvg 2>/dev/null
      # Written last and ONLY for a complete cycle, so .done really does mean
      # "fully finished" -- the archive check below counts these, and a structure
      # that tarred itself up on the strength of half-finished cycles would be
      # unrecoverable. A cycle whose legs died partway writes its NaN row (so the
      # next run repairs it rather than re-simulating from scratch) but no marker,
      # and reports failure so the runner shows it instead of logging "done".
      if awk 'NR==1 && NF>=9{ok=1; for(i=3;i<=8;i++) if($i=="NaN"||$i=="nan") ok=0} END{exit !ok}' $RESFILE; then
        touch results_fe_c${cycle}.done
      else
        echo "Cycle $cycle FAILED: not all six works are numeric, no .done written:"
        echo "  $(cat $RESFILE)"
        CYCLE_FAILED=1
      fi
    fi

    release_cycle_lock
    cycle=$((cycle+1))
  done

  # Report a partial cycle as a failure. Deferred to the end of the loop so that
  # legacy sequential mode still attempts every cycle rather than stopping at the
  # first bad one; in --cycle mode there is only one, so it is immediate.
  if [[ $CYCLE_FAILED -eq 1 ]]; then
    echo "At least one cycle finished without a complete result."
  fi

  # Archive completed structure to reduce inode count.
  # Only when EVERY cycle has finished -- with cycles running as parallel array
  # tasks, whichever task finishes last does the archiving. `mkdir` is atomic, so
  # it elects a single winner even if several tasks finish simultaneously (two
  # tasks tarring/deleting the same directory would be destructive).
  # Guard the rm behind a successful, non-empty tar so a killed/broken archive
  # can never delete the source directory (a 0-byte tar once wiped a structure).
  DONE_CYCLES=$(ls -1 results_fe_c*.done 2>/dev/null | wc -l)
  if [[ $DONE_CYCLES -ge $NUMCYCLES ]] && mkdir .archive.lock 2>/dev/null; then
    # Last chance to lift the analytical term out of the structure directory:
    # once this is a tarball, boresch_analytical.gs is unreachable to the scorer
    # and the structure would score PENDING forever despite having every cycle.
    if [[ -f boresch_analytical.gs ]]; then
      DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
      mkdir -p ../results_analytical.d
      echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
    fi
    cd ..
    if tar -czf "${STRUCT_ID}.tar.gz" "${STRUCT_ID}/" && [[ -s "${STRUCT_ID}.tar.gz" ]]; then
      rm -rf "${STRUCT_ID}/"
    else
      echo "Archive failed or empty for ${STRUCT_ID}; keeping directory."
      rm -f "${STRUCT_ID}.tar.gz"
      rmdir "${STRUCT_ID}/.archive.lock" 2>/dev/null
    fi
  fi
else
  echo $STRUCT_ID "BROKEN" >> ../results_0.gs
fi

# Propagate a partial cycle to the exit status. Without this a cycle whose second
# half died still exited 0, the runner logged it "done", and the only symptom was
# Ncycles quietly lagging the done count.
exit ${CYCLE_FAILED:-0}

#!/bin/bash
#

nt=${GROSCORE_NT:-${SLURM_CPUS_PER_TASK:-${SLURM_NTASKS:-4}}}

# Local multi-GPU mode (groscore_fe.py --run-local): utils/local_runner.py runs
# many cycles side by side on one workstation and pins each of them to a single
# GPU. Under SLURM the variable is unset, mdrun keeps its default device choice
# and the scheduler's GPU allocation applies. -pin off because several jobs share
# the node here, so mdrun must not claim a fixed set of cores for itself.
GPUOPT=""
if [[ -n "${GROSCORE_GPU_ID:-}" ]]; then
  GPUOPT="-gpu_id $GROSCORE_GPU_ID -pin off"
fi

# Execution mode (groscore_fe.py submits setup and cycles as separate SLURM jobs so
# the embarrassingly-parallel cycles can run as an array):
#   --setup      run the shared setup only (stage 0 + the probe replicas +
#                make_boresch, which defines the elastic network / restraints),
#                then write setup.done and exit.
#   --cycle N    wait for setup.done, then run ONLY cycle N. Safe to run many of
#                these concurrently: every cycle starts fresh from emin_solv.gro
#                with new velocities and writes only cycle-suffixed files.
#   (no args)    legacy: setup followed by all cycles sequentially in one job.
MODE="all"
CYCLE_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --setup) MODE="setup"; shift ;;
    --cycle)
      # Validate before shifting: `shift 2` with only one argument left fails
      # without consuming it, which would spin this loop forever.
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "--cycle requires a cycle number"; exit 1
      fi
      MODE="cycle"; CYCLE_ARG="$2"; shift 2 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done
if [[ "$MODE" == "cycle" && ! "$CYCLE_ARG" =~ ^[0-9]+$ ]]; then
  echo "--cycle requires a positive integer (got '$CYCLE_ARG')"; exit 1
fi

# proc_start PID: the start time of process PID (clock ticks after boot, field 22 of
# /proc/PID/stat), or nothing when it does not exist. A pid is reused; a pid and its
# start time are not.
proc_start() {
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*) }
  set -- $s
  echo "${20}"
}

# lock_put DIR OWNER: create the lock directory DIR holding the owner line OWNER, in
# one step. It is built under a private name and renamed into place: rename(2) onto
# an existing lock fails, a lock never being empty, so one process wins, as with
# mkdir, and no process ever finds a lock without its owner line.
lock_put() {
  local tmp="$1.new.$BASHPID"
  rm -rf "$tmp"
  if mkdir "$tmp" 2>/dev/null && echo "$2" > "$tmp/owner" && mv -T "$tmp" "$1" 2>/dev/null; then
    return 0
  fi
  rm -rf "$tmp"
  return 1
}

# leg_alive DIR: the leg recorded in the lock DIR (DIR/leg, 'pid start', run_bg) is
# still running on this host.
leg_alive() {
  local lpid lstart
  [[ -f "$1/leg" ]] && read -r lpid lstart 2>/dev/null < "$1/leg" || return 1
  [[ -n "$lpid" && -n "$lstart" && "$(proc_start "$lpid")" == "$lstart" ]]
}

# take_lock DIR: claim the directory DIR as a lock held by this process. Returns 0
# with DIR/owner holding host:pid:slurm_job, or 1 when a live owner holds it, whose
# owner line is then in LOCK_OWNER. lock_put elects one winner atomically, on POSIX
# and on NFS. A lock left by a killed job is reclaimed, but only where its death can
# be shown. On the same host the pid means something, so the kernel is asked. On
# another host the pid is meaningless, but a SLURM job id is not: a lock is only
# released by the EXIT trap, and SIGKILL (`timeout -s 9`, SLURM's walltime kill) runs
# no trap, so without a cross-host test a job hard-killed on another node would hold
# its lock forever, every later run would skip it, and --restart would quietly do
# nothing for it. An owner on another host with no job id cannot be shown dead, so it
# is skipped rather than risked, and the message says to remove the lock by hand.
#
# squeue must ANSWER: the job counts as gone only when squeue lists nothing for it,
# lists it in a finished state, or says its id is unknown ('Invalid job id
# specified', once slurmctld has forgotten it). Any other failure (a controller
# timeout, no route to it) keeps the lock. Through the first v1.5 round every
# non-zero exit counted as proof of death, so under controller load a second job took
# the lock of a live one, even of a live pid on this host (review S1).
#
# A stale lock is reclaimed by one process at a time, under the mutex LOCK.reclaim
# (mkdir). Under it the owner is read again, and only a lock that still names the
# dead owner is renamed aside, checked to be that owner's, removed and re-created.
# Reclaimed by rm and mkdir, two processes reading the same dead owner both got the
# lock (7 of 300 trials; review S2). Renamed aside without the mutex, a reclaimer that
# judged the owner dead before another one retook the lock moved that lock aside, a
# third start took the empty path, and the put-back failed in silence: two holders,
# the first one's lock stranded at LOCK.stale.<pid> (review V3). A lock that cannot
# be put back is an error now, and nothing is left moved aside. A reclaim takes
# milliseconds, so a mutex older than 60 s by the file system's own clock was left by
# a reclaimer that died, and is removed.
# A dead owner whose leg still runs on this host keeps its lock (see run_bg).
# (The same functions as job.run's.)
take_lock() {
  local lock=$1 owner host pid job out rc dead="" stale me cur probe now made
  me="$(hostname):$$:${SLURM_JOB_ID:--}"
  LOCK_OWNER=""
  lock_put "$lock" "$me" && return 0
  owner=$(cat "$lock/owner" 2>/dev/null)
  IFS=: read -r host pid job <<< "$owner"
  if [[ "$host" == "$(hostname)" && -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
    dead="dead pid $pid"
  elif [[ -n "$job" && "$job" != "-" ]] && command -v squeue >/dev/null 2>&1; then
    out=$(squeue -h -j "$job" -o %T 2>&1); rc=$?
    if [[ $rc -eq 0 && -z "${out//[[:space:]]/}" ]] || [[ "$out" == *"Invalid job id"* ]] \
       || [[ $rc -eq 0 && "$out" =~ ^[[:space:]]*(BOOT_FAIL|CANCELLED|COMPLETED|DEADLINE|FAILED|NODE_FAIL|OUT_OF_MEMORY|PREEMPTED|TIMEOUT)[[:space:]]*$ ]]; then
      dead="SLURM job $job, no longer queued"
    elif [[ $rc -ne 0 ]]; then
      echo "$lock: squeue could not say whether SLURM job $job still runs (${out//$'\n'/ }); the lock is kept."
    fi
  fi
  if [[ -n "$dead" && "$host" == "$(hostname)" ]] && leg_alive "$lock"; then
    echo "$lock: its owner is gone ($dead), but the leg it started still runs; the lock is kept."
    dead=""
  fi
  if [[ -n "$dead" ]] && ! mkdir "$lock.reclaim" 2>/dev/null; then
    probe="$lock.reclaim.now.$BASHPID"
    : > "$probe" 2>/dev/null
    now=$(stat -c %Y "$probe" 2>/dev/null)
    rm -f "$probe"
    made=$(stat -c %Y "$lock.reclaim" 2>/dev/null)
    if [[ -n "$now" && -n "$made" ]] && (( now - made > 60 )); then
      rm -rf "$lock.reclaim"
      mkdir "$lock.reclaim" 2>/dev/null || dead=""
    else
      dead=""
    fi
  fi
  if [[ -n "$dead" ]]; then
    cur=$(cat "$lock/owner" 2>/dev/null)
    stale="$lock.stale.$BASHPID"
    rm -rf "$stale"
    if [[ "$cur" == "$owner" ]] && mv -T "$lock" "$stale" 2>/dev/null; then
      cur=$(cat "$stale/owner" 2>/dev/null)
      if [[ "$cur" == "$owner" ]]; then
        echo "$lock: reclaiming stale lock from $dead"
        rm -rf "$stale"
        if lock_put "$lock" "$me"; then
          rm -rf "$lock.reclaim"
          return 0
        fi
      elif ! mv -T "$stale" "$lock" 2>/dev/null; then
        echo "$lock: ERROR: the lock of $cur was moved aside while reclaiming it and could not be put back," \
             "as another process took $lock meanwhile; two jobs may now run here."
        rm -rf "$stale"
      fi
      cur=$(cat "$lock/owner" 2>/dev/null)
    fi
    rm -rf "$lock.reclaim"
    owner=${cur:-$owner}
  fi
  LOCK_OWNER=${owner:-unknown}
  return 1
}

# THE RUNNING LEG IS PART OF THE LOCK. Every mdrun runs as a background job of this
# script (run_bg) with its pid and start time in each lock this job holds (leg), and
# INT and TERM pass a TERM on to it and wait until it has stopped (stop_leg). mdrun
# runs under GNU timeout, which gives it a process group of its own, so a job killed
# hard left its mdrun running, and the next start reclaimed the lock from the dead
# pid and ran the same leg beside it: two mdruns on one -deffnm. And a TERM
# (scancel, the walltime, the local runner's shutdown) took effect only once the
# running leg had ended (review S3). mdrun stops on TERM at its next
# neighbour-search step; the next start runs that leg again from step 0
# (run_leg_mdrun).
LEG_PID=""
run_bg() {
  local d rc
  "$@" &
  LEG_PID=$!
  for d in "${JOB_LOCK:-}" "${CYCLE_LOCK:-}"; do
    [[ -n "$d" && -d "$d" ]] && echo "$LEG_PID $(proc_start $LEG_PID)" > "$d/leg"
  done
  wait "$LEG_PID"
  rc=$?
  for d in "${JOB_LOCK:-}" "${CYCLE_LOCK:-}"; do
    [[ -n "$d" ]] && rm -f "$d/leg"
  done
  LEG_PID=""
  return $rc
}
stop_leg() {
  [[ -n "$LEG_PID" ]] || return 0
  kill -TERM "$LEG_PID" 2>/dev/null
  wait "$LEG_PID" 2>/dev/null
}

# ONE SETUP-OR-LEGACY JOB PER DIRECTORY. The setup phase, and in legacy mode the
# whole job, writes files a second copy of itself would write too: a re-submission,
# a duplicate setup job, or a job.run left running by a killed local runner. That
# used to be guessed from file times, exiting 0 when more than two files had changed
# within 70 minutes, which counted the files the submitter itself writes. Under
# --run-local --sequential a fresh directory holds input.pdb plus run.gs and job.run
# from groscore_fe.py and job_local.out, which local_runner.py opens before it starts
# this script: three recent files, so the job exited at once and the runner logged a
# structure that had done nothing as 'done (exit 0)' (audit of 2026-10-04; that
# start runs through the real local runner in tests/test_fe_runner_guards.py). The
# lock asks the question directly. --cycle tasks do not take it: they wait for
# setup.done, and each one holds its own cycle lock (claim_cycle below).
# The path is absolute because the archive step leaves this directory before the
# job exits; the archive itself leaves the lock out.
#
# INT and TERM release the lock AND EXIT. A trap on TERM that does not exit makes
# bash survive the signal: it runs the handler once the running command ends, then
# goes on with the next one and finally exits 0. Measured with a 3 s command and a
# TERM after 1 s: without a trap bash exits 143 at once; with a non-exiting trap it
# ran every remaining step and exited 0. SLURM sends TERM before KILL at the walltime
# and on scancel, and the local runner sends it on shutdown, so a job that went on
# would write statuses for work it never did and report success. The running leg is
# stopped first, and the lock released only once it has (stop_leg, run_bg).
JOB_LOCK=""
release_job_lock() {
  [[ -n "$JOB_LOCK" && -d "$JOB_LOCK" ]] && rm -rf "$JOB_LOCK"
  JOB_LOCK=""
}
if [[ "$MODE" != "cycle" ]]; then
  if take_lock "$PWD/job_run.lock"; then
    JOB_LOCK="$PWD/job_run.lock"
    trap 'release_job_lock' EXIT
    trap 'stop_leg; release_job_lock; exit 130' INT
    trap 'stop_leg; release_job_lock; exit 143' TERM
  else
    # Non-zero, so neither SLURM nor the local runner reports this job as done.
    echo "Safety check: another job.run (owner $LOCK_OWNER) holds job_run.lock in this"
    echo "  directory, so this one exits without touching anything. If that job is gone"
    echo "  and squeue cannot say so, remove job_run.lock by hand and resubmit."
    exit 1
  fi
fi

export GMX_MAXBACKUP=-1

# COM-COM separation added during unbinding, in nm. Used twice: it sets the box
# padding floor (the envelope grows by up to this much once protein B is pulled
# away) and it is passed to make_boresch.py. It is tied to the pull rate by
# rate * unbinding_time = PULL_DIST, so changing it means changing the rate and
# the leg length together. PULL_RATE is deliberately NOT set here: the cycle
# phase reads it back from boresch_analytical.gs so re-integrated cycles use the
# rate they were actually run at.
PULL_DIST=1.0

# A results_fe.d row is  STRUCT_ID cycle <one field per work> RMSD, and which
# works exist depends on how many stages the ramp has. FE_RESULT_NF is that width.
# It is named because the completeness gate and the writer must agree on it: a
# gate that checks fewer fields than the writer emits marks a cycle done on works
# it never looked at, and that cycle is then dropped by groscore_fe.py and lost
# when the structure archives. The writer asserts its own row against it, and both
# now come from the same place, so they cannot drift apart at all.
#
# Sourced rather than written out: FE_PROTOCOL_ID, FE_RESULT_NF, FE_LEGS,
# FE_LEG_MDP, FE_LEG_PULL, FE_LEG_DHDL, FE_LEG_FROM, FE_LEG_MDPS, FE_WORKS and
# FE_WORK_FIELDS all come from utils/fe_protocol.py, which is the single definition
# of the cycle. The runner therefore cannot disagree with the mdps that were
# generated from it.
FE_PROTO=$(python3 "$(dirname "$0")/utils/fe_protocol.py" --shell 2>/dev/null) \
  || FE_PROTO=$(python3 ../../utils/fe_protocol.py --shell 2>/dev/null)
if [[ -z "$FE_PROTO" ]]; then
  echo "FATAL: could not read the FE protocol from utils/fe_protocol.py" >&2
  exit 1
fi
# The runner and the protocol are paired in both directions. The export's first
# line exits unless this variable says the runner honours FE_LEG_FROM: a job.run
# from before v1.5 does not set it, and evaluating this protocol it would run every
# leg as a plain chain, boundrev2 straight after bindrevA (review CYC-2). Not
# exported, so nothing this script starts inherits it.
FE_RUNNER_HONOURS_START_FROM=1
eval "$FE_PROTO"
# The other direction: this runner refuses a protocol from before v1.5. That
# protocol is consistent in itself, a plain chain through holdrev0, but it is not
# the one this runner sets up and checks: it exports no FE_LEG_FROM and no
# FE_PROTOCOL_ID, the settings generated from it have no npt_c_fe.mdp, and the v1.5
# settings have no holdrev0_fe.mdp for it to run.
if [[ ${#FE_LEG_FROM[@]} -ne ${#FE_LEGS[@]} ]]; then
  echo "FATAL: utils/fe_protocol.py gives ${#FE_LEG_FROM[@]} leg starts (FE_LEG_FROM) for" >&2
  echo "       ${#FE_LEGS[@]} legs; this job_fe.run needs the protocol of v1.5 or later." >&2
  exit 1
fi
if [[ -z "${FE_PROTOCOL_ID:-}" ]]; then
  echo "FATAL: utils/fe_protocol.py names no protocol (FE_PROTOCOL_ID); this job_fe.run" >&2
  echo "       records it in protocol_id.gs and runs no cycle without it." >&2
  exit 1
fi

# Every xvg the cycle's legs write, without the .xvg suffix. Used to gunzip them
# back on a restart and to gzip them again afterwards; derived so that adding a
# stage cannot leave its traces uncompressed or, worse, un-restorable.
#
# A leg without a dhdl channel still writes dH/dlambda: every leg mdp runs
# free-energy = yes (make_fe_mdps.py), and with no -dhdl option mdrun -deffnm puts
# it in <leg>_<cycle>.xvg. Those are the holds and nptrev (the integrator's 2KTF run
# wrote holdfwd0_1.xvg, holdbfwd1_1.xvg and nptrev_1.xvg). No work comes from them,
# but they are what a hold length is measured from (fe_protocol.py, HOLD LENGTHS),
# so they are kept and compressed like the rest.
fe_xvgs() {
  local i
  for i in "${!FE_LEGS[@]}"; do
    [[ "${FE_LEG_PULL[$i]}" == "1" ]] && echo "${FE_LEGS[$i]}_${cycle}_pullf"
    if [[ "${FE_LEG_DHDL[$i]}" == "1" ]]; then
      echo "${FE_LEGS[$i]}_${cycle}_dhdl"
    else
      echo "${FE_LEGS[$i]}_${cycle}"
    fi
  done
}

# WHY A LEG IS RETRIED IN PLACE. On VSC5 the dominant failure is not the
# protocol and not a timeout, it is the hardware: over test13/14/15, 10 of 149
# cycles died, 5 to CUDA "illegal memory access", 3 to a segfault in mdrun and 2
# to a SLURM node failure. At ~7% per cycle the chance that all 50 cycles of a
# submission survive is about 3%, which is why a run has never finished without
# a --restart. No leg is anywhere near its timeout: the longest switching leg
# measured 20.4 min against 60, and npt_c 76.8 against 600.
#
# A transient fault is not a property of the system being simulated, so the same
# leg started again usually completes. Abandoning the whole cycle and waiting for
# a human to resubmit costs a day per fault and, worse, loses the cycle entirely
# if nobody does. Retrying here costs one leg.
#
# AN UNFINISHED RUN IS NEVER CONTINUED. Every attempt starts from step 0 of the
# leg's tpr, never from the leg's own checkpoint, and a checkpoint is read only as
# the start of the NEXT leg, once this one has written its .gro. A run that died part
# way, to a node failure, a full disk, a kill or the timeout, leaves outputs nothing
# can vouch for: on 2026-10-13 a full /gpfs dropped whole blocks of xvg output while
# mdrun carried on, and a resumed leg would append to such a file. A retry costs one
# leg from the start, at most a whole npt_c. GMX_MAXBACKUP=-1 (above) lets the new
# run overwrite what the dead one wrote. Without a tpr (its grompp failed) the leg is
# not started at all: mdrun used to fail twice on the missing file, as 1DFJ c7 did.
#
# Deliberately bounded: a leg that fails for a REAL reason (an exploding system,
# a bad restraint) fails identically every time, and retrying it forever would
# turn a fast failure into a silent stall. Two attempts by default;
# GROSCORE_LEG_RETRIES overrides.
#
# TOP LEVEL, NOT INSIDE THE CYCLE SECTION, because the probe replicas in Stage 0
# need it as much as the legs do. On the 46-structure HADDOCK pass of 2026-09-09
# the blow-up rate under AMBER19SB/OPC3 at 4 fs was 4.4 per us across every leg
# type (0.5 to 14 per us by structure); the cycle legs shrugged it off through
# this function (202 retries, 166 rescued), while the probe ran five 20 ns
# replicas with no retry and lost the whole structure whenever ONE of them died:
# 20 of the 22 PROBE_FAILs, 1 - exp(-4.4 x 0.1) = 36% expected, 48% observed.
run_leg_mdrun() {
  local out="$1" tmo="$2"; shift 2
  local tries=${GROSCORE_LEG_RETRIES:-2}
  local i=1
  if [[ ! -f "${out}.tpr" ]]; then
    echo "  leg $out has no ${out}.tpr (its grompp failed, see above); not started."
    return 1
  fi
  while [[ $i -le $tries ]]; do
    run_bg timeout -s 9 "$tmo" gmx mdrun -nt $nt $GPUOPT -deffnm "$out" "$@"
    [[ -f "${out}.gro" ]] && return 0
    if [[ $i -lt $tries ]]; then
      echo "  leg $out did not finish (attempt $i of $tries); retrying from step 0."
    fi
    i=$((i+1))
  done
  return 1
}

# Get structure ID from current directory name
STRUCT_ID=$(basename $(pwd))

# A SETUP NEVER CERTIFIES CYCLES IT DID NOT START. protocol_id.gs, written when a
# setup completes, is what lets a cycle run (see the cycle phase), so a setup run
# again in a directory that already holds cycles would vouch for cycles begun under
# another setup. That is what happened to a pre-v1.5 directory whose setup.done was
# removed: the setup rebuilt only the restraints, on the old probe, box and ligands,
# and the unfinished v1.4 cycles went on from their old checkpoints into v1.5 legs,
# writing rows nothing could tell from v1.5 ones (review CYC-1, reproduced with this
# runner and a fake gmx that records where every checkpoint came from). So where
# cycles exist, the setup runs again only if it completed under this very protocol
# and its solvated system is still there. It then rebuilds the same restraints,
# since make_boresch.py has no random input; groscore_fe.py's setup_is_complete()
# creates that case when it clears setup.done over a missing restraint file.
# Every cycle starts with the grompp of nvt_1_c<N>, and npt_c<N>.* and the .done
# markers outlive any later cleanup.
cycles_started() {
  compgen -G 'nvt_1_c[0-9]*.tpr' >/dev/null || compgen -G 'npt_c[0-9]*.*' >/dev/null \
    || compgen -G 'results_fe_c[0-9]*.done' >/dev/null
}
if [[ "$MODE" != "cycle" && ! -f setup.done ]] && cycles_started; then
  SETUP_ID=$(head -n 1 protocol_id.gs 2>/dev/null | tr -d '[:space:]')
  WHY=""
  if [[ "$SETUP_ID" != "$FE_PROTOCOL_ID" ]]; then
    WHY="no setup under protocol $FE_PROTOCOL_ID started them (protocol_id.gs: ${SETUP_ID:-absent})"
  elif [[ ! -f emin_solv.gro ]]; then
    WHY="emin_solv.gro is gone, so the setup would rebuild the system they run in"
  fi
  if [[ -n "$WHY" ]]; then
    echo "Stage 0 refused: this directory already holds FE cycles (nvt_1_c*, npt_c* or"
    echo "  results_fe_c*.done), and $WHY."
    echo "  A setup here would rebuild what those cycles were started on. Set this"
    echo "  structure up again in a fresh directory."
    echo $STRUCT_ID "SETUP_FAIL" >> ../results_0.gs
    exit 0
  fi
fi

# Restart recovery: detect and clean up stale intermediate files from failed runs.
# If conf.gro exists but emin_solv.gro doesn't, a previous setup attempt failed
# partway through. Clean up ALL setup files and start from scratch to avoid
# stale topology/coordinate mismatches: when the topology is incomplete (no
# emin_vac.gro) or the production box was begun (box.gro), whose solvation rewrites
# topol.top in place. NOT when it stopped in the probe pass in between: the probe
# solvates a copy of the topology, its steps are guarded on their own outputs, and
# a re-run resumes it from the finished replicas and stages, running the one that
# died again from step 0, as its PROBE_FAIL messages say. The recovery used to fire
# there too and threw away up to five 20 ns replicas (review S4).
if [[ "$MODE" != "cycle" && -f conf.gro && ! -f emin_solv.gro ]] \
   && [[ ! -f emin_vac.gro || -f box.gro ]]; then
  echo "Restart recovery: setup incomplete (conf.gro exists but emin_solv.gro missing)"
  echo "Cleaning all setup files for fresh re-run..."
  rm -f renumbered.pdb chain_map.gs ion_residues.gs ligand_info.gs ligand_residues.gs
  rm -f ncaa_residues.gs ncaa_failed.gs residuetypes.dat
  # The glycan fusion's files describe the attempt being discarded too.
  rm -f fused.pdb glycans.json glycan_unfused.gs glycan_failed.gs
  rm -f fixed.pdb fixed_capped.pdb cutout.pdb cutout_capped.pdb
  rm -f conf.gro conf_cutout.gro conf_vacbox.gro topol.top topol_*.itp posre*.itp
  rm -f emin_vac.tpr emin_vac.gro emin_vac.edr emin_vac.log emin_vac.trr
  rm -f box.gro box_solv.gro ions.tpr solv_ions.gro
  rm -f emin_solv_sd.tpr emin_solv_sd.gro emin_solv_sd.edr emin_solv_sd.log emin_solv_sd.trr
  rm -f emin_solv.tpr emin_solv.edr emin_solv.log emin_solv.trr
  rm -f index.ndx numpertres.gs numpertres.tmp bind.mdp nptrev.mdp bindrev.mdp
  rm -f boresch_failed.gs boresch_analytical.gs boresch_anchors.gs
  # Probe pass: the small-box system the production box size is measured from.
  # boxpad.gs goes with it, since a padding measured against a discarded solute
  # must not be reused after the topology is re-derived.
  rm -f topol_probe.top box_probe.gro box_solv_probe.gro ions_probe.tpr
  rm -f solv_ions_probe.gro emin_probe*.* index_probe.ndx nvt_?_probe.*
  # npt_probe_* as well as npt_probe.*: the clustered reference the restraints
  # are measured from is derived from the probe run and is guarded on its own
  # existence, so a stale one would be reused against a re-derived topology.
  # `npt_probe.*` does not match `npt_probe_cluster.gro`.
  rm -f npt_probe.* npt_probe_* npt_probe[0-9]* nvt_[1-5]_probe[0-9]* \
        boxpad.gs boxpad.tmp boxpad_used.gs
  # ligand_failed.gs as well: it describes the attempt being discarded, and a stale
  # line would report LIGAND_FAIL for a ligand the fresh attempt builds correctly.
  # The extracted ligand_*.pdb too, which renumber_pdb.py never deletes: the NAG file
  # of an attempt that did not fuse its glycan would be parametrised and judged again.
  rm -f ligand_*.itp ligand_*.gro ligand_*.sdf ligand_*.pdb ligand_manifest.gs ligand_failed.gs
  # And the completion record of whatever setup this was: everything it vouched for
  # is being deleted, and the setup starting now writes both again when it completes.
  rm -f setup.done protocol_id.gs
  # The work directory of an AM1-BCC attempt killed with its parametrisation.
  rm -rf amber19sb.ff am1bcc_*
fi

# WHICH CODE IS THIS. The scripts live in the checkout two levels up, and a run
# directory is routinely carried between machines while the checkout beside it is
# not. When they disagree there is nothing in any log to say so: test13 was
# re-submitted against a fix that had been committed but not pulled on the cluster,
# re-ran the old make_boresch, and failed identically, which read as "the fix did
# not work" rather than "the fix is not here". One line makes that visible.
# This file is COPIED into each structure directory as job.run, so its own path
# says nothing about which checkout it came from; ask git for the work tree root
# instead. And ignore untracked files when deciding "dirty": a run directory is
# full of untracked output by construction, so counting it made every job report
# a modified checkout.
GROSCORE_SRC=$(git rev-parse --show-toplevel 2>/dev/null || echo "unknown")
GROSCORE_REV=$(git rev-parse --short HEAD 2>/dev/null || echo "not-a-git-checkout")
if [[ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
  GROSCORE_REV="$GROSCORE_REV-dirty"
fi
echo "GroScore-FE code: $GROSCORE_SRC @ $GROSCORE_REV"
echo "FE protocol: $FE_PROTOCOL_ID"

# Announce a fresh setup attempt before doing anything that could fail. This is
# what lets a cycle task tell "this directory failed" from "this directory failed
# once and is being redone": without it the newest line for the structure is still
# the previous attempt's failure for as long as the new setup takes to reach its
# first status write, and the array released alongside it exits on that. A
# directory whose setup is complete gets no attempt (below), so no announcement.
if [[ "$MODE" != "cycle" && ! -f setup.done ]]; then
  echo $STRUCT_ID "SETUP_RUNNING" >> ../results_0.gs
fi
MAXRUNS=0
CUTOUT=1
FORCEFIELD="charmm36"
LIGAND_PARAM=1
while read -r a b c d e
do
  PROTBCHAINS=$a
  MAXRUNS=$b
  if [[ -n "$c" ]]; then
    CUTOUT=$c
  fi
  if [[ -n "$d" ]]; then
    FORCEFIELD=$d
  fi
  if [[ -n "$e" ]]; then
    LIGAND_PARAM=$e
  fi
done < run.gs

# A completed setup is never redone, in --setup mode and in legacy mode alike:
# make_boresch rewrites index.ndx and the leg .mdp files, which would be pulled out
# from under any cycle task already running (e.g. if the user re-submits with
# --restart while jobs are live). Legacy mode used to run the setup phase on every
# start, and in a directory set up by older code that rebuilt the restraints on the
# old probe, box and ligands and then let the unfinished cycles continue into the
# new legs (review CYC-1). It now goes straight to its cycles, where the
# protocol_id.gs check decides whether they may run.
if [[ "$MODE" != "cycle" && -f setup.done ]]; then
  # Still refresh the top-level analytical record: it is cheap, idempotent, and
  # may be missing even though the setup is complete (e.g. the results files were
  # cleared for a fresh scoring run). Without it every structure scores PENDING.
  if [[ -f boresch_analytical.gs ]]; then
    DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
    mkdir -p ../results_analytical.d
    echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
  fi
  SETUP_ID=$(head -n 1 protocol_id.gs 2>/dev/null | tr -d '[:space:]')
  if [[ "$SETUP_ID" != "$FE_PROTOCOL_ID" ]]; then
    [[ -n "$SETUP_ID" ]] || SETUP_ID="unrecorded (no protocol_id.gs: set up before v1.5)"
    echo "WARNING: $STRUCT_ID was set up under protocol $SETUP_ID, and this code runs"
    echo "  $FE_PROTOCOL_ID. None of its unfinished cycles will run here; set the"
    echo "  structure up again in a fresh directory."
  fi
  if [[ "$MODE" == "setup" ]]; then
    echo "Setup already complete for $STRUCT_ID; nothing to do."
    exit 0
  fi
  echo "Setup already complete for $STRUCT_ID; going on to its cycles."
fi

# In array mode, wait for the one-off setup job to finish instead of terminating:
# nothing below (pdb2gmx, the leg .mdp files, index.ndx, numpertres.gs) exists
# until the setup has defined the restraints. This must happen BEFORE any setup
# step so a task released early never races the setup job. Exit cleanly -- not by
# error -- if the setup reported a failure for this structure.
if [[ "$MODE" == "cycle" ]]; then
  WAIT_MAX=${GROSCORE_SETUP_WAIT:-21600}   # seconds; default 6 h
  WAIT_INT=${GROSCORE_SETUP_POLL:-30}
  waited=0
  while [[ ! -f setup.done ]]; do
    # The LAST line for this structure, whatever it says -- not the last FAILING
    # line. results_0.gs is append-only across attempts, so filtering to non-OK
    # before taking the tail makes the first failure permanent: every later "OK"
    # is discarded and a directory that has since been fixed still reports the old
    # failure. test13 sat in exactly that state, with a BORESCH_FAIL from a
    # superseded attempt killing all 50 tasks of every array submitted after it.
    #
    # "OK" alone is not success: it is written part-way through the setup, before
    # the restraints exist, so it means keep waiting. SETUP_RUNNING, written by the
    # setup job as its first act, means the same and is what makes a fresh attempt
    # supersede an old failure rather than inherit it.
    SETUP_STATUS=$(awk -v s="$STRUCT_ID" '$1==s{print $2}' ../results_0.gs 2>/dev/null | tail -1)
    if [[ -n "$SETUP_STATUS" && "$SETUP_STATUS" != "OK" && "$SETUP_STATUS" != "SETUP_RUNNING" ]]; then
      echo "Setup for $STRUCT_ID failed ($SETUP_STATUS); cycle $CYCLE_ARG has nothing to run."
      exit 0
    fi
    if [[ $waited -ge $WAIT_MAX ]]; then
      echo "Timed out after ${waited}s waiting for setup of $STRUCT_ID (cycle $CYCLE_ARG)."
      exit 1
    fi
    [[ $waited -eq 0 ]] && echo "Cycle $CYCLE_ARG waiting for shared setup of $STRUCT_ID ..."
    sleep $WAIT_INT
    waited=$((waited+WAIT_INT))
  done
  [[ $waited -gt 0 ]] && echo "Setup ready after ${waited}s; starting cycle $CYCLE_ARG."
fi

# Set force field specific parameters
# Get absolute path to GroScore root (two levels up from structure directory)
GROSCORE_ROOT="$(cd ../.. && pwd)"
MDP_DIR="${GROSCORE_ROOT}/settings/$FORCEFIELD"

# A settings tree may carry a VARIANT SUFFIX: gromos54a8_rf is the same force field
# as gromos54a8, run under the reaction field it was parametrised with rather than a
# lattice sum. Only MDP_DIR wants the full name. Everything that asks WHICH FORCE
# FIELD this is -- pdb2gmx's -ff, the GMXLIB addition, the NCAA rename table, the
# ion protonation map, residuetypes.dat -- must ask FF_BASE, because each of those
# is an `== "gromos54a8"` test that would otherwise fall through to the AMBER branch
# without a word. Ten of them in this file.
FF_BASE="${FORCEFIELD%_rf}"

# Whether small-molecule ligands are parametrised, and if not, why; one definition
# for the parametrisation loop and for merge_ligand.py, which reports the ligands
# left out accordingly. on: AMBER19SB with OpenFF, as the run asked. off-user: the
# user passed --no-ligand-param (run.gs field 5 = 0), so running without ligands is
# a choice and they are only listed. off-ff: CHARMM36 and GROMOS 54A8 have no ligand
# parametrisation here, so every ligand in the simulated region is a LIGAND_FAIL
# line rather than a complex quietly run without part of its interface; the user
# can still choose --no-ligand-param (decision of 2026-10-04).
if [[ "$LIGAND_PARAM" != "1" ]]; then
  LIGAND_PARAM_MODE="off-user"
elif [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
  LIGAND_PARAM_MODE="on"
else
  LIGAND_PARAM_MODE="off-ff"
fi
# merge_ligand.py is what writes ligand_failed.gs. If it crashes, no line names the
# ligands it never merged, and the structure would run without them, so a crash
# stops the structure as a failed ligand. It stops before conf_vacbox.gro exists, so
# the next attempt starts from the restart cleanup and merges again.
ligand_merge_crashed() {
  echo "Stage 0 failed: merge_ligand.py exited $1, so which ligands reached the topology is unknown."
  echo $STRUCT_ID "LIGAND_FAIL" >> ../results_0.gs
  exit 0
}
# stage0_fail STATUS MESSAGE: one status line for groscore_fe.py and stop, exit 0 as
# every stage-0 verdict here (job.run's function, which the setup chain below calls).
stage0_fail() {
  echo "Stage 0 failed: $2"
  echo $STRUCT_ID "$1" >> ../results_0.gs
  exit 0
}

# ION TYPES OF THE WATER MODEL (the same text in job.run and job_fe.run). pdb2gmx
# types every ion residue from aminoacids.rtp, which in GROMACS 2026's amber19sb.ff
# hard-codes the OPC-fitted Li/Merz types (Mg2+_opc, Zn2+_opc, ...) whatever -water
# says, so every crystal ion of an amber19sb_opc3 run had OPC parameters in OPC3
# water. retype_ions.py gives them their twins (Mg2+_opc3); it runs right after every
# pdb2gmx, before anything reads or copies the topology, and does nothing under OPC
# water or another force field. A twin the force field lacks stops the structure.
retype_ions() {
  python3 ../../utils/retype_ions.py -t topol.top --water "$WATER_MODEL" \
    || stage0_fail FAILED "retype_ions.py could not give the ions the $WATER_MODEL atom types (see above)."
}

# ---- GLYCANS AND NCAAs IN THE SETUP CHAIN (the same text in job.run and job_fe.run) ----
# GLYCANS ARE FUSED, NOT EXTRACTED (decision of 2026-10-04). A glycan covalently
# bonded to ASN ND2, SER OG or THR OG1 used to stop the structure as LIGAND_FAIL
# whenever it lay in the simulated region, so 1MAH (NAG A 544 on ASN A 350) and 2AJF
# (NAGs on ASN A 53, A 322, A 546 and E 330) never ran. utils/fuse_glycans.py now
# makes each such glycan one residue with its amino acid (NG<k> on Asn, SG<k> on Ser,
# TG<k> on Thr), written to fused.pdb and defined in glycans.json, and that residue
# takes the NCAA path (parametrize_ncaa.py). A glycan it does not fuse (a non-sugar in
# it, atoms that differ from its CCD entry, more sugars than an optional cap) stays HETATM,
# is extracted as a ligand and stops the structure in the region as before, with the
# reason from glycan_unfused.gs on its LIGAND_FAIL line. Fused only when ligands are
# parametrised (LIGAND_PARAM_MODE on: AMBER19SB with OpenFF): CHARMM36 and GROMOS
# 54A8 have no OpenFF parametrisation here (GROMOS takes NCAAs from its own force
# field only), and under --no-ligand-param the glycans go with the ligands, left out
# and named.
#
# NO CAP BY DEFAULT. Every glycan is fused, whatever its size, so none is simulated
# detached; GROSCORE_GLYCAN_MAX_SUGARS sets an optional cap. AM1-BCC of the capped
# residue took 54-102 s with one sugar, 161 s with two and 532 s with three, growing
# about with the cube of its size, so a 9-sugar Fc glycan costs about 2 h of setup,
# and parametrize_ncaa.py puts no time limit on it unless
# GROSCORE_GLYCAN_AM1BCC_WALL_S sets one. The variable
# comes from the environment the job was submitted from, as GROSCORE_LEG_TIMEOUT
# does: the GPU SLURM templates pass --export=ALL, sbatch exports everything by
# default for the CPU one, and utils/local_runner.py starts each job with a copy of
# its own environment. It is handed on as --max-sugars, so the log shows it.
FUSE_GLYCANS=0
[[ "$LIGAND_PARAM_MODE" == "on" ]] && FUSE_GLYCANS=1

# fuse_and_renumber [keep | fuse_glycans.py options]: the fusion when FUSE_GLYCANS is
# 1, then renumber_pdb.py on fused.pdb, or on input.pdb when nothing is fused. 'keep'
# renumbers the fused.pdb there is without fusing again: after an NCAA alone failed,
# it is what parametrize_ncaa.py parametrised, while a fusion redone from scratch reads
# the CCD again and fused a glycan the first pass had not, or refused one it had, when
# an entry answered in one pass only (runner review R2). renumber_pdb.py
# writes one ligand_*.pdb per extracted ligand and never deletes one, and both the
# parametrisation loop and merge_ligand.py take every ligand_*.pdb there is, so the
# files of an earlier pass go first: two passes over 2AJF that fused different sites
# left ligand_NAG_A.pdb beside ligand_NAG_A_703.pdb, one NAG twice, and the
# ligand_NAG_A.pdb an old LIGAND_FAIL attempt left in 1MAH's directory would stop a
# rerun again although NG1 now holds that NAG (critic F3). A fusion that fails stops
# the structure, since which glycans belong to the protein is then unknown.
fuse_and_renumber() {
  local rc input=input.pdb
  if [[ $FUSE_GLYCANS -eq 1 && "${1:-}" == "keep" && -s fused.pdb ]]; then
    input=fused.pdb
  elif [[ $FUSE_GLYCANS -eq 1 ]]; then
    [[ "${1:-}" == "keep" ]] && shift
    # GROSCORE_GLYCAN_MAX_SUGARS unset or empty: no cap, every glycan is fused.
    # Any other value must be a whole number of at least 1 in digits only, without a
    # sign, a leading zero or a space; anything else stops the structure here as
    # FAILED, a setting to fix, not a LIGAND_FAIL from fuse_glycans.py's exit status.
    if [[ -n "${GROSCORE_GLYCAN_MAX_SUGARS:-}" ]]; then
      [[ "$GROSCORE_GLYCAN_MAX_SUGARS" =~ ^[1-9][0-9]*$ ]] \
        || stage0_fail FAILED "GROSCORE_GLYCAN_MAX_SUGARS is '$GROSCORE_GLYCAN_MAX_SUGARS', not a whole number of sugars of at least 1."
      echo "Glycans of up to $GROSCORE_GLYCAN_MAX_SUGARS sugars are fused (GROSCORE_GLYCAN_MAX_SUGARS)."
    fi
    rm -f fused.pdb
    python3 ../../utils/fuse_glycans.py -f input.pdb -o fused.pdb -d glycans.json \
        --unfused glycan_unfused.gs ${GROSCORE_GLYCAN_MAX_SUGARS:+--max-sugars "$GROSCORE_GLYCAN_MAX_SUGARS"} "$@"
    rc=$?
    if [[ $rc -ne 0 || ! -s fused.pdb ]]; then
      stage0_fail LIGAND_FAIL "fuse_glycans.py exited $rc$([[ -s fused.pdb ]] || echo ' and wrote no fused.pdb'), so which glycans belong to the protein is unknown."
    fi
    input=fused.pdb
  fi
  rm -f ligand_*.pdb ligand_info.gs
  python3 ../../utils/renumber_pdb.py -f $input -o renumbered.pdb -c $PROTBCHAINS
}

# ncaa_names FILE: the residues of FILE's ATOM records that carry a CA and are no
# standard amino acid, cap or ion, i.e. the NCAAs and the fused glycans, less those
# named in ncaa_failed.gs; comma-separated. The list used to come from a grep of
# renumbered.pdb.log, a file nothing writes, with this awk as its fallback.
ncaa_names() {
  awk -v failed="$(awk '{print $1}' ncaa_failed.gs 2>/dev/null)" '
    BEGIN {n = split(failed, f); for (i = 1; i <= n; i++) skip[f[i]] = 1}
    /^ATOM/ {res=substr($0,18,3); gsub(/ /,"",res); name=substr($0,13,4); gsub(/ /,"",name); if(name=="CA") seen[res]=1}
    END{for(r in seen) if(!(r in skip)&&r!="ALA"&&r!="ARG"&&r!="ASN"&&r!="ASP"&&r!="CYS"&&r!="CYX"&&r!="GLN"&&r!="GLU"&&r!="GLY"&&r!="HID"&&r!="HIE"&&r!="HIP"&&r!="HIS"&&r!="ILE"&&r!="LEU"&&r!="LYS"&&r!="MET"&&r!="PHE"&&r!="PRO"&&r!="SER"&&r!="THR"&&r!="TRP"&&r!="TYR"&&r!="VAL"&&r!="ACE"&&r!="NME"&&r!="NHE"&&r!="ZN"&&r!="CA"&&r!="MG"&&r!="CU"&&r!="CU1"&&r!="NA"&&r!="CL") printf "%s,",r}' "$1" | sed 's/,$//'
}

# ncaa_fallback RC: what follows parametrize_ncaa.py, which exited with RC. A residue
# it could not parametrise leaves the chain, all in one pass. An NCAA it named in
# ncaa_failed.gs becomes its parent residue (fix_pdb.py and PDBFixer), as before. A
# fused glycan it named in glycan_failed.gs ('RESNAME reason') is not fused again:
# its sugars are extracted as ligands, parametrised as such and judged by region in
# merge_ligand.py, and every sugar's glycan_unfused.gs line carries the reason, so
# that its LIGAND_FAIL line says why. A crash names nothing, so a non-zero exit
# counts against every fused residue: the names fused.pdb has and input.pdb has not
# (fuse_glycans.py never gives a glycan a name the input uses), read from the PDB
# files, since an unreadable glycans.json is one reason for parametrize_ncaa.py to
# exit 1. The order is the point (critic F4): the fusion, the renumbering, the NCAA
# list, fix_pdb.py and cap_termini.py, each from the step before. The old block ran
# fix_pdb.py on the first pass's renumbered.pdb, which still holds a fused residue
# that failed, and pdb2gmx would have stopped on it as a residue without an rtp
# entry. The fusion runs again only to leave out the glycans that failed, and then
# fuses no chemistry the first pass did not (fuse_glycans.py --exclude-file); when an
# NCAA alone failed, the first pass's fused.pdb is renumbered as it is (runner R2).
ncaa_fallback() {
  local rc=$1 name why="" excl=()
  if [[ $rc -ne 0 && -s fused.pdb ]]; then
    for name in $(comm -13 <(awk '/^(ATOM|HETATM)/ {r = substr($0, 18, 3); gsub(/ /, "", r); print r}' input.pdb | sort -u) \
                           <(awk '/^(ATOM|HETATM)/ {r = substr($0, 18, 3); gsub(/ /, "", r); print r}' fused.pdb | sort -u)); do
      awk -v n="$name" '$1 == n {f = 1} END {exit !f}' glycan_failed.gs 2>/dev/null \
        || echo "$name parametrize_ncaa.py exited $rc" >> glycan_failed.gs
    done
  fi
  [[ -s ncaa_failed.gs || -s glycan_failed.gs ]] || return 0
  if [[ -s ncaa_failed.gs ]]; then
    echo "Replacing the NCAAs that failed to parametrise ($(awk '{print $1}' ncaa_failed.gs | paste -sd, -)) with their parent residues"
  fi
  if [[ -s glycan_failed.gs ]]; then
    echo "The fused glycans that failed to parametrise go back to ligands: $(awk '{print $1}' glycan_failed.gs | paste -sd, -)"
    # Their sugars, 'RES CHAIN NUM<TAB>RESNAME<TAB>reason', read from glycans.json
    # before the fusion below rewrites it. The reason is whitespace-normalised, as
    # fuse_glycans.py writes it into its own glycan_unfused.gs line, so the copy below
    # recognises it there and adds it once.
    why=$(python3 - <<'GLYCAN_PY'
import json
reason = {}
for line in open("glycan_failed.gs"):
    t = line.split(None, 1)
    if t:
        reason.setdefault(t[0], " ".join(t[1].split()) if len(t) > 1 else "no reason recorded")
try:
    residues = json.load(open("glycans.json")).get("residues", [])
except (OSError, ValueError):
    residues = []
for r in residues:
    for inst in (r.get("instances", []) if r.get("resname") in reason else []):
        for s in inst.get("sugars", []):
            print("\t".join([" ".join(str(s).split()[:3]), r["resname"], reason[r["resname"]]]))
GLYCAN_PY
)
    excl=(--exclude-file glycan_failed.gs)
  fi
  if [[ ${#excl[@]} -gt 0 ]]; then
    fuse_and_renumber "${excl[@]}"
  else
    fuse_and_renumber keep
  fi
  if [[ -n "$why" ]]; then
    # A line is keyed 'RES CHAIN NUM' without an insertion code, as renumber_pdb.py
    # names the extracted ligand and merge_ligand.py looks it up; glycans.json labels
    # a sugar 'NAG A 544A' when it has one.
    python3 - "$why" <<'GLYCAN_PY'
import os, re, sys
def key(text):
    t = text.split()[:3]
    return (t[0], t[1], re.sub(r"[A-Za-z]+$", "", t[2])) if len(t) == 3 else None
lines = open("glycan_unfused.gs").read().splitlines() if os.path.isfile("glycan_unfused.gs") else []
for row in sys.argv[1].splitlines():
    sugar, name, why = row.split("\t", 2)
    k = key(sugar)
    if k is None:
        continue
    hit = [i for i, l in enumerate(lines) if key(l) == k]
    if hit and why in " ".join(lines[hit[0]].split()):
        continue
    note = "%s failed to parametrise: %s" % (name, why)
    if hit:
        lines[hit[0]] += "; " + note
    else:
        lines.append("%s %s" % (" ".join(k), note))
open("glycan_unfused.gs", "w").write("".join(l + "\n" for l in lines))
GLYCAN_PY
  fi
  NCAA_LIST=$(ncaa_names renumbered.pdb)
  echo "NCAA residues after the fallback: ${NCAA_LIST:-none}"
  NCAA_FLAG=""
  [[ -n "$NCAA_LIST" ]] && NCAA_FLAG="--keep-ncaa $NCAA_LIST"
  python3 ../../utils/fix_pdb.py -f renumbered.pdb -o fixed.pdb $NCAA_FLAG
  python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs
}
# ---- end of the setup chain both runners share ----


# Simulation temperature, READ FROM THE MDP rather than repeated as a literal.
#
# make_boresch.py needs it for the analytical Boresch term, and that value goes
# straight into the thermodynamic cycle, so a temperature that disagrees with the
# one the legs actually run at is a silent error in every dG_bind. This used to be
# passed as a hard-coded -T 310 sitting a few hundred lines away from the mdp it
# had to agree with, which is the same shape as the two temperature traps already
# found in the scoring scripts. Deriving it removes the constant instead of
# checking it.
REF_T=$(awk -F= '/^ *ref_t *=/{n=split($2,a," "); print a[1]; exit}' $MDP_DIR/${FE_LEG_MDPS[0]} 2>/dev/null)
# Both tc-grps must be at the same temperature: a two-bath setup would make "the"
# simulation temperature ambiguous and eq.32 wrong for at least one of them.
REF_T_ALL=$(awk -F= '/^ *ref_t *=/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}' $MDP_DIR/${FE_LEG_MDPS[0]} 2>/dev/null)
if [[ -n "$REF_T_ALL" ]] && [[ $(echo "$REF_T_ALL" | tr ' ' '\n' | grep -c . ) -gt 1 ]]; then
  if [[ $(echo "$REF_T_ALL" | tr ' ' '\n' | grep -v '^$' | sort -u | wc -l) -ne 1 ]]; then
    echo "WARNING: $MDP_DIR/${FE_LEG_MDPS[0]} couples groups to different temperatures ($REF_T_ALL);"
    echo "  using $REF_T K for the analytical Boresch term, which is right for at most one of them."
  fi
fi
if ! [[ "$REF_T" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "WARNING: could not read ref_t from $MDP_DIR/${FE_LEG_MDPS[0]}; assuming 310 K for the"
  echo "  analytical Boresch term. If the legs do not run at 310 K, dG_release is wrong."
  REF_T=310
fi
if [[ "$FF_BASE" == "charmm36" ]]; then
  # Add local forcefield directory to GMXLIB so GROMACS can find charmm36-jul2022.ff
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="${GROSCORE_ROOT}/forcefield:${GMXLIB}"
  else
    export GMXLIB="${GROSCORE_ROOT}/forcefield"
  fi
  FF_FLAG="-ff charmm36-jul2022"
  WATER_MODEL="tip3p"
  WATER_BOX="spc216.gro"
elif [[ "$FF_BASE" == "amber19sb_opc" ]]; then
  # AMBER ff19SB with OPC water (4-point)
  FF_FLAG="-ff amber19sb"
  WATER_MODEL="opc"
  WATER_BOX="tip4p.gro"
elif [[ "$FF_BASE" == "amber19sb_opc3" ]]; then
  # AMBER ff19SB with OPC3 water (3-point) included in standard GROMACS installation
  FF_FLAG="-ff amber19sb"
  WATER_MODEL="opc3"
  WATER_BOX="spc216.gro"
elif [[ "$FF_BASE" == "gromos54a8" ]]; then
  # GROMOS 54A8 with SPC water - custom force field in forcefield/ directory
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="${GROSCORE_ROOT}/forcefield:${GMXLIB}"
  else
    export GMXLIB="${GROSCORE_ROOT}/forcefield"
  fi
  FF_FLAG="-ff gromos54a8"
  WATER_MODEL="spc"
  WATER_BOX="spc216.gro"
fi

# A SETUP RESUMED PAST ITS pdb2gmx gets the ion types of the water model too. The
# restart recovery keeps a setup that stopped in the probe pass (conf.gro and
# emin_vac.gro, no box.gro), so its topology may have been written before
# retype_ions existed, and neither pdb2gmx below runs again. retype_ions does nothing
# to a topology already typed. Not under existing cycles (emin_solv.gro, the system
# they run, exists): one structure's cycles keep one ion set. Probe replicas that
# already finished keep what they ran with; the probe only places the restraints and
# sizes the box.
if [[ "$MODE" != "cycle" && ! -f setup.done && ! -f emin_solv.gro && -f conf.gro && -f topol.top ]]; then
  retype_ions
fi

# Renumber PDB to have unique sequential residue numbers across chains
# Always re-run if conf.gro doesn't exist (restart safety: cap_termini overwrites
# chain_map.gs with post-cap numbers that become stale if setup is re-run)
if [[ ! -f conf.gro ]]; then
  # What an earlier attempt left of the fusion and its failure lists describes that
  # attempt. ncaa_names below leaves out every name in ncaa_failed.gs, so a stale line
  # from a setup that died before conf.gro would hand fix_pdb.py an NCAA that
  # parametrises now as one to replace by its parent residue (critic F3).
  # parametrize_ncaa.py removes both lists itself, but only when it starts. The ligand
  # parametrisation outputs too, as the restart cleanup removes them: an attempt whose
  # pdb2gmx wrote no conf.gro left a manifest line for a NAG that the next attempt
  # fused, and merge_ligand.py merged it on top of its own sugar (runner review R1).
  rm -f ncaa_failed.gs glycan_failed.gs fused.pdb glycans.json glycan_unfused.gs
  rm -f ligand_*.itp ligand_*.gro ligand_*.sdf ligand_manifest.gs ligand_failed.gs
  fuse_and_renumber
fi
if [[ ! -f conf.gro ]]; then
  # Detect NCAA residues: AMBER19SB uses OpenFF parametrization; GROMOS uses FF's native PTM entries
  NCAA_FLAG=""
  if [[ $LIGAND_PARAM -eq 1 && ("$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3") ]]; then
    # The NCAAs and the fused glycans (ncaa_names).
    NCAA_LIST=$(ncaa_names renumbered.pdb)
    if [[ -n "$NCAA_LIST" ]]; then
      echo "NCAA residues detected: $NCAA_LIST"
      NCAA_FLAG="--keep-ncaa $NCAA_LIST"
    fi
  elif [[ "$FF_BASE" == "gromos54a8" ]]; then
    # GROMOS 54A8 has ~80 PTM NCAAs natively parametrized in its FF.
    # Classify NCAAs from renumbered.pdb: FF-native ones go to ncaa_residues.gs (keep with
    # --keep-ncaa so fix_pdb.py doesn't rename them), unknown ones go to ncaa_failed.gs
    # (fix_pdb.py will replace them with parent residues via PDBFixer).
    python3 ../../utils/parametrize_ncaa.py -f renumbered.pdb --gmx-ff gromos54a8
    # Apply PDB CCD → GROMOS residue/atom renames (e.g. TPO→T1P, P→PD) before fix_pdb.py
    if [[ -f ncaa_rename.gs ]]; then
      python3 - << 'RENAME_PY'
import sys
renames = {}   # pdb_resname -> gromos_resname
atom_maps = {} # pdb_resname -> {pdb_atom: gromos_atom}
with open('ncaa_rename.gs') as f:
    for line in f:
        parts = line.rstrip('\n').split('\t')
        if len(parts) >= 2:
            pdb_rn, gros_rn = parts[0], parts[1]
            renames[pdb_rn] = gros_rn
            if len(parts) >= 3 and parts[2]:
                atom_maps[pdb_rn] = dict(p.split('=') for p in parts[2].split(',') if '=' in p)
with open('renumbered.pdb') as f:
    lines = f.readlines()
with open('renumbered.pdb', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM  ', 'HETATM')):
            res = line[17:20].strip()
            if res in renames:
                atom = line[12:16].strip()
                new_atom = atom_maps.get(res, {}).get(atom, atom)
                new_res = renames[res]
                # Rebuild PDB line with renamed residue and atom: the atom in PDB
                # columns 13-16, the residue in 18-20, or in 18-21 for a 4-character
                # GROMOS name (DALA), so that the chain stays in column 22. Written as
                # '%-3s' + line[20:], DALA moved every later column one to the right and
                # fix_pdb.py stopped on the coordinates (ncaa review F2).
                tail = ('%-3s' % new_res) + line[20:] if len(new_res) <= 3 else ('%-4s' % new_res) + line[21:]
                line = line[:12] + ('%-4s' % new_atom) + line[16:17] + tail
        f.write(line)
print("Applied GROMOS PTM renames to renumbered.pdb")
RENAME_PY
    fi
    if [[ -f ncaa_residues.gs ]]; then
      NCAA_LIST=$(cat ncaa_residues.gs | tr '\n' ',' | sed 's/,$//')
      if [[ -n "$NCAA_LIST" ]]; then
        NCAA_FLAG="--keep-ncaa $NCAA_LIST"
        echo "GROMOS-native PTM NCAAs (pdb2gmx handles directly): $NCAA_LIST"
      fi
    fi
    if [[ -f ncaa_failed.gs ]]; then
      FAILED=$(cat ncaa_failed.gs | tr '\n' ',' | sed 's/,$//')
      echo "GROMOS-unknown NCAAs (will be replaced with parent residue): $FAILED"
    fi
  fi
  # Fix missing atoms and non-standard residues
  python3 ../../utils/fix_pdb.py -f renumbered.pdb -o fixed.pdb $NCAA_FLAG
  # Add terminal caps: ACE/NME for AMBER19SB variants, ACE-only for CHARMM36 and GROMOS (uses COOH C-term patches)
  if [[ "$FF_BASE" == "charmm36" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs --ace-only
    PDB2GMX_INPUT="fixed_capped.pdb"
  elif [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs
    PDB2GMX_INPUT="fixed_capped.pdb"
  elif [[ "$FF_BASE" == "gromos54a8" ]]; then
    python3 ../../utils/cap_termini.py -f fixed.pdb -o fixed_capped.pdb -m chain_map.gs --ace-only --rename-ace-carbon
    PDB2GMX_INPUT="fixed_capped.pdb"
  fi
  # GROMOS 54A8: Remove OXT atoms added by PDBFixer - RTP doesn't define OXT, COOH patch handles C-termini
  if [[ "$FF_BASE" == "gromos54a8" ]]; then
    sed -i '/ OXT /d' $PDB2GMX_INPUT
  fi
  # Parametrize NCAA residues with OpenFF (AMBER19SB only, before pdb2gmx)
  # GROMOS NCAA handling is done above via native FF entries — no OpenFF needed.
  if [[ -n "$NCAA_FLAG" && ("$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3") ]]; then
    python3 ../../utils/parametrize_ncaa.py -f fixed.pdb --gmx-ff amber19sb
    # A residue it could not parametrise (an element OpenFF does not type, a fused
    # glycan whose AM1-BCC did not finish) leaves the chain here (ncaa_fallback). The
    # renumbering is redone with it, which also restores the pre-cap chain_map.gs and
    # ion_residues.gs that cap_termini.py overwrote with post-cap numbers.
    ncaa_fallback $?
    if [[ -d amber19sb.ff ]]; then
      # Use local FF with NCAA entries; set GMXLIB to current dir so pdb2gmx finds it
      if [[ -n "${GMXLIB:-}" ]]; then
        export GMXLIB="$(pwd):${GMXLIB}"
      else
        export GMXLIB="$(pwd)"
      fi
      echo "Using local amber19sb.ff with NCAA entries"
    fi
  fi
  # Add FeS cluster ion entries to local FF if needed (AMBER19SB only)
  # SD is not in standard AMBER19SB; FE2 atom name differs (FE2 vs FE in PDB)
  # FeS clusters arrive as one-ion residues FE2 and SD (renumber_pdb.py), so the test
  # is by residue name: a grep for ' SD ' matched the SD atom of every methionine and
  # gave each such structure a local copy of the force field (review E3).
  if awk '/^(ATOM  |HETATM)/ { r = substr($0, 18, 3); gsub(/ /, "", r); if (r == "SD" || r == "FE2") f = 1 }
          END { exit !f }' $PDB2GMX_INPUT 2>/dev/null; then
    if [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
      if [[ ! -d amber19sb.ff ]]; then
        # Find GROMACS data directory (varies by installation)
        GMX_DATAPREFIX=$(gmx --version 2>&1 | grep "Data prefix" | awk '{print $NF}')
        GMX_TOPDIR="${GMX_DATAPREFIX}/share/gromacs/top"
        cp -r "$GMX_TOPDIR/amber19sb.ff" .
        echo "Created local amber19sb.ff from $GMX_TOPDIR"
      fi
      # Add SD entry if missing
      if ! grep -q '^\[ SD \]' amber19sb.ff/aminoacids.rtp 2>/dev/null; then
        printf '\n[ SD ]\n; Sulfide ion (from FeS cluster, charge -1.0 for oxidized state)\n [ atoms ]\n  S      S     -1.000000    1\n [ bonds ]\n\n' >> amber19sb.ff/aminoacids.rtp
        echo "Added SD ion entry to local amber19sb.ff"
      fi
      # Fix FE/FE2 atom names: AMBER uses FE2/FE as atom names, but PDB has FE for both
      sed -i 's/^  FE2    Fe2+/  FE     Fe2+/' amber19sb.ff/aminoacids.rtp
      sed -i 's/^  FE     Fe3+/  FE     Fe3+/' amber19sb.ff/aminoacids.rtp
      echo "Fixed FE2 atom name in local amber19sb.ff"
      if [[ -n "${GMXLIB:-}" ]]; then
        export GMXLIB="$(pwd):${GMXLIB}"
      else
        export GMXLIB="$(pwd)"
      fi
    fi
  fi
  # Strip H from NCAA residues — PDBFixer/cap_termini may add wrong H (e.g., HG1 on
  # phosphorylated OG1 in TPO). pdb2gmx with -ignh re-adds correct H from HDB.
  if [[ -n "$NCAA_FLAG" ]]; then
    python3 -c "
import sys
ncaas = set('$NCAA_LIST'.split(','))
# OpenMM writes at most 3 characters of a residue name (fix_pdb.py, cap_termini.py),
# so a 4-character GROMOS name (DALA) goes back into columns 18-21 (ncaa review F2).
cut = {n[:3]: n for n in ncaas if len(n) == 4}
with open('$PDB2GMX_INPUT') as f:
    lines = f.readlines()
with open('$PDB2GMX_INPUT', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM','HETATM')) and line[17:21].strip() in cut:
            line = line[:17] + cut[line[17:21].strip()] + line[21:]
        if line.startswith(('ATOM','HETATM')) and line[17:21].strip() in ncaas:
            if line[12:16].strip().startswith('H'):
                continue  # strip wrong H from NCAA
            if line.startswith('HETATM'):
                line = 'ATOM  ' + line[6:]  # ensure NCAA is ATOM
        f.write(line)
"
  fi
  # Fix protonation states for ion-coordinating CYS/HIS residues
  python3 ../../utils/fix_ion_protonation.py -f $PDB2GMX_INPUT -m ion_residues.gs --ff $FF_BASE
  # Ion residue names for pdb2gmx chain handling
  ION_RESIDUES="BA|CA|CD|CL|CO|CS|CU|CU1|FE|FE2|HG|K|LI|MG|MN|NA|NI|PB|SD|SR|ZN"
  # Get chain ID and residue name of first atom in each segment
  # Format: "chain_id resname" per line
  CHAIN_DATA=$(awk 'BEGIN{first=1} /^TER/{first=1; next} /^ATOM/ && first{chain=substr($0,22,1); res=substr($0,18,3); gsub(/ /,"",res); print chain, res; first=0}' $PDB2GMX_INPUT)
  # Merge selections: y if same chain ID as previous (and neither is an ion), n otherwise
  MERGE_INPUT=""
  prev_chain=""
  prev_res=""
  while read -r chain res; do
    if [[ -n "$prev_chain" ]]; then
      if [[ "$res" =~ ^($ION_RESIDUES)$ ]] || [[ "$prev_res" =~ ^($ION_RESIDUES)$ ]]; then
        MERGE_INPUT="${MERGE_INPUT}n\n"
      elif [[ "$chain" == "$prev_chain" ]]; then
        MERGE_INPUT="${MERGE_INPUT}y\n"
      else
        MERGE_INPUT="${MERGE_INPUT}n\n"
      fi
    fi
    prev_chain=$chain
    prev_res=$res
  done <<< "$CHAIN_DATA"
  # Count protein-only segments (ions have no terminal patches, pdb2gmx won't prompt for them)
  NSEGS_PROTEIN=$(echo "$CHAIN_DATA" | awk -v ions="$ION_RESIDUES" 'BEGIN{split(ions,a,"|"); for(i in a) ion[a[i]]=1; n=0} {if(!($2 in ion)) n++} END{print n}')
  # Terminal selections per protein segment: N-terminus then C-terminus
  # CHARMM36: N-term 8 (none, ACE is explicit), C-term 1 (COOH patch)
  # AMBER19SB variants: No terminal selections needed (no termini defined in FF)
  # GROMOS 54A8: N-term 8 (none, ACE is explicit), C-term 1 (COOH patch)
  if [[ "$FF_BASE" == "charmm36" ]]; then
    TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
  elif [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
    TER_INPUT=""
  elif [[ "$FF_BASE" == "gromos54a8" ]]; then
    TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
  fi
  # Merge questions come first, then terminal selections
  echo -e "${MERGE_INPUT}${TER_INPUT}" | gmx pdb2gmx -f $PDB2GMX_INPUT -water $WATER_MODEL $FF_FLAG -ignh -missing -ter -chainsep id_or_ter -merge interactive -o conf.gro
  # Without conf.gro the setup has failed: stop before the loop below spends AM1-BCC
  # time on the ligands of a structure that cannot run (runner review R1).
  [[ -f conf.gro ]] || stage0_fail FAILED "pdb2gmx produced no conf.gro."
  retype_ions
  # Parametrize small molecules with OpenFF (AMBER19SB only)
  # Each instance gets a unique molecule name via running counter (-i)
  if [[ "$LIGAND_PARAM_MODE" == "on" ]]; then
    LIGAND_INSTANCE=0
    for ligpdb in ligand_*.pdb; do
      [ -f "$ligpdb" ] || continue
      # Parse resname and chain from filename:
      #   ligand_{RESNAME}_{CHAIN}.pdb        (single instance)
      #   ligand_{RESNAME}_{CHAIN}_{RESNUM}.pdb (multiple instances)
      SUFFIX=$(basename "$ligpdb" .pdb | sed 's/^ligand_//')
      RESNAME=$(echo "$SUFFIX" | sed 's/_[A-Z]$//;s/_[A-Z]_[0-9]*$//')
      CHAIN=$(echo "$SUFFIX" | sed 's/.*_\(.\)$/\1/;s/.*_\(.\)_[0-9]*$/\1/')
      python3 ../../utils/parametrize_ligand.py -f "$ligpdb" -r "$RESNAME" -c "$CHAIN" -i $LIGAND_INSTANCE
      PL_RC=$?
      # A FAILED PARAMETRISATION IS NEVER LOST, as in job.run. The exit status used to
      # be ignored here. merge_ligand.py still stopped an in-region instance that had
      # no manifest entry, but only as 'parametrisation left no ligand_manifest.gs
      # entry and no reason', and let one through that exited non-zero after writing
      # its entry. parametrize_ligand.py writes 'did not finish' before anything that
      # can fail; one that dies before even that (an import or interpreter error) is
      # recorded here, under the instance key it would have used (RESNAME CHAIN RESNUM
      # from the first record), naming the exit status. merge_ligand.py then keeps the
      # line for every ligand in the simulated region, and the structure stops as
      # LIGAND_FAIL below; a ligand outside the region is not simulated and is only
      # named in the log.
      if [[ $PL_RC -ne 0 ]]; then
        KEY=$(awk '/^(ATOM  |HETATM)/{r=substr($0,18,3); c=substr($0,22,1); n=substr($0,23,4);
                   gsub(/ /,"",r); gsub(/ /,"",c); gsub(/ /,"",n);
                   print r, (c==""?"-":c), (n==""?"0":n); exit}' "$ligpdb")
        if [[ -n "$KEY" ]] && ! awk -v k="$KEY " 'index($0, k)==1{f=1} END{exit !f}' ligand_failed.gs 2>/dev/null; then
          echo "$KEY parametrize_ligand.py exited $PL_RC without recording a reason" >> ligand_failed.gs
        fi
        echo "Ligand $ligpdb failed to parametrise (exit $PL_RC); merge_ligand.py decides whether it stops the structure."
      fi
      LIGAND_INSTANCE=$((LIGAND_INSTANCE + 1))
    done
  fi
fi
# with restart and cutout mode, chain_map.gs references the cutout protein.
# A completed setup passed this check when it ran, so legacy mode, like --cycle,
# does not repeat it on every start.
bl=0
if [[ "$MODE" != "cycle" && ! -f setup.done && ! -f conf_cutout.gro ]]; then
  # No conf.gro is a failed setup, not a broken loop: fix_pdb.py now refuses a
  # structure whose residues would merge and writes no fixed.pdb, so cap_termini.py
  # and pdb2gmx find nothing (the same guard as job.run's).
  if [[ ! -f conf.gro ]]; then
    echo "Stage 0 failed: pdb2gmx produced no conf.gro."
    echo $STRUCT_ID "FAILED" >> ../results_0.gs
    exit 0
  fi
  bl=$(python3 ../../utils/check_brokenloop.py -f conf.gro -m chain_map.gs)
fi
# Anything but 0 or 1 is a crashed check, not a verdict. check_brokenloop.py prints 2
# on any failure, which the -eq test below would call BROKEN, and empty output would
# pass it as 0 (job.run has the same guard).
if [[ "$bl" != "0" && "$bl" != "1" ]]; then
  echo "Stage 0 failed: broken-loop check returned unexpected output ('$bl')."
  echo $STRUCT_ID "FAILED" >> ../results_0.gs
  exit 0
fi
if [[ $bl -eq 0 ]]; then
# ===== SETUP PHASE =====================================================
# Everything the cycles share: stage 0, the initial equilibration, and the
# restraint definition (elastic network + interface + Boresch) written into the
# leg .mdp files. Runs once per structure: skipped entirely by --cycle tasks, and
# by legacy mode once setup.done exists (see "A completed setup is never redone").
if [[ "$MODE" != "cycle" && ! -f setup.done ]]; then
  # Stage 0: Prepare system up to emin_solv.gro
  if [[ ! -f conf_vacbox.gro ]]; then
    if [[ $CUTOUT -eq 1 ]]; then
      python3 ../../utils/make_cutout.py -m chain_map.gs
      # Add terminal caps: ACE/NME for AMBER19SB variants, ACE-only for CHARMM36 and GROMOS
      if [[ "$FF_BASE" == "charmm36" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs --ace-only
        CUTOUT_PDB="cutout_capped.pdb"
      elif [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs
        CUTOUT_PDB="cutout_capped.pdb"
      elif [[ "$FF_BASE" == "gromos54a8" ]]; then
        python3 ../../utils/cap_termini.py -f cutout.pdb -o cutout_capped.pdb -m chain_map.gs --ace-only --rename-ace-carbon
        CUTOUT_PDB="cutout_capped.pdb"
      fi
      # GROMOS 54A8: Remove OXT atoms - RTP doesn't define OXT, COOH patch handles C-termini
      if [[ "$FF_BASE" == "gromos54a8" ]]; then
        sed -i '/ OXT /d' $CUTOUT_PDB
      fi
      # Strip H from NCAA residues in cutout (same issue as full protein)
      if [[ -n "$NCAA_FLAG" ]]; then
        python3 -c "
import sys
ncaas = set('$NCAA_LIST'.split(','))
# OpenMM writes at most 3 characters of a residue name (cap_termini.py), so a
# 4-character GROMOS name (DALA) goes back into columns 18-21 (ncaa review F2).
cut = {n[:3]: n for n in ncaas if len(n) == 4}
with open('$CUTOUT_PDB') as f:
    lines = f.readlines()
with open('$CUTOUT_PDB', 'w') as f:
    for line in lines:
        if line.startswith(('ATOM','HETATM')) and line[17:21].strip() in cut:
            line = line[:17] + cut[line[17:21].strip()] + line[21:]
        if line.startswith(('ATOM','HETATM')) and line[17:21].strip() in ncaas:
            if line[12:16].strip().startswith('H'):
                continue  # strip wrong H from NCAA
            if line.startswith('HETATM'):
                line = 'ATOM  ' + line[6:]  # ensure NCAA is ATOM
        f.write(line)
"
      fi
      # Fix protonation states for ion-coordinating CYS/HIS in cutout
      python3 ../../utils/fix_ion_protonation.py -f $CUTOUT_PDB -m ion_residues.gs --ff $FF_BASE
      # re-solvate cutout
      # Get chain ID and residue name of first atom in each segment
      CHAIN_DATA=$(awk 'BEGIN{first=1} /^TER/{first=1; next} /^ATOM/ && first{chain=substr($0,22,1); res=substr($0,18,3); gsub(/ /,"",res); print chain, res; first=0}' $CUTOUT_PDB)
      # Merge selections: y if same chain ID as previous (and neither is an ion), n otherwise
      MERGE_INPUT=""
      prev_chain=""
      prev_res=""
      while read -r chain res; do
        if [[ -n "$prev_chain" ]]; then
          if [[ "$res" =~ ^($ION_RESIDUES)$ ]] || [[ "$prev_res" =~ ^($ION_RESIDUES)$ ]]; then
            MERGE_INPUT="${MERGE_INPUT}n\n"
          elif [[ "$chain" == "$prev_chain" ]]; then
            MERGE_INPUT="${MERGE_INPUT}y\n"
          else
            MERGE_INPUT="${MERGE_INPUT}n\n"
          fi
        fi
        prev_chain=$chain
        prev_res=$res
      done <<< "$CHAIN_DATA"
      # Count protein-only segments (ions don't need terminal selections)
      NSEGS_PROTEIN=$(echo "$CHAIN_DATA" | awk -v ions="$ION_RESIDUES" 'BEGIN{split(ions,a,"|"); for(i in a) ion[a[i]]=1; n=0} {if(!($2 in ion)) n++} END{print n}')
      # Terminal selections per protein segment
      if [[ "$FF_BASE" == "charmm36" ]]; then
        TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
      elif [[ "$FF_BASE" == "amber19sb_opc" || "$FF_BASE" == "amber19sb_opc3" ]]; then
        TER_INPUT=""
      elif [[ "$FF_BASE" == "gromos54a8" ]]; then
        TER_INPUT=$(printf '8\n1\n%.0s' $(seq 1 $NSEGS_PROTEIN))
      fi
      # Merge questions come first, then terminal selections
      echo -e "${MERGE_INPUT}${TER_INPUT}" | gmx pdb2gmx -f $CUTOUT_PDB -water $WATER_MODEL $FF_FLAG -ignh -missing -ter -chainsep id_or_ter -merge interactive -o conf_cutout.gro
      retype_ions
      # Ligand ITP/GRO files already created during initial parametrization above
      # Merge ligands and crystal waters into cutout topology
      python3 ../../utils/merge_ligand.py -t topol.top -c conf_cutout.gro -m chain_map.gs \
          --ligand-param "$LIGAND_PARAM_MODE" || ligand_merge_crashed $?
      python3 ../../utils/merge_crystal_waters.py -t topol.top -c conf_cutout.gro --proximity
      # Generate ion coordination restraints (active from first energy minimization)
      python3 ../../utils/make_ion_restraints.py -f conf_cutout.gro -m chain_map.gs
      gmx editconf -f conf_cutout.gro -bt dodecahedron -d 10 -o conf_vacbox.gro
    else
      # No cutout: merge ligands and crystal waters into full protein system
      python3 ../../utils/merge_ligand.py -t topol.top -c conf.gro -m chain_map.gs \
          --ligand-param "$LIGAND_PARAM_MODE" || ligand_merge_crashed $?
      python3 ../../utils/merge_crystal_waters.py -t topol.top -c conf.gro
      python3 ../../utils/make_ion_restraints.py -f conf.gro -m chain_map.gs
      gmx editconf -f conf.gro -bt dodecahedron -d 10 -o conf_vacbox.gro
    fi
  fi
  # LIGANDS NEVER FAIL SILENTLY, unless the user chose to run without them.
  # merge_ligand.py writes ligand_failed.gs as 'RESNAME CHAIN RESNUM reason', one line
  # per ligand instance in the simulated region that stops the structure; absent or
  # empty means every ligand is in. Under --ligand-param on (AMBER19SB) that is every
  # instance that did not reach topol.top, was built as a different molecule or is
  # covalently bonded in the deposited model. Under off-ff (CHARMM36, GROMOS 54A8,
  # where nothing parametrises ligands) it is every in-region ligand. Under off-user
  # (--no-ligand-param) nothing is written and the ligands left out are named on
  # stdout only. Through v1.4 nothing stopped: pass 2 dropped the AlF3 of 1WQ1 and
  # 1GRN, the GNP of 1HE8, the ATP of 1KXP and the iodides of 1J2J, built sulfate as
  # neutral H2SO4 and FAD at charge 0, and scored all of them (1GRN and 1WQ1 came out
  # 5.0 and 4.8 pKD too strong, 1KXP 10.0; bm_fe_amber_2/_ana/digest/setup.txt S3,
  # S4). A complex without part of its interface chemistry is a different complex,
  # so the structure stops here, before any compute is spent on it, the way
  # PROBE_FAIL does: one status line and exit 0. Checked after the merge on every
  # setup pass, so a restart that finds conf_vacbox.gro already built cannot skip it.
  if [[ -f ligand_failed.gs ]] && grep -q '[^[:space:]]' ligand_failed.gs; then
    echo "Stage 0 failed: ligand(s) missing from the topology or built wrong (ligand_failed.gs):"
    sed 's/^/  /' ligand_failed.gs
    echo $STRUCT_ID "LIGAND_FAIL" >> ../results_0.gs
    exit 0
  fi
  if [[ ! -f emin_solv.gro ]]; then
    if [[ ! -f emin_vac.tpr ]]; then
      gmx grompp -f $MDP_DIR/emin_vac.mdp -c conf_vacbox.gro -o emin_vac -maxwarn 2
    fi
    if [[ ! -f emin_vac.gro ]]; then
      run_bg gmx mdrun -nt $nt $GPUOPT -deffnm emin_vac
    fi
    # Guard: if vacuum grompp/mdrun did not produce emin_vac.gro, stage 0 failed
    # (e.g. topology/coordinate mismatch). Do NOT fall through to the entangled-loop
    # check — on a missing file it returns empty, and `[[ "" -eq 0 ]]` is TRUE, which
    # would mislabel the structure "OK" and cascade the failure through stage 0.
    if [[ ! -f emin_vac.gro ]]; then
      echo "Stage 0 failed: vacuum energy minimization did not produce emin_vac.gro."
      echo $STRUCT_ID "FAILED" >> ../results_0.gs
      exit 0
    fi
    et=$(python3 ../../utils/check_entangledloops.py -f emin_vac.gro -m chain_map.gs)
    if [[ "$et" == "0" ]]; then
      echo "after equilibration no entangled loops were found."
      echo $STRUCT_ID "OK" >> ../results_0.gs

      # ===== PROBE PASS: equilibrate small, measure, then size the real box =====
      #
      # The production box has to satisfy the GROMACS pull check, 0.49 * the
      # shortest box vector, against interface pairs that only separate once the
      # partners come apart. That demand is not predictable from the minimised
      # structure: the rigorous static bound asks for -d 3.96, and the interface
      # pair set taken from emin_vac.gro has Jaccard 0.31 against the real one. So
      # the size was a constant, 1.5 and then 1.8, measured once on 2KTF.
      #
      # It does not have to be. The bound complex never needs the production box:
      # the largest checked pull pair in the bound reference is 1.18 nm on 2KTF
      # against a limit of 3.29 nm even at -d 1.00. So the long equilibration runs
      # HERE, in a small box, purely to be measured, and the production box is
      # then built from what it measured. The circularity is broken by running the
      # measurement in a box that does not need to be right.
      #
      # This trajectory is also what make_boresch.py takes its backbone RMSF from.
      # Its atom numbering is identical to the production system for atoms 1..N of
      # the solute, since only the solvent count differs, and make_boresch reads
      # geometry from -f and fluctuations from --traj as separate inputs.
      PROBEPAD=$(awk -v r="$(awk -F= '/^ *rvdw *=/{gsub(/[ \t]/,"",$2); print $2; exit}' $MDP_DIR/${FE_LEG_MDPS[0]})" \
                     'BEGIN{ if (r+0 <= 0) r = 1.0; printf "%.2f", r/2 + 0.5 }')
      if [[ ! -f boxpad.gs ]]; then
        echo "Probe pass: equilibrating in a small box (-d $PROBEPAD) to measure the production box."
        if [[ ! -f box_probe.gro ]]; then
          gmx editconf -f emin_vac.gro -o box_probe.gro -bt dodecahedron -d $PROBEPAD
        fi
        # Solvate, ionise and the topology they mutate are ONE step, guarded on
        # the last file the sequence produces. They cannot be guarded
        # individually: topol_probe.top is derived from the dry topol.top and then
        # rewritten by both solvate and genion, so a directory re-entered after a
        # partial probe would reset the topology to dry, skip the solvate whose
        # output already exists, and hand grompp a dry topology against solvated
        # coordinates. That is exactly the atom-count mismatch this block failed
        # with the first time it ran. Re-deriving from scratch costs about 5 s.
        if [[ ! -f solv_ions_probe.gro ]]; then
          rm -f box_solv_probe.gro ions_probe.tpr topol_probe.top
          cp topol.top topol_probe.top
          gmx solvate -cp box_probe.gro -cs $WATER_BOX -o box_solv_probe.gro -p topol_probe.top
          python3 ../../utils/fix_topol_intermolecular.py -p topol_probe.top
          # -p is mandatory here: the default is topol.top, which is the DRY
          # topology, while the coordinates are solvated.
          gmx grompp -r box_solv_probe.gro -f $MDP_DIR/emin_vac.mdp -c box_solv_probe.gro -p topol_probe.top -o ions_probe -maxwarn 2
          echo -e "SOL\n" | gmx genion -s ions_probe.tpr -o solv_ions_probe.gro -p topol_probe.top -pname NA -nname CL -conc 0.15 -neutral
          python3 ../../utils/fix_topol_intermolecular.py -p topol_probe.top
        fi
        if [[ ! -f solv_ions_probe.gro ]]; then
          echo "Stage 0 failed: probe solvation produced no solv_ions_probe.gro."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          exit 0
        fi
        if [[ ! -f emin_probe_sd.gro ]]; then
          gmx grompp -r solv_ions_probe.gro -f $MDP_DIR/emin_solv.mdp -c solv_ions_probe.gro -p topol_probe.top -o emin_probe_sd -maxwarn 2
          run_bg gmx mdrun -nt $nt $GPUOPT -deffnm emin_probe_sd
        fi
        if [[ ! -f emin_probe.gro ]]; then
          gmx grompp -r solv_ions_probe.gro -f $MDP_DIR/emin_solv_cg.mdp -c emin_probe_sd.gro -p topol_probe.top -o emin_probe -maxwarn 2
          run_bg gmx mdrun -nt $nt $GPUOPT -deffnm emin_probe
        fi
        if [[ ! -f emin_probe.gro ]]; then
          echo "Stage 0 failed: probe minimisation produced no emin_probe.gro."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          exit 0
        fi
        # Guarded on the group the probe needs, not on the file: make_ndx writes the
        # file first, and a probe resumed after a kill between the two steps would
        # otherwise find it without Protein_Struct for good.
        if ! grep -q '^\[ *Protein_Struct *\]' index_probe.ndx 2>/dev/null; then
          echo -e "! \"Water\"\nq\n" | gmx make_ndx -f emin_probe.gro -o index_probe.ndx
          python3 ../../utils/make_cluster_group.py -f emin_probe.gro -n index_probe.ndx
        fi
        # INDEPENDENT PROBE REPLICAS. Every restraint, every anchor and the box
        # are measured on the pooled second half of all of them.
        #
        # One probe was the largest single source of irreproducibility in the
        # method: three repeats of one protocol scattered 14.4 kJ/mol on dG_bind
        # against a within-run bootstrap of 4.4, because all 50 cycles of a run
        # share one probe, one Boresch triad and one spring set, and resampling
        # cycles holds every one of those fixed. Averaging over replicas is the
        # only part of the design that touches that term.
        #
        # The NVT ladder is re-run per replica rather than branching all of them
        # off one equilibrated state: gen_seed = -1 gives fresh velocities, but
        # branching late would leave them sharing most of their history, which is
        # the correlation this is meant to break.
        #
        # Each stage reads the checkpoint of the stage before only once that one has
        # its .gro, gets a tpr built anew and runs from step 0 (run_leg_mdrun), like
        # every cycle leg: a stage that died is never continued, and nothing is
        # started from it. A stage that fails twice stops the setup as PROBE_FAIL.
        PROBE_TRAJ=(); PROBE_TPR=()
        for rep in $(seq 1 $N_PROBES); do
          prev=emin_probe
          for pstage in nvt_1 nvt_2 nvt_3 nvt_4 nvt_5 npt; do
            pout=${pstage}_probe${rep}
            if [[ ! -f ${pout}.gro ]]; then
              rm -f ${pout}.tpr
              if [[ "$prev" == "emin_probe" ]]; then
                gmx grompp -r emin_probe.gro -f $MDP_DIR/${pstage}.mdp -c emin_probe.gro -p topol_probe.top -o ${pout} -n index_probe.ndx -maxwarn 10
              elif [[ "$pstage" == "npt" ]]; then
                gmx grompp -r emin_probe.gro -f $MDP_DIR/npt_init_fe.mdp -c ${prev}.tpr -t ${prev}.cpt -p topol_probe.top -o ${pout} -n index_probe.ndx -maxwarn 10
              else
                gmx grompp -r emin_probe.gro -f $MDP_DIR/${pstage}.mdp -c ${prev}.tpr -t ${prev}.cpt -p topol_probe.top -o ${pout} -n index_probe.ndx -maxwarn 10
              fi
              # Two attempts, like every cycle leg. See run_leg_mdrun for what one
              # lost replica used to cost. npt_probe runs 20 ns, hence 600m.
              run_leg_mdrun ${pout} $([[ "$pstage" == "npt" ]] && echo 600m || echo 60m) || true
            fi
            if [[ ! -f ${pout}.gro ]]; then
              echo "Stage 0 failed: probe replica $rep did not finish ${pstage} (no ${pout}.gro)."
              echo "  Re-running this structure keeps the finished replicas and stages and runs ${pout} again from step 0."
              echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
              exit 0
            fi
            prev=${pout}
          done
          PROBE_TRAJ+=(npt_probe${rep}.xtc); PROBE_TPR+=(npt_probe${rep}.tpr)
        done
        # Replica 1 is the structure the restraint set is BUILT on -- which pairs
        # are contacts, which residues are anchors. Where each one SITS is the
        # pooled average, which is the part that was a lottery before.
        ln -sf npt_probe1.gro npt_probe.gro
        ln -sf npt_probe1.tpr npt_probe.tpr
        # Every replica pooled, since the box has to hold whichever one swung
        # widest. measure_box.py reassembles the protein in every frame and sizes
        # the box from a high percentile of its diameter, not from the running
        # maximum of a clustered group, which periodic images inflated past the
        # probe box itself in 18 of 46 pass-2 structures (see its header).
        python3 ../../utils/measure_box.py -f "${PROBE_TRAJ[@]}" -s "${PROBE_TPR[@]}" \
                -n index_probe.ndx -g Protein_Struct -c emin_vac.gro \
                --pad 1.5 > boxpad.tmp
        MB_RC=$?
        if [[ $MB_RC -ne 0 || ! -s boxpad.tmp ]]; then
          echo "Stage 0 failed: measure_box.py exited $MB_RC."
          echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
          rm -f boxpad.tmp
          exit 0
        fi
        mv boxpad.tmp boxpad.gs
      fi

      if [[ ! -f box.gro ]]; then
        # Two independent requirements. Solvation is NOT the binding one.
        #
        # Solvation / minimum image: editconf -d puts periodic images 2d apart,
        # so the solute stops seeing itself once 2d > rvdw, i.e. d > rvdw/2. The
        # unbinding pull grows the solute envelope by pull_dist, which costs
        # pull_dist/2 of clearance on each side, so the floor is
        # rvdw/2 + pull_dist/2. That is 1.00 for amber19sb_opc/opc3 (rvdw 1.0),
        # 1.10 for charmm36 (1.2) and 1.20 for gromos54a8 (1.4). Every one of
        # them is well under the value actually used, so this floor never binds
        # in practice; it is here to catch an exotic cutoff, not to size the box.
        #
        # What actually sizes the box is the GROMACS pull check, 0.49 * the
        # shortest box VECTOR (not the shortest diagonal element; verified
        # against grompp). That demand is dynamical and much larger: interface
        # pairs start at <= 0.6 nm, and on the current protocol (test29, 2KTF,
        # 50 cycles, after the Boresch dihedral sign fix b4c267f) they reach
        # 2.36 nm in the far-end legs once the partners separate, while the
        # Boresch distance r reaches 2.15 nm (its reference at u = 1 alone is
        # 2.09 nm). So it is the interface restraints that set the box, NOT the
        # Boresch anchors and not which anchor-selection mode ran.
        #
        # boxpad.gs is written by the probe pass above, from measure_box.py: the
        # first token of its first line is the -d to use. It is authoritative when
        # present, and it is CLAMPED into [FLOOR, BOXPAD_CAP = 4.0], never
        # discarded; the log says when the clamp moved it. Through v1.4 a value
        # outside that range was thrown away for BOXPAD_FALLBACK, which is
        # backwards. In pass 2 eleven structures asked for 4.16 to 7.74 nm (2AJF
        # 7.737) and were built at 1.8, so the smallest boxes went to the
        # structures whose measurement asked for the most room: five of the eight
        # structures that lost cycles to the 0.49-box check ran in that fallback
        # box, and all five HIGH_RMSD structures were among the eleven
        # (bm_fe_amber_2/_ana/digest/setup.txt S5, S6). Those requests were
        # measurement artefacts, a running maximum over frames with the solute
        # split across periodic images, which measure_box.py no longer takes since
        # it measures a physical diameter. A request above the cap should now be
        # rare, and the cap only bounds the cost: at -d 4.0 the box is already
        # 8 nm wider than the solute.
        #
        # BOXPAD_FALLBACK = 1.8 is used only when there is no boxpad.gs at all,
        # e.g. a directory set up before the probe pass existed. It is the old
        # 2KTF-derived constant and a guess for any other complex, which is the
        # whole reason for the probe. It replaced 1.5 after "Distance between pull
        # groups 73 and 75 (3.772877 nm) is larger than 0.49 times the box size
        # (3.770459)" (d5e792f, 2026-08-12) and a 3.56 nm pair at the start of
        # bindrev (ee45e12). Both came from runs before the Boresch dihedral sign
        # fix (b4c267f), whose mirrored references had reoriented the partners. On
        # the current protocol the largest 2KTF pull pair is 2.36 nm, against a
        # limit of 4.00 nm in the box built from the measured padding (1.754).
        #
        # A boxpad.gs that exists but whose first token is not a number, an empty
        # file included, is a failed measurement, not an absent one: it is removed
        # (the finished probe replicas are kept and a re-run measures again) and
        # the structure stops as PROBE_FAIL rather than falling back to a constant.
        # Carriage returns are dropped first, so a value written by hand with DOS
        # line ends is read as the number it is.
        BOXPAD_FALLBACK=1.8
        BOXPAD_CAP=4.0
        RVDW=$(awk -F= '/^ *rvdw *=/{gsub(/[ \t]/,"",$2); print $2; exit}' $MDP_DIR/${FE_LEG_MDPS[0]})
        [[ -z "$RVDW" ]] && RVDW=1.0
        FLOOR=$(awk -v r="$RVDW" -v p="$PULL_DIST" 'BEGIN{printf "%.2f", r/2 + p/2}')
        if [[ -f boxpad.gs ]]; then
          WANT=$(head -n 1 boxpad.gs 2>/dev/null | tr -d '\r' | awk '{print $1; exit}')
          if ! [[ "$WANT" =~ ^[0-9]*[.]?[0-9]+$ ]]; then
            echo "Stage 0 failed: boxpad.gs holds no padding (first token '$WANT'); removed for re-measurement."
            rm -f boxpad.gs
            echo $STRUCT_ID "PROBE_FAIL" >> ../results_0.gs
            exit 0
          fi
          if awk -v w="$WANT" -v f="$FLOOR" 'BEGIN{exit !(w + 0 < f + 0)}'; then
            BOXPAD=$FLOOR
            echo "Box padding: -d $BOXPAD nm; boxpad.gs measured $WANT, clamped UP to the floor $FLOOR."
          elif awk -v w="$WANT" -v c="$BOXPAD_CAP" 'BEGIN{exit !(w + 0 > c + 0)}'; then
            BOXPAD=$BOXPAD_CAP
            echo "Box padding: -d $BOXPAD nm; boxpad.gs measured $WANT, clamped DOWN to the cap $BOXPAD_CAP."
          else
            BOXPAD=$WANT
            echo "Box padding: -d $BOXPAD nm, measured (boxpad.gs)."
          fi
        else
          BOXPAD=$(awk -v f="$FLOOR" -v d="$BOXPAD_FALLBACK" 'BEGIN{printf "%.2f", (f>d)?f:d}')
          echo "Box padding: -d $BOXPAD nm, NOT measured (no boxpad.gs; floor $FLOOR, fallback $BOXPAD_FALLBACK)."
        fi
        echo "$BOXPAD" > boxpad_used.gs
        gmx editconf -f emin_vac.gro -o box.gro -bt dodecahedron -d $BOXPAD
      fi
      if [[ ! -f box_solv.gro ]]; then
        gmx solvate -cp box.gro -cs $WATER_BOX -o box_solv.gro -p topol.top
        # gmx solvate appends SOL inside [ intermolecular_interactions ] — fix by moving it back to end
        python3 ../../utils/fix_topol_intermolecular.py -p topol.top
      fi
      if [[ ! -f ions.tpr ]]; then
        gmx grompp -r box_solv.gro -f $MDP_DIR/emin_vac.mdp -c box_solv.gro -o ions.tpr -maxwarn 2
      fi
      if [[ ! -f solv_ions.gro ]]; then
        echo -e "SOL\n" | gmx genion -s ions.tpr -o solv_ions.gro -p topol.top -pname NA -nname CL -conc 0.15 -neutral
        # gmx genion modifies [ molecules ] — fix topology ordering again
        python3 ../../utils/fix_topol_intermolecular.py -p topol.top
      fi
      if [[ ! -f emin_solv_sd.tpr ]]; then
        gmx grompp -r solv_ions.gro -f $MDP_DIR/emin_solv.mdp -c solv_ions.gro -o emin_solv_sd -maxwarn 2
      fi
      if [[ ! -f emin_solv_sd.gro ]]; then
        run_bg gmx mdrun -nt $nt $GPUOPT -deffnm emin_solv_sd
      fi
      # Conjugate gradient refinement (resolves clashes that SD can't escape)
      if [[ ! -f emin_solv.tpr ]]; then
        gmx grompp -r solv_ions.gro -f $MDP_DIR/emin_solv_cg.mdp -c emin_solv_sd.gro -o emin_solv -maxwarn 2
      fi
      if [[ ! -f emin_solv.gro ]]; then
        run_bg gmx mdrun -nt $nt $GPUOPT -deffnm emin_solv
      fi
    elif [[ "$et" == "1" ]]; then
      echo "after equilibration entangled loops were found."
      echo $STRUCT_ID "ENTANGLED" >> ../results_0.gs
      exit 0
    else
      echo "Stage 0 failed: entanglement check returned unexpected output ('$et')."
      echo $STRUCT_ID "FAILED" >> ../results_0.gs
      exit 0
    fi
  else
    # Restart: emin_solv.gro already exists, so stage 0 completed earlier (an
    # entangled structure would have exited before solvation). Re-emit the status;
    # if emin_vac.gro is gone, trust the finished setup rather than empty -> "OK".
    if [[ ! -f emin_vac.gro ]]; then
      echo $STRUCT_ID "OK" >> ../results_0.gs
    else
      et=$(python3 ../../utils/check_entangledloops.py -f emin_vac.gro -m chain_map.gs)
      if [[ "$et" == "1" ]]; then
        echo "entangled loops were found."
        echo $STRUCT_ID "ENTANGLED" >> ../results_0.gs
        exit 0
      else
        echo "no entangled loops were found."
        echo $STRUCT_ID "OK" >> ../results_0.gs
      fi
    fi
  fi

  # Create index file with custom clustering group
  # !Water group for output (protein, ions, ligands, counterions)
  # Protein_Struct group for centering: Protein + structural ions + ligands (no counterions)
  echo -e "! \"Water\"\nq\n" | gmx make_ndx -f emin_solv.gro -o index.ndx
  python3 ../../utils/make_cluster_group.py -f emin_solv.gro -n index.ndx

  # NO PRODUCTION EQUILIBRATION HERE. The restraint reference comes from the
  # PROBE run, which is the only equilibration this setup performs.
  #
  # There used to be a second one: an NVT ladder plus an NPT leg in the
  # production box, whose sole surviving product was the reference structure.
  # It equilibrated the same solute the probe had already equilibrated for
  # 11 ns, because the production box is built from emin_vac.gro and so starts
  # from the vacuum-minimised structure again. That is roughly 21 ns per
  # structure to produce one reference.
  #
  # Nothing else consumed it. Every cycle runs its OWN nvt_1..5_c<n> ladder and
  # its own npt_c<n> from emin_solv.gro with fresh velocities, and that is
  # deliberate: repeating the same equilibration per cycle with different seeds
  # is how the bound-state ensemble the Crooks analysis samples is generated.
  # Pre-equilibrating the production system once would not add to that ensemble,
  # which is why the production box is still built from emin_vac.gro.
  #
  # The reference itself is box-independent: it is a set of solute-solute
  # distances and angles, and the solute atom numbering is identical between the
  # probe and production systems (solvate appends water after the solute, and
  # genion replaces waters, never solute atoms).
  if [[ ! -f npt_probe_whole.gro ]]; then
    echo -e "0\n" | gmx trjconv -f npt_probe.gro -s npt_probe.tpr -o npt_probe_whole.gro -pbc whole
  fi
  if [[ ! -f npt_probe_whole.gro ]]; then
    echo "Stage 0 failed: trjconv -pbc whole produced no npt_probe_whole.gro."
    echo $STRUCT_ID "TRJCONV_FAIL" >> ../results_0.gs
    exit 0
  fi
  # THE REFERENCE FRAME IS ASSEMBLED IN SPACE, NOT CLUSTERED. npt_probe_cluster.gro
  # is what every restraint below is built on: make_boresch.py takes the interface
  # candidates, the elastic network and the anchor groups from it, and the snapshot
  # Boresch geometry for its pose gate, the gate's fallback and the readback (the
  # reference it emits is the ensemble mean over the probe replicas unless the gate
  # fires). It used to come from trjconv -pbc cluster, which chains the unbonded
  # fragments of a cutout one atom after the other, each at the minimum image of
  # the one before, so a step between fragments longer than half the box puts the
  # next fragment, and every one after it, a box vector away. On the real 1IJK
  # setup three of five ligand fragments sat a box vector off (NME299 -> ACE300 is
  # 7.28 nm in a 9.90 nm probe box), and with interface candidates taken from raw
  # distances 720 of 1108 contact pairs got no spring; 2AJF and the pilot structure
  # 1AKJ are near the same limit (review FR1). assemble_frame.py joins whole residues
  # of Protein_Struct along a minimum spanning tree of minimum-image links
  # (pbc_tools.assemble, as in measure_box.py, interface_qc.py and rebound_rmsd.py),
  # moving them by lattice vectors only, and leaves the box and every other atom as
  # they are. Rebuilt on every setup pass, since it is deterministic and takes
  # seconds, so a frame clustered by older code is never reused.
  rm -f npt_probe_cluster.tmp.gro
  python3 ../../utils/assemble_frame.py -f npt_probe_whole.gro -n index_probe.ndx \
      -g Protein_Struct -o npt_probe_cluster.tmp.gro
  AF_RC=$?
  if [[ $AF_RC -ne 0 || ! -s npt_probe_cluster.tmp.gro ]]; then
    echo "Stage 0 failed: assemble_frame.py exited $AF_RC and gave no assembled npt_probe_cluster.gro"
    echo "  (its reason is the line above)."
    echo $STRUCT_ID "ASSEMBLE_FAIL" >> ../results_0.gs
    rm -f npt_probe_cluster.tmp.gro
    exit 0
  fi
  mv npt_probe_cluster.tmp.gro npt_probe_cluster.gro
  # The .pdb is only for looking at, made from the assembled frame so that it shows
  # what the restraints were built on: every atom but the water.
  rm -f npt_probe_cluster.pdb
  echo -e "! \"Water\"\n" | gmx trjconv -f npt_probe_cluster.gro -s npt_probe.tpr \
      -o npt_probe_cluster.pdb -n index_probe.ndx

  # Generate the FE pull configuration (interface + Boresch + elastic network)
  # from the equilibrated reference structure. make_boresch.py appends the full
  # pull block to each leg .mdp and emits the analytical Boresch term.
  echo "Generating FE restraints (interface + Boresch + elastic network)."
  # npt_c_fe.mdp goes with the leg mdps: make_boresch.py appends the elastic
  # network to it, and every cycle's npt_c runs this copy (see the cycle phase).
  for m in "${FE_LEG_MDPS[@]}" npt_c_fe.mdp; do cp "$MDP_DIR/$m" ./ ; done
  # Write to a temp name and promote on success. Redirecting straight into
  # numpertres.gs meant a crashed make_boresch.py still created the file the
  # checks below look for, 0 bytes and indistinguishable from a real result.
  # Geometry from the production reference (-f), fluctuations from the probe run
  # (--traj/--tpr). They are separate inputs by design: the reference COM of every
  # anchor group comes from -f, while eps and the frame-rotation check come from
  # the trajectory, and both are insensitive to which box the trajectory was run
  # in. Solute atom numbering is identical between the two systems, only the
  # solvent count differs, so the atom-number mapping holds.
  # The probe is the only equilibration, so there is no second trajectory to fall
  # back to. make_boresch degrades to the burial heuristic on its own if the
  # trajectory is missing or too short, and says so on stderr.
  # EVERY replica, pooled. make_boresch concatenates their second halves before
  # measuring anything, so eps, the anchor ranking, the frame-rotation check, the
  # interface references and the Boresch geometry are all ensemble quantities.
  BOR_TRAJ=(); BOR_TPR=()
  for rep in $(seq 1 $N_PROBES); do
    [[ -f npt_probe${rep}.xtc ]] && { BOR_TRAJ+=(npt_probe${rep}.xtc); BOR_TPR+=(npt_probe${rep}.tpr); }
  done
  # A directory set up before the replicas existed still has the single pair, and
  # is measured on it exactly as it was.
  if [[ ${#BOR_TRAJ[@]} -eq 0 ]]; then
    BOR_TRAJ=(npt_probe.xtc); BOR_TPR=(npt_probe.tpr)
  fi
  echo "make_boresch will pool ${#BOR_TRAJ[@]} probe replica(s): ${BOR_TRAJ[*]}"
  # --index takes BOTH indexes: the generated a_*/bor_* groups are solute atom
  # numbers, valid in either system, and the legs run with index.ndx while the
  # readback grompps in the probe system that -f actually came from.
  # Total interface stiffness, if this run directory pinned one. groscore_fe.py
  # remembers it in run_config.gs exactly as it remembers numruns, so two runs can
  # differ in it without either editing tracked code, and every structure in one
  # directory is built at the same value. Absent, make_boresch.py applies its own
  # default and records whatever it used in boresch_analytical.gs either way.
  # Clear the marker from any PREVIOUS attempt. It is written by make_boresch's
  # abort path and read below to decide whether setup failed, so a stale one makes
  # a retry that SUCCEEDS still report BORESCH_FAIL -- the run then dies with a
  # complete, correct restraint set sitting on disk. The only other place it is
  # removed is the full stale-setup cleanup, which also deletes every probe
  # replica, so that path is not a fix for a re-run: it is 100 ns of resimulation.
  rm -f boresch_failed.gs
  SUM_K=$(awk '$1=="sum_k"{print $2; exit}' ../run_config.gs 2>/dev/null)
  SUM_K_OPT=""
  if [[ -n "$SUM_K" ]]; then
    SUM_K_OPT="--sum-k $SUM_K"
    echo "Interface restraint budget pinned by run_config.gs: sum_k = $SUM_K kJ/mol/nm^2"
  fi
  # The width ceiling travels the same way and for a sharper reason: sum_k scales
  # the springs, sd_max decides which of them exist at all, so a directory that
  # built half its cycles at one value and half at another has two different bound
  # legs pooled into one number. groscore_fe.py records it on every invocation, so
  # an absent line means a directory from before it was remembered; make_boresch's
  # own default then applies, which is what those cycles were built with anyway.
  SD_MAX=$(awk '$1=="sd_max"{print $2; exit}' ../run_config.gs 2>/dev/null)
  SD_MAX_OPT=""
  if [[ -n "$SD_MAX" ]]; then
    SD_MAX_OPT="--sd-max $SD_MAX"
    echo "Interface spring width ceiling pinned by run_config.gs: sd_max = $SD_MAX nm"
  fi
  python3 ../../utils/make_boresch.py -f npt_probe_cluster.gro -m chain_map.gs -T $REF_T \
      --pull-dist $PULL_DIST --pull-rate 0.00005 \
      --traj "${BOR_TRAJ[@]}" --tpr "${BOR_TPR[@]}" \
      --index index.ndx index_probe.ndx \
      --topol topol_probe.top --readback-index index_probe.ndx \
      --box-from emin_solv.gro $SUM_K_OPT $SD_MAX_OPT > numpertres.tmp
  MB_RC=$?
  # make_boresch.py stopped on purpose: flag the structure and stop. Every one of
  # its aborts writes the reason as the first line of boresch_failed.gs, and only
  # some of them are about the anchors: NPT_C_MDP_MISSING, LEG_MDP_MISSING,
  # PROTOCOL_BLOCK_MISSING/INVALID and PULL_DIST_MISMATCH are about the checkout,
  # INPUT_FRAME_SPLIT about the reference frame. A fixed "anchor selection failed"
  # made a checkout without npt_c_fe.mdp read as an anchor failure of every
  # structure (review CYC-6), so the reason is printed as written.
  if [[ -f boresch_failed.gs ]]; then
    BF_REASON=$(head -n 1 boresch_failed.gs | tr -d '\r')
    echo "Stage 0 failed: make_boresch.py stopped with ${BF_REASON:-no reason recorded}"
    echo "  (boresch_failed.gs; its message is the 'make_boresch: ERROR' line above)."
    echo $STRUCT_ID "BORESCH_FAIL" >> ../results_0.gs
    rm -f numpertres.tmp
    exit 0
  fi
  # The exit status and the size must both be checked. The graceful failure path
  # prints "0" and writes its marker above, so a size test alone reads it as a
  # result; an uncaught exception writes no marker at all, so a marker test alone
  # reads it as success. That combination is what released 50 cycles against
  # .mdp files whose pull block had never been appended.
  if [[ $MB_RC -ne 0 || ! -s numpertres.tmp ]]; then
    echo "Stage 0 failed: make_boresch.py exited $MB_RC (see the traceback above)."
    echo $STRUCT_ID "BORESCH_FAIL" >> ../results_0.gs
    rm -f numpertres.tmp
    exit 0
  fi
  mv numpertres.tmp numpertres.gs
  # Record the analytical Boresch standard-state term (dG_release, kJ/mol) at the
  # top level so groscore_fe.py can read it without unpacking archives.
  # One idempotent file per structure, rewritten on every setup: gating this on a
  # marker inside the structure directory made it unrecoverable if the top-level
  # record was ever removed -- the marker said "already recorded" while the value
  # was gone, and every structure then scored as PENDING with no dG at all.
  if [[ -f boresch_analytical.gs ]]; then
    DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
    mkdir -p ../results_analytical.d
    echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
  fi

  # Post-condition before the marker goes down. setup.done is the only gate the
  # cycles honour, and groscore_fe.py skips the setup job entirely when it is
  # present, so touching it unconditionally does not merely mislabel a failure:
  # it makes the directory unrecoverable, because no later run will redo setup.
  # Check the artefacts the cycles actually consume. The .mdp test is a real
  # post-condition, since no shipped template contains pull-ngroups and
  # make_boresch.py writes it at column 0 for every leg it touches.
  SETUP_MISSING=""
  [[ -s numpertres.gs ]]         || SETUP_MISSING="$SETUP_MISSING numpertres.gs"
  [[ -s boresch_analytical.gs ]] || SETUP_MISSING="$SETUP_MISSING boresch_analytical.gs"
  [[ -s boresch_anchors.gs ]]    || SETUP_MISSING="$SETUP_MISSING boresch_anchors.gs"
  for m in "${FE_LEG_MDPS[@]}"; do
    grep -q '^pull-ngroups' "$m" 2>/dev/null || SETUP_MISSING="$SETUP_MISSING $m:pull-block"
  done
  # npt_c_fe.mdp ships with 'pull = yes' and no coordinates, which grompp refuses,
  # so make_boresch.py must have either appended the elastic network or switched
  # pull off for a structure without one. Neither means it never touched the file.
  if ! grep -q '^pull-ngroups' npt_c_fe.mdp 2>/dev/null \
     && ! grep -Eq '^pull[[:space:]]*=[[:space:]]*no([[:space:]]|;|$)' npt_c_fe.mdp 2>/dev/null; then
    SETUP_MISSING="$SETUP_MISSING npt_c_fe.mdp:elastic-network-block"
  fi
  if [[ -n "$SETUP_MISSING" ]]; then
    echo "Stage 0 failed: setup produced no usable restraints; missing or empty:$SETUP_MISSING"
    echo $STRUCT_ID "SETUP_FAIL" >> ../results_0.gs
    exit 0
  fi

  # Setup finished: record the protocol it was built for, then release any --cycle
  # tasks waiting on the marker. In that order, so a released task always finds the
  # record: a cycle runs only under the protocol its setup names (see the cycle
  # phase), and only a completed setup writes it.
  echo "$FE_PROTOCOL_ID" > protocol_id.gs
  touch setup.done
  echo "Setup complete for $STRUCT_ID (restraints defined, protocol $FE_PROTOCOL_ID)."
  if [[ "$MODE" == "setup" ]]; then
    exit 0
  fi
fi
# ===== END SETUP PHASE =================================================

# ===== CYCLE PHASE =====================================================
# A local force field with NCAA / FeS entries lives in the structure directory.
# The setup phase exports GMXLIB inside its own block, so re-export it here for
# --cycle tasks that skip that block, otherwise grompp cannot resolve the include.
if [[ -d amber19sb.ff ]]; then
  if [[ -n "${GMXLIB:-}" ]]; then
    export GMXLIB="$(pwd):${GMXLIB}"
  else
    export GMXLIB="$(pwd)"
  fi
fi

# Read NUMPERTRES for integration
if [[ ! -s numpertres.gs ]]; then
  echo "numpertres.gs is missing or empty; setup did not define the restraints."
  exit 1
fi
while read -r a b
do
  NUMPERTRES=$a
done < numpertres.gs

# Pull rate this structure was set up with. integrate.py turns the time integral
# of the pull force into work by multiplying by the rate, so it must match the
# rate written into the .mdp -- read it back rather than hard-coding, so cycles
# re-integrated later (backfill/repair) use the rate they were actually run at.
PULL_RATE=$(awk '$1=="pull_rate_nm_ps"{print $2}' boresch_analytical.gs 2>/dev/null)
if [[ -z "$PULL_RATE" ]]; then
  PULL_RATE=0.00005
fi

# Independent equilibration cycles
# Each cycle: a fresh equilibration (the NVT ladder and npt_c), then the legs of
# fe_protocol.legs() in order. Cycles are independent (each restarts from
# emin_solv.gro with new velocities), so they can run concurrently as separate
# array tasks.
# Total number of cycles wanted. GROSCORE_NUMCYCLES (exported by the generated
# SLURM script) takes precedence over run.gs so the total can be raised later to
# add cycles -- including for archived structures, whose run.gs cannot be
# rewritten from outside the tarball.
NUMCYCLES=${GROSCORE_NUMCYCLES:-$((MAXRUNS/2))}
if [[ "$MODE" == "cycle" ]]; then
  if [[ $CYCLE_ARG -gt $NUMCYCLES ]]; then
    echo "Cycle $CYCLE_ARG exceeds NUMCYCLES=$NUMCYCLES; nothing to do."
    exit 0
  fi
  CYCLE_START=$CYCLE_ARG
  CYCLE_END=$CYCLE_ARG
else
  CYCLE_START=1
  CYCLE_END=$NUMCYCLES
fi
  # A cycle must never be executed by two processes at once. It can happen with
  # no bug anywhere: kill a local runner and its gmx children survive as orphans,
  # then the next start re-queues that cycle (it has no complete result, which is
  # indistinguishable from "dead") and two mdruns write the same -deffnm files,
  # in place, at independent offsets. Nothing downstream can detect the resulting
  # garbage. Each cycle therefore takes its own lock, with take_lock (top of this
  # file), the same mkdir election and host:pid:job owner the setup lock uses.
  CYCLE_LOCK=""
  release_cycle_lock() {
    [[ -n "$CYCLE_LOCK" && -d "$CYCLE_LOCK" ]] && rm -rf "$CYCLE_LOCK"
    CYCLE_LOCK=""
  }
  # One set of traps for both locks, since a second `trap ... EXIT` replaces the
  # first. INT and TERM exit after releasing, for the reason at the setup lock:
  # this trap used not to, so a TERM let the cycle carry on, and in legacy mode
  # start the next cycle's legs, until the KILL that follows it.
  trap 'release_cycle_lock; release_job_lock' EXIT
  trap 'stop_leg; release_cycle_lock; release_job_lock; exit 130' INT
  trap 'stop_leg; release_cycle_lock; release_job_lock; exit 143' TERM

  claim_cycle() {
    local lock=results_fe_c$1.lock
    if take_lock "$lock"; then
      CYCLE_LOCK="$lock"
      return 0
    fi
    echo "Cycle $1: already running elsewhere (owner $LOCK_OWNER) - skipping."
    echo "  If that job is gone and squeue cannot say so, remove $lock by hand."
    return 1
  }

  # Every leg must leave its own .gro. A leg that dies leaves no .gro but it does
  # leave a checkpoint, and the next grompp reads that checkpoint quite happily,
  # which is how a crashed 5 ns hold once produced a full set of works from a
  # state the simulation never reached: eight cycles were recorded as complete
  # with holds of 1946 to 4676 ps. Checking between legs stops a failure from
  # propagating into plausible-looking numbers instead of stopping the cycle.
  require_gro() {
    [[ -f "$1.gro" ]] && return 0
    echo "Cycle $cycle FAILED: leg $1 produced no $1.gro (see $1.log)."
    echo "  Skipping the rest of this cycle. The next run will retry it."
    return 1
  }

  # eq_stage OUT MDP FROM TIMEOUT [grompp options]: one stage of the cycle's
  # equilibration, run unless it has its .gro. FROM is the stage it continues ('' =
  # start from emin_solv.gro with the mdp's fresh velocities); its checkpoint is read
  # only once FROM has its .gro. The tpr is built anew each time and the stage runs
  # from step 0 (run_leg_mdrun), so a stage that died is never continued, and no
  # stage is ever built from one that did not finish. The ladder used to grompp each
  # stage from the checkpoint of the one before whether that had finished or not.
  eq_stage() {
    local out=$1 mdp=$2 from=$3 tmo=$4; shift 4
    [[ -f $out.gro ]] && return 0
    rm -f $out.tpr
    if [[ -n "$from" ]]; then
      require_gro $from || return 1
      gmx grompp -r emin_solv.gro -f $mdp -c $from.tpr -t $from.cpt -p topol.top -o $out "$@" -maxwarn 10
    else
      gmx grompp -r emin_solv.gro -f $mdp -c emin_solv.gro -p topol.top -o $out "$@" -maxwarn 10
    fi
    run_leg_mdrun $out $tmo
    require_gro $out
  }


  CYCLE_FAILED=0
  cycle=$CYCLE_START
  while [[ $cycle -le $CYCLE_END ]]; do
    if ! claim_cycle $cycle; then
      cycle=$((cycle+1))
      continue
    fi
    echo "=== FE cycle $cycle of $NUMCYCLES ==="

    # NO CYCLE RUNS ON A SETUP OF ANOTHER PROTOCOL. A setup writes the leg mdps,
    # npt_c_fe.mdp and the restraints for the protocol it was built under, and
    # records that protocol in protocol_id.gs when it completes. A cycle with
    # anything left to run goes on only if the record names the protocol this code
    # runs (fe_protocol.PROTOCOL_ID). The check covers every leg, not only npt_c, so
    # a cycle that had finished npt_c or any later leg under an older setup cannot
    # go on into this protocol's legs: in a pre-v1.5 directory run in legacy mode, or
    # set up again after its setup.done was removed, the unfinished v1.4 cycles went
    # on from their old checkpoints, an npt_c without the elastic network and a
    # boundrev2 resumed from a checkpoint that had started at the end of holdrev0,
    # and wrote valid-looking rows (review CYC-1).
    # npt_c then runs ./npt_c_fe.mdp, the structure's own copy that make_boresch.py
    # completed with the elastic network, and there is no fallback to the settings
    # tree's npt_fe.mdp: that would run the old, network-free npt_c without a word.
    # A cycle whose legs are all done still integrates below, so the results of an
    # old directory can be recomputed; groscore_fe.py records the protocol of a run
    # directory in run_config.gs.
    CYCLE_TODO=0
    [[ -f npt_c${cycle}.gro ]] || CYCLE_TODO=1
    for _leg in "${FE_LEGS[@]}"; do
      [[ -f ${_leg}_${cycle}.gro ]] || CYCLE_TODO=1
    done
    if [[ $CYCLE_TODO -eq 1 ]]; then
      SETUP_ID=$(head -n 1 protocol_id.gs 2>/dev/null | tr -d '[:space:]')
      WHY=""
      if [[ -z "$SETUP_ID" ]]; then
        WHY="this directory has no protocol_id.gs, so its setup predates v1.5 (or the record was deleted)"
      elif [[ "$SETUP_ID" != "$FE_PROTOCOL_ID" ]]; then
        WHY="this directory was set up for protocol $SETUP_ID, and this code runs $FE_PROTOCOL_ID"
      elif [[ ! -f npt_c_fe.mdp ]]; then
        WHY="./npt_c_fe.mdp is missing, although protocol_id.gs says the setup completed under this protocol"
      fi
      if [[ -n "$WHY" ]]; then
        echo "Cycle $cycle FAILED: $WHY."
        echo "  Set this structure up again in a fresh directory: its probe, box, ligands"
        echo "  and restraints all belong to that setup."
        if [[ "$SETUP_ID" != "$FE_PROTOCOL_ID" ]]; then
          echo "  Removing setup.done does not help: a setup run again here would rebuild"
          echo "  only the restraints, so it refuses to run beside cycles it did not start."
        fi
        CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue
      fi
    fi

    # Full equilibration for this cycle (NVT 1-5 + NPT), one eq_stage each.
    #
    # npt_c is the bound-state ensemble boundfwd starts from, and Crooks assumes
    # those initial states are drawn from the true equilibrium distribution, so
    # this leg has to run under a barostat that has one. C-rescale does, and
    # being first order it also settles the box off the NVT ladder without a
    # separate weak-coupling stage.
    #
    # It must also run the Hamiltonian boundfwd1 starts with, H(lambda = 0) of
    # the bound block, and that includes the elastic network. Through v1.4 it
    # ran $MDP_DIR/npt_fe.mdp with no pull code at all: the network came on at
    # full strength at t = 0 of boundfwd1, a median 299 kJ/mol never recorded,
    # and 20 of 920 pass-2 cycles died at the boundfwd1 grompp on a network pair
    # that had drifted beyond 0.49 times the box during the 20 ns
    # (bm_fe_amber_2/_ana/digest/fu3.txt F10, qc.txt npt_c_elastic_network_off).
    #
    # 600m, not the 60m every short stage uses: npt_c runs ./npt_c_fe.mdp for
    # 20 ns (it was 1 ns, then 10). Since a retry starts from step 0, the limit
    # must hold a whole npt_c on the slowest node; the longest measured was
    # 457.6 min (1OPH npt_c11, 275k atoms, bm_fe_amber_3a).
    if [[ ! -f npt_c${cycle}.gro ]]; then
      echo "Running full equilibration for cycle $cycle"
      if ! { eq_stage nvt_1_c${cycle} $MDP_DIR/nvt_1.mdp "" 60m \
             && eq_stage nvt_2_c${cycle} $MDP_DIR/nvt_2.mdp nvt_1_c${cycle} 60m \
             && eq_stage nvt_3_c${cycle} $MDP_DIR/nvt_3.mdp nvt_2_c${cycle} 60m \
             && eq_stage nvt_4_c${cycle} $MDP_DIR/nvt_4.mdp nvt_3_c${cycle} 60m \
             && eq_stage nvt_5_c${cycle} $MDP_DIR/nvt_5.mdp nvt_4_c${cycle} 60m -n index.ndx \
             && eq_stage npt_c${cycle} ./npt_c_fe.mdp nvt_5_c${cycle} 600m -n index.ndx; }; then
        CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue
      fi
    fi

    require_gro npt_c${cycle} || { CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue; }

    # === The FE legs, driven by utils/fe_protocol.py ===
    #
    # The sequence is NOT written out here. It is emitted by fe_protocol.py, which
    # is the single definition of the cycle, so the runner cannot fall out of step
    # with the mdps make_fe_mdps.py generated from the same table. The ramp has
    # been reshaped three times; each time it was four hardcoded lists.
    #
    # Every leg continues from the previous leg's checkpoint, so lambda and the
    # pull references stay continuous around the whole cycle, except where
    # FE_LEG_FROM names another leg of the same cycle to start from. That is
    # boundrev2, which branches from the end of holdfwd0: the reverse bound legs
    # start from the forward handoff state, relaxed under their own end-state
    # Hamiltonian, rather than from the strained rebound interface the reverse ramp
    # leaves (fe_protocol.legs() has the measurement). The source is named by file,
    # so a restart that skips the finished legs still branches from the right one.
    # Switching stages write a pull-force xvg (-pf) and a dhdl xvg (-dhdl), the bound
    # legs a dhdl xvg. Holds get neither option, since they carry rate 0 and
    # delta-lambda 0 and so do no work, but mdrun -deffnm still writes their
    # dH/dlambda to <hold>_<cycle>.xvg, which fe_xvgs keeps.
    LEG_FAILED=0
    prev=npt_c${cycle}
    for li in "${!FE_LEGS[@]}"; do
      leg="${FE_LEGS[$li]}"
      mdp="${FE_LEG_MDP[$li]}"
      out="${leg}_${cycle}"
      src=$prev
      [[ -n "${FE_LEG_FROM[$li]}" ]] && src="${FE_LEG_FROM[$li]}_${cycle}"
      if [[ ! -f ${out}.gro ]]; then
        # The checkpoint of $src is read only once $src has finished (its .gro), and
        # the tpr is built anew, so a failed grompp leaves none for mdrun to run.
        if [[ ! -f ${src}.gro || ! -f ${src}.tpr || ! -f ${src}.cpt ]]; then
          echo "Cycle $cycle FAILED: leg $leg starts from $src, but ${src}.gro, ${src}.tpr or ${src}.cpt is missing."
          LEG_FAILED=1; break
        fi
        rm -f ${out}.tpr
        gmx grompp -r emin_solv.gro -f "$mdp" -c ${src}.tpr -t ${src}.cpt \
                   -p topol.top -o ${out} -n index.ndx -maxwarn 10
        xtra=()
        [[ "${FE_LEG_PULL[$li]}" == "1" ]] && xtra+=(-pf ${out}_pullf.xvg)
        [[ "${FE_LEG_DHDL[$li]}" == "1" ]] && xtra+=(-dhdl ${out}_dhdl.xvg)
        # 180m is nine times the longest switching leg ever measured here
        # (20.4 min), so it cannot cut a slow node short, but it does stop a hung
        # mdrun from eating the whole 72 h wall clock in silence. Before this the
        # FE legs carried no timeout at all.
        run_leg_mdrun ${out} 180m "${xtra[@]}"
      fi
      if ! require_gro ${out}; then LEG_FAILED=1; break; fi
      prev=${out}
    done
    if [[ $LEG_FAILED -eq 1 ]]; then
      CYCLE_FAILED=1; release_cycle_lock; cycle=$((cycle+1)); continue
    fi

    # --- Work integration: one results_fe.d/<ID>_c<N>.gs row per completed cycle ---
    # The row is FE_RESULT_NF = 43 fields: STRUCT_ID, cycle, the 40 works named by
    # FE_WORK_FIELDS in that order, and RMSD_A (works in kJ/mol; groscore_fe.py
    # combines them via the thermodynamic cycle. RMSD_A is the rebinding check, in
    # Angstrom, see below.)
    # Recompute whenever this cycle's result file is missing or still holds NaN --
    # not merely when the cycle is new. Two cases the .done marker alone misses:
    #   * a cycle finished by an earlier run has its values only in the legacy
    #     results_fe.gs, so results_fe.d/ would stay empty for it;
    #   * a cycle whose legs failed wrote NaNs and marked itself done, so the
    #     values were never repaired after the legs were re-run.
    # Integration is cheap (the .xvg.gz are kept), so this backfills in seconds.
    RESFILE=../results_fe.d/${STRUCT_ID}_c${cycle}.gs
    # A stored result counts as final only if it is a complete line of the CURRENT
    # width whose every work value is numeric; anything else (missing, truncated by
    # a failed integration, NaN from a leg that had not finished, or a narrower
    # line from before the ramp was split) is recomputed.
    #
    # The range is 3 .. NF-1, i.e. DERIVED, and the width is required to be exactly
    # FE_RESULT_NF. It used to be the literal 3..8 with NF>=9, which was correct for
    # a 9-field row and quietly wrong the moment the row grew to 13: the last four
    # works, the whole of rebinding stage A and the restraint-removal leg, fell
    # outside the window. A cycle that lost them was still marked .done, still
    # counted toward the requested total, and still let the structure archive --
    # after which read_works drops the row for those very NaNs and the cycle is
    # gone for good. Field NF is the rebinding RMSD, which is diagnostic only, so a
    # cycle whose RMSD could not be computed is still a valid result.
    complete_row() {
      awk -v want="$FE_RESULT_NF" \
        'NR==1 && NF==want {ok=1; for(i=3;i<=NF-1;i++) if($i=="NaN"||$i=="nan") ok=0}
         END{exit !ok}' "$1"
    }
    NEEDS_RESULT=1
    if [[ -f $RESFILE ]] && complete_row $RESFILE; then
      NEEDS_RESULT=0
    fi
    if [[ $NEEDS_RESULT -eq 1 ]]; then
      for w in $(fe_xvgs); do
        [[ ! -f ${w}.xvg && -f ${w}.xvg.gz ]] && gunzip ${w}.xvg.gz
      done
      # Never let a failed integration (crash, missing module, empty output) turn
      # a field into an empty string: that silently writes a short line which no
      # NaN check would ever flag for repair. Fall back to NaN so the row keeps its
      # FE_RESULT_NF fields and is retried on the next run.
      integrate_or_nan() {
        local out
        out=$("$@" 2>/dev/null) || out=""
        [[ -z "$out" ]] && out="NaN"
        printf '%s' "$out"
      }
      # Each stage is integrated at ITS OWN pull rate, read back from
      # boresch_analytical.gs. integrate.py turns the time integral of the pull
      # force into work by multiplying by the rate, so integrating stage B at
      # stage A's rate would rescale it by 7. One constant used to cover the whole
      # leg; with a split leg it cannot.
      # integrate.py wants the magnitude (the direction is carried by
      # groscore_fe.py's SIGN_PULL_FWD/REV), and printf rather than passing the
      # field through keeps one output format whichever sign is stored.
      rate_of() {
        awk -v n="$1" '$1=="stage_rate_nm_ps" && $2==n {printf "%.10g", ($3<0?-$3:$3); exit}' \
            boresch_analytical.gs
      }
      # The lambda span of a leg, read from the mdp it actually ran with.
      # integrate_dhdl.py rebuilds the ramp from --direction alone, which assumes
      # the leg spans the WHOLE of lambda: a stage crossing only 0 -> 0.3 would be
      # integrated over 1.0 and come out 3.3x too large with nothing to show for
      # it. --leg-ps goes with it because mdrun writes dhdl on multiples of nstdhdl
      # and does not force a final row at nsteps, so a leg whose nsteps is not a
      # multiple would otherwise have its ramp stretched onto the rows it did
      # record.
      # The values are attached with '=', and a lambda within 1e-9 of zero is
      # snapped to it. Both guard the same failure, which cost test5 all 47 of
      # its cycles.
      #
      # delta-lambda is written to the mdp with %.8e, so a stage that should land
      # exactly on lambda = 0 lands on the rounding residue instead: bindrevA
      # came out at -2.500000207e-11. Passed as a separate argv entry, argparse
      # only accepts a leading-dash token as a NEGATIVE NUMBER if it matches
      # ^-\d+$ or ^-\d*\.\d+$ -- an exponent does not match -- so it read
      # "-2.500000207e-11" as an option name and died with "expected one
      # argument". integrate_or_nan then wrote NaN, every row carried one, and
      # read_works dropped all 47 cycles. The leg that ends at zero is the only
      # one exposed, which is why it survived three previous runs.
      lam_span() {
        # The +0 on every assignment is load-bearing. gsub() turns a field into a
        # plain STRING, losing the "numeric-looking input" status awk uses to
        # decide comparison type, so z("1") would compare "1" against "1e-09"
        # LEXICALLY, find it smaller, and snap init-lambda = 1 to 0. Forcing
        # numeric at assignment keeps every later comparison arithmetic.
        awk -F= '
          function z(x) { return (x < 1e-9 && x > -1e-9) ? 0 : x }
          /^ *init-lambda *=/  {gsub(/[ \t]/,"",$2); i=$2+0; have_i=1}
          /^ *delta-lambda *=/ {gsub(/[ \t]/,"",$2); d=$2+0; have_d=1}
          /^ *nsteps *=/       {gsub(/[ \t]/,"",$2); n=$2+0; have_n=1}
          /^ *dt *=/           {gsub(/[ \t]/,"",$2); t=$2+0; have_t=1}
          END { if (!have_i || !have_d || !have_n || !have_t) exit 1
                printf "--lambda-start=%.10g --lambda-end=%.10g --leg-ps=%.10g",
                       z(i), z(i + d*n), n*t }' "$1"
      }
      # The mdp a leg ran with, looked up by leg name.
      mdp_of() {
        local i
        for i in "${!FE_LEGS[@]}"; do
          [[ "${FE_LEGS[$i]}" == "$1" ]] && { printf '%s' "${FE_LEG_MDP[$i]}"; return; }
        done
      }

      # NOTHING IS GUESSED. Both the rate and the lambda span multiply the work, so
      # a substituted value produces a wrong number that looks exactly like a right
      # one: the old code could fall back to a single $PULL_RATE because there was
      # one rate for the whole leg, and with stages that constant is right for none
      # of them. A rate or span that cannot be read leaves its work at NaN, which
      # the completeness gate then refuses, so the cycle is redone rather than
      # silently believed.
      declare -A W
      for _rec in "${FE_WORKS[@]}"; do
        IFS=: read -r _field _leg _chan _dir <<< "$_rec"
        W[$_field]="NaN"
        _f="${_leg}_${cycle}"
        if [[ "$_chan" == "pull" ]]; then
          _rate=$(rate_of "$_leg")
          if [[ -z "$_rate" ]]; then
            echo "ERROR: no stage_rate_nm_ps for $_leg in boresch_analytical.gs;" >&2
            echo "       $_field of cycle $cycle stays NaN rather than being" >&2
            echo "       integrated at a guessed rate." >&2
          elif [[ -f ${_f}_pullf.xvg ]]; then
            # Each interface reference follows its own chord of the pull path, so
            # the coordinates no longer share one rate and the summed force has to
            # be weighted before it becomes work. make_boresch.py writes one
            # weights file per leg. A structure set up before that change has no
            # such file and integrates unweighted, which is exactly what it ran.
            _wf=pull_weights_${_leg}.gs
            if [[ -f $_wf ]]; then
              W[$_field]=$(integrate_or_nan python3 ../../utils/integrate.py \
                           -f ${_f}_pullf.xvg -nr $NUMPERTRES -r $_rate -R $_wf)
            else
              W[$_field]=$(integrate_or_nan python3 ../../utils/integrate.py \
                           -f ${_f}_pullf.xvg -nr $NUMPERTRES -r $_rate)
            fi
          fi
        else
          _span=$(lam_span "$(mdp_of "$_leg")")
          if [[ -z "$_span" ]]; then
            echo "ERROR: could not read the lambda span for $_leg; $_field of cycle" >&2
            echo "       $cycle stays NaN rather than being integrated over 0 -> 1." >&2
          elif [[ -f ${_f}_dhdl.xvg ]]; then
            W[$_field]=$(integrate_or_nan python3 ../../utils/integrate_dhdl.py \
                         -f ${_f}_dhdl.xvg --direction $_dir $_span)
          fi
        fi
      done

      # Rebinding sanity check: backbone RMSD (Angstrom) between the bound state
      # this cycle was equilibrated in (npt_c$cycle) and the end of the reverse
      # ramp (LAST_STAGE, bindrevA_$cycle). A large value means the partners did
      # not return to the original pose. Since v1.5 no leg starts from that state
      # (boundrev2 branches from holdfwd0), so it marks a dissipative reverse ramp,
      # not a cycle that failed to close. Always computed, never fatal:
      # groscore_fe.py flags it (see --rmsd-warn).
      RMSD="NaN"
      LAST_STAGE=""
      for _i in "${!FE_LEGS[@]}"; do
        [[ "${FE_LEG_PULL[$_i]}" == "1" ]] && LAST_STAGE="${FE_LEGS[$_i]}"
      done
      if [[ -f npt_c${cycle}.gro && -f ${LAST_STAGE}_${cycle}.gro ]]; then
        RMSD=$(integrate_or_nan python3 ../../utils/rebound_rmsd.py \
                 --ref npt_c${cycle}.gro --query ${LAST_STAGE}_${cycle}.gro \
                 -s emin_solv.tpr -n index.ndx --tag c${cycle})
        echo "Cycle $cycle rebound backbone RMSD: $RMSD A"

        # The backbone RMSD says the partners are in roughly the right place. It
        # says nothing about whether the CONTACTS re-formed or the interface side
        # chains re-packed, which is what the interface restraints exist to hold
        # and therefore what capping the restraint list per contact could damage.
        # Measured so that a reduction can be tested rather than argued.
        #
        # Written to its own file, NOT appended to the result row: read_works
        # decodes the number of bound sub-legs and ramp stages from the row width
        # (groscore_fe.py _layout), and two extra fields would match no layout and
        # silently reject every row.
        if [[ -f interface_contacts.gs ]]; then
          mkdir -p ../results_qc.d
          IQC=$(python3 ../../utils/interface_qc.py -c interface_contacts.gs \
                  --ref npt_c${cycle}.gro --query ${LAST_STAGE}_${cycle}.gro 2>/dev/null)
          if [[ -n "$IQC" ]]; then
            echo "$STRUCT_ID $cycle $IQC" > ../results_qc.d/${STRUCT_ID}_c${cycle}.gs
            echo "Cycle $cycle interface: $IQC"
          fi
        fi
      fi
      # One file per cycle rather than appending to a shared results_fe.gs: with
      # cycles running as parallel array tasks, many writers would race on the
      # same file. groscore_fe.py merges results_fe.d/ with any legacy file.
      mkdir -p ../results_fe.d
      # The row is FE_RESULT_NF = 43 fields: STRUCT_ID, cycle, the 40 works of
      # FE_WORK_FIELDS (two bound sub-legs and nine ramp stages per direction, a
      # pull and a dhdl work per stage) and RMSD_A. The stages are stored
      # SEPARATELY on purpose: summing them recovers the unstaged work exactly, so
      # nothing is lost, but separate storage also allows the staged estimate that
      # the intermediate holds exist to make possible. groscore_fe.py does both.
      _row="$STRUCT_ID $cycle"
      for _f in "${FE_WORK_FIELDS[@]}"; do _row="$_row ${W[$_f]}"; done
      echo "$_row $RMSD" > $RESFILE
      # The gate below trusts FE_RESULT_NF to be the width this line has. Assert
      # it here rather than discovering the mismatch as silently-dropped cycles.
      _nf=$(awk 'NR==1{print NF}' $RESFILE)
      if [[ "$_nf" != "$FE_RESULT_NF" ]]; then
        echo "ERROR: result row has $_nf fields, FE_RESULT_NF says $FE_RESULT_NF." >&2
        echo "       Refusing to mark cycle $cycle done on a row the gate cannot check." >&2
        CYCLE_FAILED=1
      fi
      gzip -f $(fe_xvgs | sed 's/$/.xvg/') 2>/dev/null
      # Written last and ONLY for a complete cycle, so .done really does mean
      # "fully finished" -- the archive check below counts these, and a structure
      # that tarred itself up on the strength of half-finished cycles would be
      # unrecoverable. A cycle whose legs died partway writes its NaN row (so the
      # next run repairs it rather than re-simulating from scratch) but no marker,
      # and reports failure so the runner shows it instead of logging "done".
      if complete_row $RESFILE; then
        touch results_fe_c${cycle}.done
      else
        echo "Cycle $cycle FAILED: not every work is numeric, no .done written:"
        echo "  $(cat $RESFILE)"
        CYCLE_FAILED=1
      fi
    fi

    release_cycle_lock
    cycle=$((cycle+1))
  done

  # Report a partial cycle as a failure. Deferred to the end of the loop so that
  # legacy sequential mode still attempts every cycle rather than stopping at the
  # first bad one; in --cycle mode there is only one, so it is immediate.
  if [[ $CYCLE_FAILED -eq 1 ]]; then
    echo "At least one cycle finished without a complete result."
  fi

  # Archive completed structure to reduce inode count.
  # Only when EVERY cycle has finished -- with cycles running as parallel array
  # tasks, whichever task finishes last does the archiving. `mkdir` is atomic, so
  # it elects a single winner even if several tasks finish simultaneously (two
  # tasks tarring/deleting the same directory would be destructive).
  # Guard the rm behind a successful, non-empty tar so a killed/broken archive
  # can never delete the source directory (a 0-byte tar once wiped a structure).
  # The cycles counted are 1..NUMCYCLES, as in job.run: counting every .done, those
  # of cycles above the total from an earlier, larger -n made the first task of an
  # array that ended archive and remove the directory while the others still ran in
  # it (review S5).
  DONE_CYCLES=0
  for ((c = 1; c <= NUMCYCLES; c++)); do
    [[ -f results_fe_c$c.done ]] && DONE_CYCLES=$((DONE_CYCLES+1))
  done
  if [[ $NUMCYCLES -gt 0 && $DONE_CYCLES -eq $NUMCYCLES ]] && mkdir .archive.lock 2>/dev/null; then
    # Last chance to lift the analytical term out of the structure directory:
    # once this is a tarball, boresch_analytical.gs is unreachable to the scorer
    # and the structure would score PENDING forever despite having every cycle.
    if [[ -f boresch_analytical.gs ]]; then
      DGREL=$(awk '$1=="dG_release_kJ_mol"{print $2}' boresch_analytical.gs)
      mkdir -p ../results_analytical.d
      echo "$STRUCT_ID $DGREL" > ../results_analytical.d/${STRUCT_ID}.gs
    fi
    cd ..
    # A legacy job still holds job_run.lock here. It stays out of the archive: an
    # unpacked copy would carry an owner whose death another host cannot prove.
    if tar -czf "${STRUCT_ID}.tar.gz" --exclude="${STRUCT_ID}/job_run.lock" "${STRUCT_ID}/" \
       && [[ -s "${STRUCT_ID}.tar.gz" ]]; then
      rm -rf "${STRUCT_ID}/"
    else
      echo "Archive failed or empty for ${STRUCT_ID}; keeping directory."
      rm -f "${STRUCT_ID}.tar.gz"
      rmdir "${STRUCT_ID}/.archive.lock" 2>/dev/null
    fi
  fi
else
  echo $STRUCT_ID "BROKEN" >> ../results_0.gs
fi

# Propagate a partial cycle to the exit status. Without this a cycle whose second
# half died still exited 0, the runner logged it "done", and the only symptom was
# Ncycles quietly lagging the done count.
exit ${CYCLE_FAILED:-0}

; npt_fe.mdp - 1 ns NPT equilibration of the unrestrained bound state before
; each FE cycle (extended from the 100 ps npt.mdp of the classic protocol).
; Parrinello-Rahman, so the configurations handed to boundfwd are drawn from the
; true NPT ensemble the Crooks analysis assumes. Preceded by npt_relax_fe.
;
; nsteps 250000 * dt 0.004 = 1000 ps.

integrator               = md
nsteps                   = 250000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 100000
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 2000

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = Verlet
ns_type                  = grid
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
rvdw-switch              = 1.0

vdwtype                  = cutoff
vdw-modifier             = force-switch

coulombtype              = PME

DispCorr                 = no

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

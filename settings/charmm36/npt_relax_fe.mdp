; npt_relax_fe.mdp - 100 ps weak-coupling NPT run before every long NPT
; equilibration, in setup and in each cycle. Berendsen ONLY here: it relaxes
; the box to roughly the right density without the oscillation
; Parrinello-Rahman shows when started far from equilibrium. It generates no
; well-defined ensemble, so nothing downstream may consume its output as a
; sample; it exists to hand the next leg a box that is already close.
;
; nsteps 25000 * dt 0.004 = 100 ps.

integrator               = md
nsteps                   = 25000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 12500
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 2000

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = Verlet
ns_type                  = grid
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
rvdw-switch              = 1.0

vdwtype                  = cutoff
vdw-modifier             = force-switch

coulombtype              = PME

DispCorr                 = no

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = Berendsen
pcoupltype               = isotropic
tau_p                    = 0.5
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

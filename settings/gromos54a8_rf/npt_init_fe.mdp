; npt_init_fe.mdp - 20 ns NPT equilibration of one probe replica, in the small
; probe box; the setup runs N_PROBES = 5 of them, once per structure rather than
; once per cycle. make_boresch.py discards the first 10 ns of each
; (PROBE_SKIP_FRAC), which also absorbs the C-rescale box relaxation off the NVT
; ladder, and takes the backbone RMSF behind the Boresch anchor choice and the
; restraint references from the rest, sampled every 10 ps. measure_box.py sizes
; the production box from every frame.
;
; nsteps 5000000 * dt 0.004 = 20000 ps.

; GROMOS 54A8 under the REACTION FIELD it was parametrised with, which is what
; makes this tree different from settings/gromos54a8 (that one is PME and is
; left exactly as it was). Under PME this force field scored 2KTF at -64.2
; kJ/mol against -26.1 published for it (Perthold & Oostenbrink, JCTC 2017, 13,
; 5697) and -25.1/-28 from experiment.
;
; The paper, verbatim: "Calculation of nonbonded electrostatic and Lennard-Jones
; interactions was done within a cutoff sphere of 1.4 nm. For the calculation of
; electrostatic interactions, a reaction-field contribution with a relative
; dielectric permittivity of 61 beyond the cutoff sphere was added."

integrator               = md
nsteps                   = 5000000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 2500
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 2000

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = verlet
ns_type                  = grid
rlist                    = 1.4
rcoulomb                 = 1.4
rvdw                     = 1.4

vdwtype                  = cut-off
vdw-modifier             = none

coulombtype              = Reaction-Field
epsilon_rf               = 61
epsilon_r                = 1
coulomb-modifier         = none

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

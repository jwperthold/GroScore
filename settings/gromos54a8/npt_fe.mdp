; npt_fe.mdp - 20 ns NPT of the bound state with no pull code: the physics of the
; per-cycle npt_c, which since v1.5 runs npt_c_fe.mdp, i.e. this file plus the
; elastic network if the structure has one. Kept as the pull-free reference that
; file is checked against.
; The Crooks analysis assumes the states boundfwd1 starts from are drawn from the
; true NPT ensemble, so it uses C-rescale and runs straight off the NVT ladder
; (C-rescale is first order and needs no weak-coupling stage in front of it).
;
; nsteps 5000000 * dt 0.004 = 20000 ps.

integrator               = md
nsteps                   = 5000000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 100000
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 2000

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = verlet
ns_type                  = grid
rlist                    = 1.4
rcoulomb                 = 1.4
rvdw                     = 1.4

vdwtype                  = cut-off
vdw-modifier             = none

coulombtype              = PME
coulomb-modifier         = none

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

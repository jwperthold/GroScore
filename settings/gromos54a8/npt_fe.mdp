; npt_fe.mdp - 20 ns NPT equilibration of the unrestrained bound state before
; each FE cycle. Its output is the configuration boundfwd starts from, and the
; Crooks analysis assumes those are drawn from the true NPT ensemble, so it uses
; C-rescale and runs straight off the NVT ladder (C-rescale is first order and
; needs no weak-coupling stage in front of it).
;
; nsteps 5000000 * dt 0.004 = 20000 ps.

; GROMOS 54A8 is parametrised with a REACTION FIELD, not a lattice sum. PME here
; gave dG_bind = -64.2 kJ/mol on 2KTF against -26.1 published for this force
; field (Perthold & Oostenbrink, JCTC 2017, 13, 5697) and -25.1/-28 experiment.
; epsilon_rf = 61 and the 1.4 nm cutoff are that paper's, verbatim. Do not put
; PME back without re-deriving what the force field was fitted to.

integrator               = md
nsteps                   = 5000000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 100000
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 2000

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = verlet
ns_type                  = grid
rlist                    = 1.4
rcoulomb                 = 1.4
rvdw                     = 1.4

vdwtype                  = cut-off
vdw-modifier             = none

coulombtype              = Reaction-Field
epsilon_rf               = 61
epsilon_r                = 1
coulomb-modifier         = none

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

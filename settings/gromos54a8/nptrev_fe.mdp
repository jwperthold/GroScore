; nptrev_fe.mdp - Hold the unbound, Boresch-restrained state (lambda = 1)
; between the unbinding and rebinding legs. No switching (delta-lambda = 0).
; 3 ns, down from 5: the Boresch channel equilibrates inside 1 ns (drift across
; the old 5 ns was 0.031 +- 1.87 kJ/mol, p = 0.91) and the interface kept
; drifting away from the rebinding reference for as long as the hold ran.
;
; nsteps 750000 * dt 0.004 = 3000 ps.

integrator               = md
nsteps                   = 750000
dt                       = 0.004
mass-repartition-factor  = 3

nstxout                  = 0
nstxout-compressed       = 100000
compressed-x-precision   = 1000
nstvout                  = 0
nstfout                  = 0
nstenergy                = 2000
nstlog                   = 2000
nstcalcenergy            = 100

comm-mode                = linear
nstcomm                  = 1000

continuation             = yes
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 6

cutoff-scheme            = verlet
ns_type                  = grid
rlist                    = 1.4
rcoulomb                 = 1.4
rvdw                     = 1.4

vdwtype                  = cut-off
vdw-modifier             = none

coulombtype              = PME
coulomb-modifier         = none

tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1  0.1
ref_t                    = 310  310

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com

pbc                      = xyz

gen_vel                  = no

; ---- Free-energy: force-constant switching k -> kB, driven by lambda ----
free-energy              = yes
init-lambda              = 1
delta-lambda             = 0
dhdl-derivatives         = yes
nstdhdl                  = 500
separate-dhdl-file       = yes
calc-lambda-neighbors    = 0
sc-alpha                 = 0

; ---- COM pulling (pull block appended by make_boresch.py) ----
pull                     = yes
pull-print-com1          = no
pull-print-com2          = no
pull-print-ref-value     = no
pull-print-components    = no
pull-nstxout             = 0
pull-nstfout             = 0
